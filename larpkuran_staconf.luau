        isVanished = true
        return
    end
    local startPos = altHRP.Position
    local fwdDir = masterHRP and masterHRP.CFrame.LookVector or altHRP.CFrame.LookVector
    if fwdDir.Magnitude < 0.01 then fwdDir = Vector3.new(0, 0, -1) end
    fwdDir = Vector3.new(fwdDir.X, 0, fwdDir.Z).Unit
    local refY = masterHRP and masterHRP.Position.Y or startPos.Y
