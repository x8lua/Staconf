    local function cacheDrawing(raw)
        local cached, known = {}, {}
        local writable = {
            Visible=true, Color=true, Transparency=true, Thickness=true,
            Filled=true, Position=true, Size=true, From=true, To=true,
            PointA=true, PointB=true, PointC=true, PointD=true,
            Text=true, Center=true, Outline=true, OutlineColor=true,
            Font=true, ZIndex=true, Radius=true, NumSides=true,
        }
        local removed = false
        local proxy = {}
        local function remove()
            if removed then return end
            raw:Remove()
            removed = true
            table.clear(cached)
            table.clear(known)
        end
        return setmetatable(proxy, {
            __index = function(_, key)
                if key == "Remove" or key == "Destroy" then return remove end
                if removed then error("Drawing has been removed", 2) end
                if writable[key] and known[key] then return cached[key] end
                local value = raw[key]
                if writable[key] then cached[key], known[key] = value, true end
                return value
            end,
            __newindex = function(_, key, value)
                if removed then error("Drawing has been removed", 2) end
                if writable[key] and known[key] and cached[key] == value then return end
                raw[key] = value
                if writable[key] then cached[key], known[key] = value, true end
            end,
        })
    end
