local function getStandParts(character)
    if standParts.Character ~= character then
        clearStandParts()
        standParts.Character = character
        if character then
            local function add(part)
                if part:IsA("BasePart") then standParts.Parts[part] = true end
            end
            standParts.Added = character.DescendantAdded:Connect(add)
            standParts.Removing = character.DescendantRemoving:Connect(function(part)
                standParts.Parts[part] = nil
            end)
            for _, part in ipairs(character:GetDescendants()) do add(part) end
        end
    end
    return standParts.Parts
end
