    trackConnection("ChalkStudio_InputBegan", UserInputService.InputBegan:Connect(function(input)
        if _G.LarpkuranRageGeneration ~= larpkuranRageGeneration then return end
        if not c.boardSg.Enabled then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local mouseLoc = UserInputService:GetMouseLocation()
            local uv = c.getMouseBoardUv(mouseLoc)
            if not uv then return end
            local boxX = c.selectionBox.Position.X.Scale
            local boxY = c.selectionBox.Position.Y.Scale
            local boxW = c.selectionBox.Size.X.Scale
            local boxH = c.selectionBox.Size.Y.Scale
            local handleBRX = boxX + boxW
            local handleBRY = boxY + boxH
            local distBR = math.sqrt((uv.X - handleBRX)^2 + (uv.Y - handleBRY)^2)
            if distBR < 0.12 or (uv.X >= boxX + boxW - 0.10 and uv.X <= boxX + boxW + 0.05 and uv.Y >= boxY + boxH - 0.10 and uv.Y <= boxY + boxH + 0.05) then
                c.startDrag("BR")
            elseif uv.X >= boxX + boxW - 0.08 and uv.X <= boxX + boxW + 0.05 and uv.Y >= boxY and uv.Y <= boxY + boxH then
                c.startDrag("R")
            elseif uv.Y >= boxY + boxH - 0.08 and uv.Y <= boxY + boxH + 0.05 and uv.X >= boxX and uv.X <= boxX + boxW then
                c.startDrag("B")
            elseif uv.X >= boxX and uv.X <= boxX + boxW * 0.60 and uv.Y >= boxY and uv.Y <= boxY + 0.08 then
                c.startDrag("MOVE")
            end
        end
    end))
