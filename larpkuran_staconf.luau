    end
    controller.BindBabyDuoHold(character, humanoid)
    local bCfg = controller.BabyConfig
    local idleId = controller.ResolveBabyId(bCfg.SHORT_PACK.Idle)
    local walkId = controller.ResolveBabyId(bCfg.SHORT_PACK.Walk)
    controller.FeatureDebugPush("Baby IDs idle=" .. tostring(idleId) .. " walk=" .. tostring(walkId))
    for _, t in ipairs(humanoid:GetPlayingAnimationTracks()) do
        if t.Name:find("ShortRun") or (t.Animation and t.Animation.AnimationId:find("125888117599208")) then
            pcall(function() t:Stop(0.1) end)
        end
    end
    local function getActiveTrack(id)
        for _, t in ipairs(humanoid:GetPlayingAnimationTracks()) do
            if t.Name:sub(1, 11) == "AlwaysShort" and t.Animation and t.Animation.AnimationId == id then
                if t.Priority ~= Enum.AnimationPriority.Action4 then
                    t.Priority = Enum.AnimationPriority.Action4
                end
                return t
            end
        end
        return nil
    end
    local function playTrack(name, id, startWeight)
        local w = startWeight or bCfg.IDLE_WEIGHT
        local track = AH.LoadAnim(
            character,
            name,
            id,
            nil,
            true
        )
        if track then
            track.Name = name
            track.Priority = Enum.AnimationPriority.Action4
            track:Play(0.1, w, 1)
            task.delay(0.2, function()
                if track and track.IsPlaying then
                    track:AdjustWeight(w, 0.1)
                end
            end)
        end
        return track
    end
    local function syncRunAnimSpeed(speed)
        if controller.IsBabyEmoteActive(character) then return end
        for _, t in ipairs(humanoid:GetPlayingAnimationTracks()) do
            if not t.Name:find("Short") and not t.Name:find("Tall") then
                local lowerName = t.Name:lower()
                local isRun = lowerName:find("run") or lowerName:find("sprint") or t.Priority == Enum.AnimationPriority.Movement
                if isRun and t.IsPlaying and t ~= controller.BabyDuoTrack then
                    if math.abs(t.Speed - speed) > 0.05 then
                        t:AdjustSpeed(speed)
                    end
                end
            end
        end
    end
    local function isPlayerRunning()
        local ms = controller.GetMovementService and controller.GetMovementService()
        if ms then
            if ms._running == true then return true end
            if ms._sprintInputDesired == true and humanoid.MoveDirection.Magnitude > 0.05 then return true end
        end
        if character:GetAttribute("Sprinting") == true then return true end
        for _, t in ipairs(humanoid:GetPlayingAnimationTracks()) do
            if not t.Name:find("Short") and not t.Name:find("Tall") and t.IsPlaying then
                local lowerName = t.Name:lower()
                if (lowerName:find("run") or lowerName:find("sprint")) and (t.Priority == Enum.AnimationPriority.Movement or t.Priority == Enum.AnimationPriority.Action) then
                    return true
