controller.DistanceToBufferPart = function(position, part)
    if not position or not part then return math.huge end
    local localPosition = part.CFrame:PointToObjectSpace(position)
    local halfSize = part.Size * 0.5
    local closest = Vector3.new(
        math.clamp(localPosition.X, -halfSize.X, halfSize.X),
        math.clamp(localPosition.Y, -halfSize.Y, halfSize.Y),
        math.clamp(localPosition.Z, -halfSize.Z, halfSize.Z)
    )
    return (localPosition - closest).Magnitude
end
controller.UpdateBufferZone = function()
    if os.clock() < (controller.BufferZoneDisabledUntil or 0) then
        if controller.BufferState.Part then
            pcall(function() controller.BufferState.Part.CanCollide = false end)
        end
        if controller.BufferState.Active then
            controller.BufferState.Active = false
            if controller.BufferState.Tween then controller.BufferState.Tween:Cancel() end
            controller.SetBufferAudio(false)
            controller.HideBufferGui()
        end
        return
    end
    controller.EnsureBufferPart()
    if controller.BufferState.Part then
        controller.BufferState.Part.CanCollide = true
    end
    local root = rootOf(LocalPlayer.Character)
    local y = root and root.Position.Y
    if root and y and y >= -320 and y <= 2000 and root.AssemblyLinearVelocity.Magnitude < 120 then
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.FloorMaterial ~= Enum.Material.Air then
            controller.LastSafeGroundCFrame = root.CFrame
        end
    end
    local proximity = controller.DistanceToBufferPart(root and root.Position, controller.BufferState.Part)
    if root and y and y < controller.BufferConfig.PART_Y then
        local sp = workspace:FindFirstChildOfClass("SpawnLocation")
        local fallbackSafe = (sp and (sp.CFrame + Vector3.new(0, 3.5, 0))) or CFrame.new(37, -265, 156)
        local safeCFrame = controller.LastSafeGroundCFrame or fallbackSafe
        local character = LocalPlayer.Character
        if character then
            character:PivotTo(safeCFrame)
        else
            root.CFrame = safeCFrame
        end
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        controller.BufferZoneDisabledUntil = os.clock() + 1
        y = safeCFrame.Position.Y
    end
    if not controller.BufferState.Active and proximity <= controller.BufferConfig.PROXIMITY_ENTER then
        controller.BufferState.Active = true
        if controller.BufferState.Tween then controller.BufferState.Tween:Cancel() end
        controller.BufferState.Tween = TweenService:Create(controller.BufferState.Part, TweenInfo.new(0.55, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {Color = Color3.fromRGB(255, 110, 110), Transparency = 0.35})
        controller.BufferState.Tween:Play(); controller.SetBufferAudio(true); controller.ShowBufferGui()
    elseif controller.BufferState.Active and proximity > controller.BufferConfig.PROXIMITY_EXIT then
        controller.BufferState.Active = false
        if controller.BufferState.Tween then controller.BufferState.Tween:Cancel() end
        controller.BufferState.Tween = TweenService:Create(controller.BufferState.Part, TweenInfo.new(0.5), {Color = Color3.fromRGB(255, 25, 25), Transparency = 0.65})
        controller.BufferState.Tween:Play(); controller.SetBufferAudio(false); controller.HideBufferGui()
    end
end
trackConnection("BufferZone_Heartbeat", RunService.Heartbeat:Connect(controller.UpdateBufferZone))
controller.setupKeybindManager = function()
