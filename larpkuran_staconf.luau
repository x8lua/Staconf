        if bindKeyStr == "MouseButton2" then return inputObj.UserInputType == Enum.UserInputType.MouseButton2 end
        if bindKeyStr == "MouseButton3" then return inputObj.UserInputType == Enum.UserInputType.MouseButton3 end
        if inputObj.UserInputType == Enum.UserInputType.Keyboard and inputObj.KeyCode ~= Enum.KeyCode.Unknown then
