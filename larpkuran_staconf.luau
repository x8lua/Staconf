    local function isCurrentlyOnShift()
        local svc = getServiceMod()
        if svc and svc._onShift ~= nil then
            return svc._onShift == true
        end
        local pGui = LocalPlayer:FindFirstChild("PlayerGui")
        local photoGui = pGui and pGui:FindFirstChild("PhotoJobGui")
        if photoGui then
            local card = photoGui:FindFirstChild("Card")
            local tLbl = card and card:FindFirstChild("Task")
            if tLbl and tLbl.Text ~= "" and not tLbl.Text:lower():find("waiting") and not tLbl.Text:lower():find("none") then
                return true
            end
        end
        if currentJobTask ~= nil then
            return true
        end
        return false
