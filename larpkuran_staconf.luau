                if carryKey then ku.CONSTANTS.KEYBINDS.CARRY = carryKey end
                if gripKey then ku.CONSTANTS.KEYBINDS.GRIP = gripKey end
            end
            if ku.KEYBINDS then
                if carryKey then ku.KEYBINDS.CARRY = carryKey end
                if gripKey then ku.KEYBINDS.GRIP = gripKey end
            end
        end
        if not cachedDesktopInputsTable then
            scanGcObjects(false)
        end
        local ms = cachedDesktopInputsTable or mobileClient or (KnockedHelper and KnockedHelper.getMobileService and KnockedHelper.getMobileService())
        if ms and rawget(ms, "_bindDesktopInputs") then
            local uvs = debug.getupvalues(ms._bindDesktopInputs)
            if uvs and uvs[1] and uvs[1].CONSTANTS and uvs[1].CONSTANTS.KEYBINDS then
                if carryKey then
                    uvs[1].CONSTANTS.KEYBINDS.CARRY = carryKey
                    if uvs[1].KEYBINDS then uvs[1].KEYBINDS.CARRY = carryKey end
                end
                if gripKey then
                    uvs[1].CONSTANTS.KEYBINDS.GRIP = gripKey
                    if uvs[1].KEYBINDS then uvs[1].KEYBINDS.GRIP = gripKey end
                end
            end
        end
