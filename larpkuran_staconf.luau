    local targetChar = viewing.Character
    local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
    if not targetChar or not targetHum or targetHum.Health <= 0 or isCharDowned(targetChar) then
        rageRuntime.StopSpectate()
        return
    end
    if rageRuntime.SpectateTarget == viewing then
        local camera = workspace.CurrentCamera
        local subject = targetHum or targetChar
        if camera and subject and camera.CameraSubject ~= subject then
            camera.CameraType = Enum.CameraType.Custom
            camera.CameraSubject = subject
        end
        return
    end
    rageRuntime.StopSpectate()
    rageRuntime.SpectateTarget = viewing
    local camera = workspace.CurrentCamera
    if camera and (targetHum or targetChar) then
        camera.CameraType = Enum.CameraType.Custom
        camera.CameraSubject = targetHum or targetChar
    end
    rageRuntime.Notify('Spectate', 'Viewing ' .. viewing.Name)
    rageRuntime.SpectateHumDied = targetHum.Died:Connect(function()
        rageRuntime.StopSpectate()
    end)
    rageRuntime.SpectateRemoving = viewing.CharacterRemoving:Connect(function()
        rageRuntime.StopSpectate()
    end)
    rageRuntime.SpectateViewDied = viewing.CharacterAdded:Connect(function()
        rageRuntime.StopSpectate()
    end)
    local isSpectating = false
    local lastSpectateChange = 0
    rageRuntime.SpectateViewChanged = workspace.CurrentCamera:GetPropertyChangedSignal("CameraSubject"):Connect(function()
        if isSpectating then return end
        local now = os.clock()
        if now - lastSpectateChange < 0.15 then return end
        if rageRuntime.SpectateTarget == viewing and workspace.CurrentCamera then
            local tChar = viewing.Character
            local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
            if not tChar or not tHum or tHum.Health <= 0 or isCharDowned(tChar) then
                rageRuntime.StopSpectate()
                return
            end
            local subject = tHum or tChar
            if subject and workspace.CurrentCamera.CameraSubject ~= subject then
                isSpectating = true
                lastSpectateChange = now
                task.defer(function()
                    if rageRuntime.SpectateTarget == viewing and workspace.CurrentCamera then
                        workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
                        workspace.CurrentCamera.CameraSubject = subject
                    end
                    isSpectating = false
                end)
            end
        end
    end)
end
