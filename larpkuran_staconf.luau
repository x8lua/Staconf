controller.SetupGreenZoneBypass = function()
    local gateGroups = {
        GreenzoneGate = true,
        JobCounterGate = true,
        BasketballCourtGate = true,
        BasketballCourtWall = true,
        BasketballInboundCross = true,
        VolleyballCourtGate = true,
        VolleyballCourtWall = true,
    }
    local function isBarrierPart(part)
        if gateGroups[part.CollisionGroup] then return true end
        if part.Name == "BoundLine" or part.Name == "ThreePointBounds" or part.Name == "Paint1" or part.Name == "Paint2" or part.Name == "Halfcourt" or part.Name == "Court" then return true end
        local parent = part.Parent
        if parent and (parent.Name == "Bounds" or parent.Name == "Inbounds" or parent.Name == "Intro" or parent.Name == "Pads" or parent.Name == "Walls" or parent.Name == "Barriers") then
            local gp = parent.Parent
            if gp and (gp.Name:find("BBCourt") or gp.Name:find("Court") or gp.Name:find("Gymnasium") or gp.Name:find("Basketball") or gp.Name:find("Volleyball")) then
                return true
            end
        end
        return false
    end
    local gateConnections = {}
    local function removeGate(part)
        local existing = gateConnections[part]
        if not existing then return end
        gateConnections[part] = nil
        for _, connection in ipairs(existing) do connection:Disconnect() end
    end
    local function disableGatePart(part)
        if controller.Stopped or not part:IsA("BasePart") or gateConnections[part] then return end
        if isBarrierPart(part) then
            part.CanCollide = false
            part.CanTouch = false
            part.CanQuery = false
            local handlers = {}
            gateConnections[part] = handlers
            table.insert(handlers, part:GetPropertyChangedSignal("CanCollide"):Connect(function()
                if not controller.Stopped and controller.BypassGreenZone and part.CanCollide then
                    part.CanCollide = false
                end
            end))
            table.insert(handlers, part:GetPropertyChangedSignal("CanTouch"):Connect(function()
                if not controller.Stopped and controller.BypassGreenZone and part.CanTouch then
                    part.CanTouch = false
                end
            end))
        end
    end
    trackConnection("GreenzoneGate_Cleanup", {Disconnect = function()
        for part in pairs(gateConnections) do removeGate(part) end
    end})
    trackConnection("GreenzoneGate_DescendantAdded", workspace.DescendantAdded:Connect(disableGatePart))
    trackConnection("GreenzoneGate_DescendantRemoving", workspace.DescendantRemoving:Connect(removeGate))
    task.spawn(function()
        for index, desc in ipairs(workspace:GetDescendants()) do
            if controller.Stopped then return end
            disableGatePart(desc)
            if index % 400 == 0 then task.wait() end
        end
    end)
    local courtExitPositions = {
        Vector3.new(13.9, -262.8, 17.2),
        Vector3.new(35.5, -262.8, 550.7),
        Vector3.new(-24.1, -262.8, 440.9),
        Vector3.new(-24.1, -262.8, 550.9),
    }
    local courtCenters = {
        Vector3.new(-44.3, -250.0, 48.1),
        Vector3.new(33.3, -237.6, 495.9),
        Vector3.new(-20.0, -237.6, 495.9),
    }
    local lastCourtCFrame = nil
    local lastCourtTime = 0
    local lastBypassStep = 0
    trackConnection("GreenzoneBypass_Stepped", RunService.Stepped:Connect(function()
        if _G.LarpkuranRageGeneration ~= larpkuranRageGeneration then return end
        if not controller.BypassGreenZone then return end
        local now = os.clock()
        if (now - lastBypassStep) < 0.1 then return end
        lastBypassStep = now
        local char = LocalPlayer.Character
        if not char then return end
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                if part.CollisionGroup == "PlayerInCombat" or part.CollisionGroup == "JobStaffInCombat" then
                    part.CollisionGroup = "PlayerBody"
                end
            end
        end
        if char:GetAttribute("PlayingBasketballMatch") then
            char:SetAttribute("PlayingBasketballMatch", nil)
        end
        local root = rootOf(char)
        if not root then return end
        local currentPos = root.Position
        local onCourt = false
        for _, center in ipairs(courtCenters) do
            local horizontalDist = (Vector3.new(currentPos.X, center.Y, currentPos.Z) - center).Magnitude
            if horizontalDist < 65 and math.abs(currentPos.Y - center.Y) < 30 then
                onCourt = true
                break
            end
        end
        if onCourt then
            local nearExit = false
            for _, exitPos in ipairs(courtExitPositions) do
                if (currentPos - exitPos).Magnitude < 10 then
                    nearExit = true
                    break
                end
            end
            if not nearExit then
                lastCourtCFrame = root.CFrame
                lastCourtTime = os.clock()
            end
        end
        if lastCourtCFrame and (os.clock() - lastCourtTime < 4) then
            for _, exitPos in ipairs(courtExitPositions) do
                if (currentPos - exitPos).Magnitude < 10 then
                    root.CFrame = lastCourtCFrame
                    break
                end
            end
        end
    end))
end
