local function hookMovementUtilsSetSpeed()
    if movementUtilsHooked or originalSetSpeed then return end
    local mu = getMovementUtils()
    if mu and type(mu.SetSpeed) == 'function' then
        movementUtilsRef = mu
        originalSetSpeed = mu.SetSpeed
        mu.SetSpeed = function(target, speed, ...)
            if controller.DropkickActive and controller.DropkickTargetSpeed then
                local character = larpStartup.GetLocalCharacter()
                local hum = character and character:FindFirstChildOfClass("Humanoid")
                if target == hum or (character and target == character) then
                    return originalSetSpeed(target, controller.DropkickTargetSpeed, ...)
                end
            end
            if speedOfHit.enabledState:get() == true then
                local character = larpStartup.GetLocalCharacter()
                local hum = character and character:FindFirstChildOfClass('Humanoid')
                if target == hum or (character and target == character) then
                    local isHitStunned = character:GetAttribute('Stunned') == true or character:GetAttribute('CantAnything') == true or character:GetAttribute('CombatRecovery') == true
                    if isHitStunned or (tonumber(speed) and tonumber(speed) <= 10) then
                        local targetSpeed = math.clamp(tonumber(speedOfHit.speedState:get()) or 28, 4, 60)
                        return originalSetSpeed(target, targetSpeed, ...)
                    end
                end
            end
            return originalSetSpeed(target, speed, ...)
        end
    end
    movementUtilsHooked = true
end
local function startHitSpeedLoop()
    if hitSpeedConn then return end
    hitSpeedConn = RunService.RenderStepped:Connect(function()
        if speedOfHit.enabledState:get() == true then
            local character = LocalPlayer.Character
            if character then
                local isHitStunned = character:GetAttribute('Stunned') == true or character:GetAttribute('CantAnything') == true or character:GetAttribute('CombatRecovery') == true
                if isHitStunned then
                    local targetSpeed = math.clamp(tonumber(speedOfHit.speedState:get()) or 28, 4, 60)
                    local hum = character:FindFirstChildOfClass('Humanoid')
                    if hum and hum.WalkSpeed ~= targetSpeed then
                        hum.WalkSpeed = targetSpeed
                    end
                    local cm = character:FindFirstChildOfClass('ControllerManager')
                    if cm and cm.GroundSpeed ~= targetSpeed then
                        cm.GroundSpeed = targetSpeed
                    end
                end
            end
        end
    end)
end
local function syncSpeedOfHit()
    if not movementUtilsHooked then hookMovementUtilsSetSpeed() end
    if not stateHandlerHooked then hookStateHandler() end
    startHitSpeedLoop()
    local ok, CombatConfig = pcall(function() return require(ReplicatedStorage.Shared.Config.CombatConfig) end)
    if ok and CombatConfig and CombatConfig.Shared then
        local pss = CombatConfig.Shared.ParryStunSpeed
        if pss then
            if speedOfHit.enabledState:get() == true then
                local targetSpeed = math.clamp(tonumber(speedOfHit.speedState:get()) or 28, 4, 60)
                pss.M1 = targetSpeed
                pss.M2 = targetSpeed
            else
                pss.M1 = 4
                pss.M2 = 4
            end
        end
        if speedOfHit.enabledState:get() == true then
            local targetSpeed = math.clamp(tonumber(speedOfHit.speedState:get()) or 28, 4, 60)
            CombatConfig.Shared.HitStunSpeed = targetSpeed
        else
            CombatConfig.Shared.HitStunSpeed = nil
        end
    end
end
controller.SyncSpeedOfHit = syncSpeedOfHit
