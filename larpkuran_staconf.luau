    local volleyballClient = nil
    local lastGcScan = 0
    local cachedDesktopInputsTable = nil
    local movementClient = nil
    local phoneToggleFunction = nil
    local emoteWheelClient = nil
    local function scanGcObjects(force)
        local now = os.clock()
        if not force and (now - lastGcScan) < 10 then
            return
        end
        lastGcScan = now
        local char = LocalPlayer.Character
        local charName = char and char.Name
        local liveOnInput = nil
        local anyOnInput = nil
        if getloadedmodules then
            pcall(function()
                for _, m in ipairs(getloadedmodules()) do
