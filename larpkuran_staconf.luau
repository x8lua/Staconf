local function isCharDowned(char)
    if not char then return true end
    local ok, res = pcall(function()
        if not char.Parent or not char:IsDescendantOf(workspace) then return true end
        if char:GetAttribute("Downed") == true or char:GetAttribute("Ragdoll") == true or char:GetAttribute("Ragdolled") == true or char:GetAttribute("KO") == true or char:GetAttribute("Knocked") == true or char:GetAttribute("KnockedOut") == true or char:GetAttribute("Carried") == true or char:GetAttribute("Execution") == true or char:GetAttribute("Executing") == true or char:GetAttribute("Dead") == true then
            return true
        end
        local downedFolder = workspace:FindFirstChild("Downed")
        if downedFolder and downedFolder:FindFirstChild(char.Name) then
            return true
        end
        local head = char:FindFirstChild("Head")
        if head and head:FindFirstChild("Downed") then
            return true
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead then
            return true
        end
        if typeof(KnockedHelper) == "table" and typeof(KnockedHelper.isPlayerDowned) == "function" then
            local kOk, kRes = pcall(KnockedHelper.isPlayerDowned, char)
            if kOk and kRes == true then return true end
        end
        if typeof(isPlayerDowned) == "function" then
            local pOk, pRes = pcall(isPlayerDowned, char)
            if pOk and pRes == true then return true end
        end
        return false
    end)
    if not ok then return false end
    return res == true
end
