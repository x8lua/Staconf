                for _, line in ipairs(entry.Skeleton) do if line and line.Visible then line.Visible = false end end
            end
        else
            if entry.Box and entry.Box.Visible then entry.Box.Visible = false end
            if entry.BoxOutline and entry.BoxOutline.Visible then entry.BoxOutline.Visible = false end
            if entry.BoxFill and entry.BoxFill.Visible then entry.BoxFill.Visible = false end
            if entry.Box3D then for _, l in ipairs(entry.Box3D) do if l and l.Visible then l.Visible = false end end end
            if entry.HealthBar and entry.HealthBar.Visible then entry.HealthBar.Visible = false end
            if entry.HealthBarOutline and entry.HealthBarOutline.Visible then entry.HealthBarOutline.Visible = false end
            if entry.HealthText and entry.HealthText.Visible then entry.HealthText.Visible = false end
            if entry.NameText and entry.NameText.Visible then entry.NameText.Visible = false end
            if entry.StyleText and entry.StyleText.Visible then entry.StyleText.Visible = false end
            if entry.DistanceText and entry.DistanceText.Visible then entry.DistanceText.Visible = false end
            if entry.Tracer and entry.Tracer.Visible then entry.Tracer.Visible = false end
            if entry.TracerOutline and entry.TracerOutline.Visible then entry.TracerOutline.Visible = false end
            if entry.Skeleton then for _, l in ipairs(entry.Skeleton) do if l and l.Visible then l.Visible = false end end end
            if optOffScreen and entry.Arrow and entry.ArrowOutline then
                local dir
                if screenPos.Z < 0 then
                    dir = Vector2.new(-screenPos.X + screenCenter.X, -screenPos.Y + screenCenter.Y).Unit
                else
                    dir = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Unit
                end
                local radius = math.min(screenCenter.X, screenCenter.Y) - 50
                local arrowPos = screenCenter + dir * radius
                local angle = math.atan2(dir.Y, dir.X)
                local size = 14
                local width = 8
                local p1 = arrowPos + Vector2.new(math.cos(angle) * size, math.sin(angle) * size)
                local p2 = arrowPos + Vector2.new(math.cos(angle + 2.4) * width, math.sin(angle + 2.4) * width)
                local p3 = arrowPos + Vector2.new(math.cos(angle - 2.4) * width, math.sin(angle - 2.4) * width)
                entry.Arrow.PointA = p1
                entry.Arrow.PointB = p2
                entry.Arrow.PointC = p3
                entry.Arrow.Color = color
                if not entry.Arrow.Visible then entry.Arrow.Visible = true end
                entry.ArrowOutline.PointA = p1
                entry.ArrowOutline.PointB = p2
                entry.ArrowOutline.PointC = p3
                if not entry.ArrowOutline.Visible then entry.ArrowOutline.Visible = true end
            else
                if entry.Arrow and entry.Arrow.Visible then entry.Arrow.Visible = false end
                if entry.ArrowOutline and entry.ArrowOutline.Visible then entry.ArrowOutline.Visible = false end
            end
        end
    end
end
