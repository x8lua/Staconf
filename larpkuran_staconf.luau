    if not ads or ads.Enabled:get() ~= true then return end
    local delayMs = tonumber(ads.Delay and ads.Delay:get()) or 140
    if delayMs <= 0 then return end
    controller.DesyncDelayedTracks[track] = true
    local delaySec = delayMs / 1000
    local origSpeed = (track.Speed and track.Speed > 0) and track.Speed or 1
    local origWeight = (track.WeightTarget and track.WeightTarget > 0) and track.WeightTarget or 1
    pcall(function()
        track:AdjustWeight(0.0001, 0)
        track:AdjustSpeed(0)
        track.TimePosition = 0
    end)
    task.delay(delaySec, function()
        if track and track.IsPlaying then
            pcall(function()
