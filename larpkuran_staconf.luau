        ["#160A01"] = "Natural Dark Brown",
        ["#140F0A"] = "Natural Black",
        ["#141414"] = "Natural Black",
        ["#18110E"] = "Natural Dark Brown",
        ["#19140F"] = "Natural Dark Brown",
        ["#1E140F"] = "Natural Dark Brown",
        ["#F0D2A0"] = "Natural Blonde",
        ["#D2B48C"] = "Natural Light Brown",
        ["#5A3C28"] = "Natural Brown",
        ["#322319"] = "Natural Brown",
        ["#503C28"] = "Natural Brown",
        ["#3C2D1E"] = "Natural Brown",
        ["#231914"] = "Natural Dark Brown",
        ["#32281E"] = "Natural Dark Brown",
        ["#46321E"] = "Natural Brown",
        ["#C85A3C"] = "Natural Ginger / Auburn",
        ["#C8643C"] = "Natural Auburn / Brown"
    }
    if naturalHex[hex] then
        return naturalHex[hex] .. " " .. hex
