        if isCurrentlyOnShift() or isStartingShift then return false end
        local submit = getJobRemotes()
        if not submit then return false end
        isStartingShift = true
        task.spawn(function()
            setJobAction("Requesting shift start...")
            pcall(function()
                submit:InvokeServer("Start")
            end)
            task.wait(1.5)
            isStartingShift = false
        end)
        return true
    end
    local function listenJobState()
        if jobStateHooked then return end
        local _, state = getJobRemotes()
        if not state or not state:IsA("RemoteEvent") then return end
        jobStateHooked = true
        trackConnection("PhotoJobState_AutoJob", state.OnClientEvent:Connect(function(arg1, arg2)
            if type(arg1) == "table" then
                if arg1.Kind == "Task" or arg1.TaskKind then
                    currentJobTask = arg1
                elseif arg1.Task or arg1.CurrentTask then
                    currentJobTask = arg1.Task or arg1.CurrentTask
                elseif arg1.Kind == "Ended" or arg1.Kind == "NoTask" then
                    currentJobTask = nil
                end
                if arg1.Streak then currentJobStreak = arg1.Streak end
                if arg1.Earned then currentJobEarned = arg1.Earned end
            elseif type(arg1) == "string" and type(arg2) == "table" then
                currentJobTask = arg2
            end
            pcall(updateStatusGui)
        end))
    end
