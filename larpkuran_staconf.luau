    function c.getTargetBoard(explicitPart)
        local targetPart = explicitPart
        if not targetPart then
            local player = game.Players.LocalPlayer
            local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if not root then return c.cachedBoard end
            local now = os.clock()
            if #c.allBoardParts == 0 and (now - (c.lastBoardScan or 0) > 15) then
                c.lastBoardScan = now
                c.indexBoards()
            end
            local closestPart, closestDist = nil, math.huge
            for _, part in ipairs(c.allBoardParts) do
                if part and part.Parent then
                    local dist = (part.Position - root.Position).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closestPart = part
                    end
                end
            end
            targetPart = closestPart
            c.currentBoardDist = closestDist
            c.isBoardClose = closestDist <= 16.0
        end
        if not targetPart then return c.cachedBoard end
        if c.cachedBoard and c.cachedBoard.part == targetPart and c.cachedBoard.editableImage then
            return c.cachedBoard
        end
        local boardId = targetPart:GetAttribute("WhiteboardId")
        local sg = targetPart:FindFirstChildWhichIsA("SurfaceGui")
        local canvas = sg and (sg:FindFirstChild("Canvas") or sg:FindFirstChildWhichIsA("Frame", true) or sg)
        local imgLabel = canvas and (canvas:FindFirstChildOfClass("ImageLabel") or canvas:FindFirstChildWhichIsA("ImageLabel", true)) or (sg and sg:FindFirstChildWhichIsA("ImageLabel", true))
        local ei = nil
        if imgLabel then
            pcall(function()
                if imgLabel.ImageContent and imgLabel.ImageContent.Object then
                    ei = imgLabel.ImageContent.Object
                elseif imgLabel.ContentImage then
                    ei = imgLabel.ContentImage
                end
            end)
        end
        if not ei and sg then
            pcall(function()
                for _, d in ipairs(sg:GetDescendants()) do
                    if d:IsA("ImageLabel") and d.ImageContent and d.ImageContent.Object then
                        ei = d.ImageContent.Object
                        imgLabel = d
                        break
                    end
                end
            end)
        end
        c.cachedBoard = {
            part = targetPart,
            boardId = boardId,
            surfaceGui = sg,
            imageLabel = imgLabel,
            editableImage = ei
        }
        c.boardSg.Adornee = targetPart
        c.boardSg.Face = sg and sg.Face or Enum.NormalId.Back
        c.boardSg.CanvasSize = sg and sg.CanvasSize or Vector2.new(512, 384)
        return c.cachedBoard
    end
