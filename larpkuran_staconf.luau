local cachedFakeStyleFoldersList = nil
local function fakeStyleFolders(forceRefresh)
    if cachedFakeStyleFoldersList and not forceRefresh then
        return cachedFakeStyleFoldersList
    end
    local combat = ReplicatedStorage:FindFirstChild("Animations")
    combat = combat and combat:FindFirstChild("Combat")
    local result, seen = {}, {}
    if combat then
        for _, folder in ipairs(combat:GetChildren()) do
            if folder:IsA("Folder") or folder:IsA("Model") then
                local name = folder.Name:gsub("Anims$", "")
                if name ~= "" and not seen[name:lower()] then
                    seen[name:lower()] = true
                    table.insert(result, {Name = name, Folder = folder})
                end
            end
        end
    end
    table.sort(result, function(a, b) return a.Name:lower() < b.Name:lower() end)
    cachedFakeStyleFoldersList = result
    return result
end
