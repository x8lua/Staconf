    function c.updateEquippedAndDistances()
        local player = game.Players.LocalPlayer
        local char = player and player.Character
        if not char then
            c.hasChalkCached = false
            c.hasEraserCached = false
            c.cartonDist = 999
            c.eraserCartonDist = 999
            c.canGrabChalk = false
            c.canGrabEraser = false
            return
        end
        local hasC = false
        local hasE = false
        for _, item in ipairs(char:GetChildren()) do
            local n = item.Name:lower()
            if string.find(n, "chalk") then hasC = true end
            if string.find(n, "eraser") then hasE = true end
        end
        c.hasChalkCached = hasC
        c.hasEraserCached = hasE
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then
            c.cartonDist = 999
            c.eraserCartonDist = 999
            c.canGrabChalk = false
            c.canGrabEraser = false
            return
        end
        local cDist, eDist = math.huge, math.huge
        for _, d in ipairs(c.allDispensers) do
            if d.part and d.part.Parent then
                local dist = (d.part.Position - root.Position).Magnitude
                if d.name == "ChalkCarton" and dist < cDist then
                    cDist = dist
                elseif d.name == "EraserCarton" and dist < eDist then
                    eDist = dist
                end
            end
        end
        c.cartonDist = cDist
        c.eraserCartonDist = eDist
        c.canGrabChalk = cDist <= 8.5
        c.canGrabEraser = eDist <= 8.5
        if not c.canGrabChalk then
            c.grabChalkReason = string.format("Too far from Chalk Carton (%.1f / 8.0 studs)", cDist)
        else
            c.grabChalkReason = ""
        end
        if not c.canGrabEraser then
            c.grabEraserReason = string.format("Too far from Eraser Carton (%.1f / 8.0 studs)", eDist)
        else
            c.grabEraserReason = ""
        end
    end
    function c.grabChalkTool()
