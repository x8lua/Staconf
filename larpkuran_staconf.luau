    function api.AddCombo(first, second)
    	if destroyed or not runtimeEnabled then
    		return comboNumber
    	end
    	local amount = type(first) == "table" and second or first
    	local delta = tonumber(amount) or 1
    	if delta ~= delta then
    		delta = 1
    	end
    	local previous = comboNumber
    	local nextValue = clampCombo(previous + delta)
    	if nextValue > previous then
    		comboNumber = nextValue
    		animateCombo(nextValue, true)
    	elseif nextValue < previous then
    		playBlastSound(previous)
    		comboNumber = nextValue
    		if nextValue > 0 then
    			animateCombo(nextValue, false)
    		elseif getVisualStyle(previous).tier >= 3 then
    			playHighTierBreak(previous)
    		else
    			animationId += 1
    			hideImmediately()
    		end
    	elseif delta > 0 and previous > 0 then
    		comboNumber = nextValue
    		animateCombo(nextValue, true)
    	end
    	notifyComboChanged("add")
    	return comboNumber
    end
    function api.Reset()
    	if destroyed then
    		return 0
    	end
    	local previous = comboNumber
    	comboNumber = 0
    	animationId += 1
    	hideImmediately()
