    local pending = dash.root:FindFirstChild("EvasiveDashLinearVelocity")
    if pending and pending ~= dash.previous and pending:IsA("LinearVelocity") then dash.velocity = pending end
    if dash.velocity and dash.velocity.Parent then dash.velocity:Destroy() end
    if dash.velocity and dash.root.Parent then
        local velocity = dash.root.AssemblyLinearVelocity
        dash.root.AssemblyLinearVelocity = Vector3.new(0, velocity.Y, 0)
    end
