    config.AltUsername = controller.AltUsername or ""
    config.TargetHudPosition = _G.LarpkuranRereConfig and _G.LarpkuranRereConfig.TargetHudPosition or config.TargetHudPosition
    if controller.AttackDesyncStates then
        config.AttackDesyncEnabled = controller.AttackDesyncStates.Enabled:get() == true
        config.AttackDesyncKey = controller.AttackDesyncStates.Key:get()
        config.AttackDesyncDelay = tonumber(controller.AttackDesyncStates.Delay and controller.AttackDesyncStates.Delay:get()) or 140
        config.AttackDesyncApplyM1 = controller.AttackDesyncStates.ApplyM1:get() ~= false
        config.AttackDesyncApplyM2 = controller.AttackDesyncStates.ApplyM2:get() ~= false
    end
    _G.LarpkuranRereConfig = config
    local encoded = HttpService:JSONEncode(config)
    local targetPath = CONFIG_FILE
    local isProfileSave = profileName ~= nil
    if isProfileSave then
        profileName = tostring(profileName):match("^%s*(.-)%s*$")
        if not controller.IsValidConfigProfileName(profileName) then
            controller.ConfigProfileStatus = "Invalid config name"
            log("CONFIG profile save rejected: invalid name")
            return false
        end
        local folderOk, folderErr = controller.EnsureConfigProfileDirectory()
        if not folderOk then
            controller.ConfigProfileStatus = "Cannot create config folder: " .. tostring(folderErr)
            log("CONFIG profile save failed: " .. tostring(folderErr))
            return false
        end
        targetPath = controller.ConfigProfilePath(profileName)
        if type(isfile) == "function" and isfile(targetPath) and not overwrite then
            controller.ConfigProfileStatus = "Already exists; use Overwrite config"
            log("CONFIG profile save rejected: file exists")
            return false
        end
    end
    if encoded ~= controller.LastSavedMainConfigJson or isProfileSave then
        controller.LastSavedMainConfigJson = encoded
        if type(writefile) == "function" then
            local ok, errorMessage = pcall(writefile, targetPath, encoded)
            if ok then
                controller.ConfigProfileStatus = isProfileSave and (overwrite and "Config overwritten: " .. profileName or "Config saved: " .. profileName) or "CONFIG saved to file"
            end
            log(ok and (isProfileSave and (overwrite and "CONFIG profile overwritten" or "CONFIG profile saved") or "CONFIG saved to file") or "CONFIG file save failed: " .. tostring(errorMessage))
            if config.AltUsername and config.AltUsername ~= "" then
                pcall(writefile, "larpkuran_pair.json", HttpService:JSONEncode({
                    main = LocalPlayer.Name,
                    alt = config.AltUsername,
                    alts = config.AltUsernames
                }))
            end
        else
            log("CONFIG saved for this executor session")
        end
    end
    if isProfileSave then controller.RefreshConfigProfiles(true) end
    return true
end
controller.LoadConfigProfile = function(profileName)
    if not controller.IsValidConfigProfileName(profileName) or type(readfile) ~= "function" or type(isfile) ~= "function" then
        controller.ConfigProfileStatus = "Invalid profile or file API unavailable"
        return false
    end
    local path = controller.ConfigProfilePath(profileName)
    if not isfile(path) then controller.ConfigProfileStatus = "Config not found: " .. tostring(profileName); return false end
    local ok, saved = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
    if not ok or type(saved) ~= "table" then
        controller.ConfigProfileStatus = "Config decode failed: " .. tostring(profileName)
        return false
    end
    for key, value in pairs(DEFAULT_CONFIG) do config[key] = saved[key] ~= nil and saved[key] or value end
    controller.ApplyConfig()
    controller.ConfigProfileStatus = "Config loaded: " .. tostring(profileName)
    return true
end
controller.SetConfigAutoload = function(profileName)
    if not controller.IsValidConfigProfileName(profileName) then controller.ConfigProfileStatus = "Invalid config name"; return false end
    local path = controller.ConfigProfilePath(profileName)
    if type(isfile) ~= "function" or not isfile(path) then controller.ConfigProfileStatus = "Save the config before autoload"; return false end
    if type(writefile) ~= "function" then controller.ConfigProfileStatus = "writefile unsupported"; return false end
    local ok = pcall(writefile, controller.ConfigAutoloadFile, HttpService:JSONEncode({name = profileName}))
    controller.ConfigProfileStatus = ok and ("Autoload set: " .. profileName) or "Autoload save failed"
    return ok
end
end
