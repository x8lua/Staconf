controller.SyncRagepunchControls = function()
    local shared = _G.RagepunchState
    if not shared then return end
    local widgetValues = rageValueSnapshot()
    local sharedValues = {}
    for key, default in pairs(rageDefaults) do
        local value = shared[key]
        sharedValues[key] = value == nil and default or value
    end
    if next(lastRageValues) == nil then
        setRageWidgetValues(sharedValues)
        widgetValues = rageValueSnapshot()
    else
        local widgetChanged, sharedChanged = false, false
        for key, value in pairs(widgetValues) do
            if value ~= lastRageValues[key] then widgetChanged = true; break end
        end
        for key, value in pairs(sharedValues) do
            if value ~= lastRageValues[key] then sharedChanged = true; break end
        end
        if widgetChanged then
            for key, value in pairs(widgetValues) do shared[key] = value end
        elseif sharedChanged then
            setRageWidgetValues(sharedValues)
            widgetValues = rageValueSnapshot()
            for key, value in pairs(widgetValues) do shared[key] = value end
        end
    end
    local controls = _G.RagepunchControlStates
    if controls then
        for key, value in pairs(widgetValues) do
            local control = controls[key]
            if control and control:get() ~= value then control:set(value) end
        end
    end
    if next(lastRageValues) == nil then
        for key, value in pairs(widgetValues) do
            shared[key] = value
        end
    end
    if shared.Enabled ~= widgetValues.Enabled then
        shared.Enabled = widgetValues.Enabled
    end
    if shared.TargetQuery ~= widgetValues.TargetQuery then
        shared.TargetQuery = widgetValues.TargetQuery
    end
    if rageRuntime and rageRuntime.Sync then rageRuntime.Sync(widgetValues) end
    lastRageValues = widgetValues
end
