local function predictedTargetPosition(character, root)
    local ping = 0.1
    pcall(function() ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000 end)
    local lead = math.clamp(ping, 0.01, 0.5) + 0.08
    lead *= 2.6
    local velocity = root.AssemblyLinearVelocity
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.FloorMaterial == Enum.Material.Air then
        return root.Position + velocity * lead + Vector3.new(0, -workspace.Gravity, 0) * 0.5 * lead ^ 2 + Vector3.new(0, 0.5, -1.5)
    end
    return Vector3.new(root.Position.X + velocity.X * lead, root.Position.Y, root.Position.Z + velocity.Z * lead) + Vector3.new(0, 0.5, -1.5)
end
