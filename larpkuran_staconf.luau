local function disconnectStaleRereCycles()
    if larpStartup.nexomia then return end
    if type(getconnections) ~= "function" or type(debug.getupvalue) ~= "function" then return end
    local runService = game:GetService("RunService")
    pcall(function()
        for _, connection in ipairs(getconnections(runService.Heartbeat)) do
            local callback = connection.Function
            if callback and type(callback) == "function" then
                local isRereCycle = false
                for index = 1, 8 do
                    local ok, value = pcall(debug.getupvalue, callback, index)
                    if not ok or value == nil then break end
                    if type(value) == "table" and type(value._connectedFunctions) == "table" and type(value._cycle) == "function" then
                        isRereCycle = true
                        break
                    end
                end
                if isRereCycle then pcall(function() connection:Disconnect() end) end
            end
        end
    end)
end
