                    end
                elseif not config.StandUnpaired and src and Players:GetPlayerByUserId(src.UserId) and controller.DetectedAlts[Players:GetPlayerByUserId(src.UserId).Name:lower()] and (txt:find("Stand") or txt:find("Boss") or txt:find("Auto-Save") or txt:find("Guardian") or txt:find("Retaliating") or txt:find("safe zone")) then
                    local p = Players:GetPlayerByUserId(src.UserId)
                    if p and p ~= LocalPlayer then
                        controller.DetectedAlts[p.Name:lower()] = true
                        controller.StandExecuting = true
                    end
                end
                if txt:find("%[Stand%] Retaliating against") then
                    local targetName, dealDmg = txt:match("%[Stand%] Retaliating against (.-)! %(Deal: (%d+)%)")
                    if targetName then
                        for _, pl in ipairs(Players:GetPlayers()) do
                            if pl.DisplayName == targetName or pl.Name == targetName then
                                controller.ActiveStandTarget = pl
                                controller.ActiveStandAction = "RETALIATE"
                                controller.ActiveStandTargetMaxDamage = tonumber(dealDmg) or 20
                                local hum = pl.Character and pl.Character:FindFirstChildOfClass("Humanoid")
                                controller.ActiveStandTargetInitialHp = hum and hum.Health or 100
                                break
                            end
                        end
                    end
                elseif txt:find("%[Stand%] Attacking") then
                    local targetName = txt:match("%[Stand%] Attacking (.-)!")
                    if targetName then
                        for _, pl in ipairs(Players:GetPlayers()) do
                            if pl.DisplayName == targetName or pl.Name == targetName then
                                controller.ActiveStandTarget = pl
                                controller.ActiveStandAction = "KILL"
                                local hum = pl.Character and pl.Character:FindFirstChildOfClass("Humanoid")
                                controller.ActiveStandTargetInitialHp = hum and hum.Health or 100
                                break
                            end
                        end
                    end
                elseif txt:find("%[Stand%] Bodyguard block ACTIVE on") then
                    local targetName = txt:match("%[Stand%] Bodyguard block ACTIVE on (.-)!")
                    if targetName then
                        for _, pl in ipairs(Players:GetPlayers()) do
                            if pl.DisplayName == targetName or pl.Name == targetName then
                                controller.ActiveStandTarget = pl
                                controller.ActiveStandAction = "BLOCK"
                                local hum = pl.Character and pl.Character:FindFirstChildOfClass("Humanoid")
                                controller.ActiveStandTargetInitialHp = hum and hum.Health or 100
                                break
                            end
                        end
                    end
                elseif txt:find("Bodyguard block mode: DISABLED") or txt:find("has been killed") or txt:find("Target dealt with") or txt:find("Command cancelled") or txt:find("Block guard ended") then
                    controller.ActiveStandTarget = nil
                    controller.ActiveStandAction = nil
                    controller.ActiveStandTargetMaxDamage = nil
                end
            end))
        end
    end)
end
function fakeStyleHelpers.inCombat(character)
    if not character then return false end
    local equip = character:GetAttribute("Equip")
    if equip == false or equip == 0 or equip == "false" then
        return false
    end
    if equip == true or equip == 1 or equip == "true" then
        return true
    end
    local stanceAttrs = {"CombatState", "FightingStance", "CombatMode", "Stance"}
    for _, attributeName in ipairs(stanceAttrs) do
        local rawVal = character:GetAttribute(attributeName)
        if rawVal == nil then rawVal = LocalPlayer:GetAttribute(attributeName) end
        local pData = character:FindFirstChild("PlayerData")
        if rawVal == nil and pData then rawVal = pData:GetAttribute(attributeName) end
        if rawVal == true or rawVal == 1 or rawVal == "true" then
            return true
        end
    end
    return false
end
function fakeStyleHelpers.clearMap(value)
