    c.dragStartUvOffset = Vector2.zero
    c.boardRayParams = RaycastParams.new()
    c.boardRayParams.FilterType = Enum.RaycastFilterType.Include
    function c.getMouseBoardUv(mouseLocation)
        local board = c.cachedBoard or c.getTargetBoard()
        if not board or not board.part then return nil end
        local part = board.part
        c.boardSg.Adornee = part
        c.boardRayParams.FilterDescendantsInstances = {part}
        local camera = workspace.CurrentCamera
        if not camera then return nil end
        local ray = camera:ViewportPointToRay(mouseLocation.X, mouseLocation.Y)
        local result = workspace:Raycast(ray.Origin, ray.Direction * 300, c.boardRayParams)
        if not result then return nil end
        local localPos = part.CFrame:PointToObjectSpace(result.Position)
        local sz = part.Size
        local uvX = math.clamp((localPos.X / sz.X) + 0.5, 0, 1)
        local uvY = math.clamp(0.5 - (localPos.Y / sz.Y), 0, 1)
        return Vector2.new(uvX, uvY)
    end
    function c.startDrag(action)
        local mouseLoc = UserInputService:GetMouseLocation()
        local uv = c.getMouseBoardUv(mouseLoc)
        local boxX = c.selectionBox.Position.X.Scale
        local boxY = c.selectionBox.Position.Y.Scale
        if action == "BR" then
            c.isResizingBR = true
            c.isResizingR = false
            c.isResizingB = false
            c.isDraggingOnBoard = false
        elseif action == "R" then
            c.isResizingR = true
            c.isResizingBR = false
            c.isResizingB = false
            c.isDraggingOnBoard = false
        elseif action == "B" then
            c.isResizingB = true
            c.isResizingBR = false
            c.isResizingR = false
            c.isDraggingOnBoard = false
        elseif action == "MOVE" then
            c.isDraggingOnBoard = true
            c.isResizingBR = false
            c.isResizingR = false
            c.isResizingB = false
            if uv then
                c.dragStartUvOffset = Vector2.new(uv.X - boxX, uv.Y - boxY)
            else
                c.dragStartUvOffset = Vector2.zero
            end
        end
    end
