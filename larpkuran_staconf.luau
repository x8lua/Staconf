        if movementRole and controller.FakeStyleActiveGroups[movementRole] == replacementTrack then
            controller.FakeStyleActiveGroups[movementRole] = nil
            if controller.FakeStyleActiveMovementRole == movementRole then
                controller.FakeStyleActiveMovementRole = nil
