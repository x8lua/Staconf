end
local function rageApplyAntiAimJitter(localRoot, targetRoot)
    if not rageConfig.AntiAimJitter or rageConfig.JitterDuration <= 0 then return end
    local offset = targetRoot.Position - localRoot.Position
    local horizontal = Vector3.new(offset.X, 0, offset.Z)
    if horizontal.Magnitude < 0.05 then return end
    local direction = horizontal.Unit
    local side = Vector3.new(-direction.Z, 0, direction.X)
    rageConfig.JitterPhase = (rageConfig.JitterPhase or 0) + 1
    local sign = rageConfig.JitterPhase % 2 == 0 and 1 or -1
    local jitterPosition = localRoot.Position + side * sign * rageConfig.JitterRadius
    local yaw = CFrame.fromAxisAngle(Vector3.new(0, 1, 0), math.rad(sign * rageConfig.JitterAngle))
