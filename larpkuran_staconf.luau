local function trackConnection(tag, conn)
    local item = controller.ConnectionsByTag[tag]
    if item then
        item:Disconnect()
        item.conn = conn
    else
        item = {
            tag = tag,
            conn = conn,
            Disconnect = function(self)
                local current = self.conn
                self.conn = nil
                if typeof(current) == "RBXScriptConnection"
                    or (type(current) == "table" and type(current.Disconnect) == "function") then
                    pcall(function() current:Disconnect() end)
                end
            end,
        }
        controller.ConnectionsByTag[tag] = item
        table.insert(controller.Connections, item)
    end
    if controller.Stopped then item:Disconnect() end
    return conn
end
