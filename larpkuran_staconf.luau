local safeGetCustomAsset
do
    local supported = nil
    isCustomAssetSupported = function()
        if supported ~= nil then return supported end
        local assetFn = (type(getcustomasset) == "function" and getcustomasset)
            or (type(getsynasset) == "function" and getsynasset)
        if type(assetFn) ~= "function" then
            supported = false
            return false
        end
        local execName = ""
        if type(identifyexecutor) == "function" then
            local ok, name = pcall(identifyexecutor)
            if ok and type(name) == "string" then
                execName = name:lower()
            end
        end
        local unsupported = {"potassium", "solara", "celery", "xeno", "mac", "darwin", "apple"}
        for _, bad in ipairs(unsupported) do
            if execName:find(bad) then
                supported = false
                return false
            end
        end
        pcall(function()
            local uis = game:GetService("UserInputService")
            if uis then
                local plat = uis:GetPlatform()
                if plat == Enum.Platform.OSX or plat == Enum.Platform.IOS or plat == Enum.Platform.Android then
                    supported = false
                end
            end
        end)
        if supported == false then
            return false
        end
        supported = true
        return true
    end
    safeGetCustomAsset = function(path)
        if not isCustomAssetSupported() then return nil end
        if type(path) ~= "string" or path == "" then return nil end
        local assetFn = (type(getcustomasset) == "function" and getcustomasset)
            or (type(getsynasset) == "function" and getsynasset)
        if type(assetFn) ~= "function" then return nil end
        local normalized = path:gsub("\\", "/")
        local ok, assetId = pcall(assetFn, normalized)
        if ok and type(assetId) == "string" and assetId ~= "" then
            return assetId
        end
        return nil
    end
end
