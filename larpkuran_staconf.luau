local function saveLarpkuranStandRecord(filename, data)
    local hs = game:GetService("HttpService")
    local suffix = tostring(data.alt or ""):lower()
    writefile(filename:gsub("%.json$", "_" .. suffix .. ".json"), hs:JSONEncode(data))
    local previous
    if type(readfile) == "function" then
        pcall(function() previous = hs:JSONDecode(readfile(filename)) end)
    end
    if type(previous) ~= "table" or not previous.alt or tostring(previous.alt):lower() == suffix then
        writefile(filename, hs:JSONEncode(data))
    end
end
local function clearLarpkuranPairing(altName)
    local success = true
    local alt = tostring(altName or ""):lower()
    local hs = game:GetService("HttpService")
    local function save(filename, data)
        if type(writefile) ~= "function" then success = false; return end
        success = pcall(writefile, filename, hs:JSONEncode(data)) and success
    end
    for _, filename in ipairs({"larpkuran_pair.json", "larpkuran_stand_session.json", "larpkuran_always_stand.json"}) do
        local data
        if type(readfile) == "function" then pcall(function() data = hs:JSONDecode(readfile(filename)) end) end
        if type(data) == "table" then
            if type(data.alts) == "table" then
                local remaining = {}
                for _, name in ipairs(data.alts) do
                    if tostring(name):lower() ~= alt then table.insert(remaining, name) end
                end
                data.alts, data.alt = remaining, remaining[1]
                save(filename, #remaining > 0 and data or {})
            elseif tostring(data.alt or ""):lower() == alt then
                save(filename, {})
            end
        end
        if filename ~= "larpkuran_pair.json" then save(filename:gsub("%.json$", "_" .. alt .. ".json"), {}) end
    end
    local cancelled = {}
    if type(readfile) == "function" then pcall(function() cancelled = hs:JSONDecode(readfile("larpkuran_unpaired.json")) end) end
    if type(cancelled) ~= "table" then cancelled = {} end
    cancelled[alt] = true
    save("larpkuran_unpaired.json", cancelled)
    if game:GetService("Players").LocalPlayer.Name:lower() == alt then
        local env = type(getgenv) == "function" and getgenv() or _G
        for _, scope in ipairs({_G, env}) do
            scope.LarpRole = "Main"
            scope.MainUsername = nil
            scope.StandMainUsername = nil
        end
    end
    return success
end
