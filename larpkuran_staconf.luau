controller.CreateJinRuntime = function(env)
    local state = {seen = {}, seenOrder = {}, hits = {}, casts = {}, electricUntil = 0,
        electricCooldown = 0, zanshinUntil = 0, zanshinCooldown = 0, lastCounter = -math.huge,
        lastEvent = "Waiting for combat events", stopped = false, pending = nil}
    local function on(key) return env.option(key) == true end
    local function alive()
        return not state.stopped and env.alive()
    end
    function state:Reset()
        self.seen, self.seenOrder, self.hits, self.casts = {}, {}, {}, {}
        self.electricUntil, self.electricCooldown = 0, 0
        self.zanshinUntil, self.zanshinCooldown, self.pending = 0, 0, nil
        self.lastCounter, self.lastEvent = -math.huge, "Waiting for combat events"
        self.perkSignals = nil
    end
    function state:Stop()
        self:Reset()
        self.stopped = true
        env.clearWings()
    end
    function state:SyncPerks()
        if not env.perkAttribute then return end
        self.perkSignals = self.perkSignals or {}
        local now = env.now()
        for _, item in ipairs({
            {"JinElectricWind", "electricUntil", "electricDuration", 8},
            {"JinElectricWindCD", "electricCooldown", "electricCooldown", 12},
            {"JinZanshin", "zanshinUntil", "zanshinDuration", 6},
            {"JinZanshinCD", "zanshinCooldown", "zanshinCooldown", 10},
        }) do
            local signal = self.perkSignals[item[1]]
            if not signal then signal = {}; self.perkSignals[item[1]] = signal end
            local value = env.perkAttribute(item[1])
            if value == true then
                if signal.active ~= true then self[item[2]] = now + env.value(item[3], item[4]) end
                signal.active, signal.observed = true, true
            elseif value == false or signal.observed then
                signal.active, signal.observed = false, true
                self[item[2]] = 0
            end
        end
    end
    function state:Counter(target)
        if not alive() or not on("Counter") or not env.isJin() or not env.canCounter(target) then return end
        if self.pending or env.now() - self.lastCounter < 1 then return end
        local ticket = {target = target, character = env.character(), at = env.now()}
        self.pending = ticket
        env.defer(function()
            for _ = 1, 24 do
                if not alive() or self.pending ~= ticket or not on("Counter")
                    or env.character() ~= ticket.character or not env.isJin()
                    or not env.canCounter(target) or env.now() - ticket.at > 0.4 then break end
                if not env.busy() then
                    self.lastCounter = env.now()
                    local ok = env.m2(target)
                    self.lastEvent = ok and "M2 requested after confirmed M1 parry" or "M2 unavailable"
                    break
                end
                env.wait()
            end
            if self.pending == ticket then self.pending = nil end
        end)
    end
    function state:Event(kind, attacker, victim, eventId)
        if not alive() then return end
        if self.character ~= env.character() or self.style ~= env.isJin() then
            self:Reset(); self.character, self.style = env.character(), env.isJin()
        end
        local now = env.now()
        if kind == "CombatM2Swing" then
            if attacker == env.localName() then self.electricUntil = 0 end
            self:SyncPerks(); return
        end
        if kind == "CombatM1HoldSwing" then
            if attacker == env.localName() then self.zanshinUntil = 0 end
            self:SyncPerks(); return
        end
        if kind == "StylePerkBurst" then
            if attacker == env.localName() and env.isJin() then
                local perk = string.lower(tostring(victim)):gsub("[^a-z]", "")
                if perk == "zanshin" then
                    self.zanshinUntil, self.zanshinCooldown = now + env.value("zanshinDuration", 6), now + env.value("zanshinCooldown", 10)
                    self.lastEvent = "Zanshin server feedback (estimated timer)"
                end
            end
            return
        end
        if kind ~= "M1Hit" and kind ~= "M1PerfectBlocked" then return end
        if type(eventId) ~= "string" or eventId == "" then return end
        if self.seen[eventId] then return end
        self.seen[eventId] = true
        table.insert(self.seenOrder, eventId)
        if #self.seenOrder > 128 then self.seen[table.remove(self.seenOrder, 1)] = nil end
        if not env.isJin() then return end
        if kind == "M1PerfectBlocked" and victim == env.localName() and attacker ~= victim then
            if now >= self.electricCooldown then
                self.electricUntil = now + env.value("electricDuration", 8)
                self.electricCooldown = now + env.value("electricCooldown", 12)
            end
            self.lastEvent = "Confirmed M1 parry: " .. tostring(attacker)
            self:Counter(attacker)
        elseif kind == "M1Hit" and attacker == env.localName() and victim ~= attacker then
            local entry = self.hits[victim]
            if not entry then entry = {count = 0}; self.hits[victim] = entry end
            entry.count = entry.count + 1
            entry.at = now
            if entry.count >= env.value("pressureHits", 3) then
                entry.count = 0
                entry.lockUntil = now + env.value("pressureDuration", 1)
            end
            self.lastVictim = victim
            self.lastEvent = "Confirmed M1 hit: " .. tostring(victim)
        end
    end
    function state:Observe(character, attack, track)
        if not alive() or not on("Warning") or not attack.Heavy or string.lower(tostring(attack.Style)) ~= "jin" then return end
        if not env.inWarningRange(character) then return end
        local delays = env.delays(character, attack, track)
        self.casts[character] = {track = track, delays = delays, at = env.now()}
    end
    function state:Warnings()
        local result = {}
        for character, cast in pairs(self.casts) do
            local track = cast.track
            if not on("Warning") or not track or not track.IsPlaying or not env.inWarningRange(character)
                or env.now() - cast.at > 4 then
                self.casts[character] = nil
            else
                local speed = tonumber(track.Speed) or 1
                local position = tonumber(track.TimePosition) or 0
                local remaining = {}
                for i, delay in ipairs(cast.delays) do
                    remaining[i] = speed > 0.01 and math.max(0, (delay - position) / speed) or -1
                end
                table.insert(result, {name = character.Name, remaining = remaining})
            end
        end
        table.sort(result, function(a,b) return a.name < b.name end)
        return result
    end
    function state:Step()
        if not alive() then self:Stop(); return end
        local char = env.character()
        local style = env.isJin()
        if self.character ~= char or self.style ~= style then
            self:Reset(); self.character, self.style = char, style
        end
        self:SyncPerks()
        if not on("Counter") then self.pending = nil end
        if env.localDead and env.localDead() then self:Reset() end
        for name, hit in pairs(self.hits) do
            if env.now() - hit.at > 12 or not env.targetAlive(name) then self.hits[name] = nil end
        end
        self:Warnings()
        env.wings(on("Wings"))
    end
    return state
end
do
    local wings, wingCharacter
    local lastTick, nextBind, nativeConfig = 0, 0, nil
    local bound = {}
    local function clearWings()
        if wings then wings:Destroy(); wings = nil end
        wingCharacter = nil
    end
    local function updateWings(enabled)
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local torso = character and (character:FindFirstChild("LowerTorso") or character:FindFirstChild("Torso"))
        if not enabled or not torso or not humanoid or humanoid.Health <= 0
            or character:GetAttribute("Equip") ~= true or character:GetAttribute("Blocking") ~= true then
            clearWings(); return
        end
        if wings and (wingCharacter ~= character or not wings.Parent) then clearWings() end
        if wings then return end
        local assets = ReplicatedStorage:FindFirstChild("Assets")
        local fx = assets and assets:FindFirstChild("FX")
        local jin = fx and fx:FindFirstChild("Jin")
        local template = jin and jin:FindFirstChild("BlockWings")
        if not template or not template:IsA("BasePart") then return end
        wings = template:Clone()
        wings.Name = "LarpkuranJinBlockWings"
        wings.Anchored, wings.CanCollide, wings.CanTouch, wings.CanQuery, wings.Massless = false, false, false, false, true
        wings.Transparency = 1
        local offset = template:GetAttribute("OffsetCFrame")
        wings.CFrame = torso.CFrame * (typeof(offset) == "CFrame" and offset or CFrame.new())
        for _, child in ipairs(wings:GetDescendants()) do
            if child:IsA("Beam") then child.Enabled = true
            elseif child:IsA("BaseScript") then child:Destroy() end
        end
        local weld = Instance.new("WeldConstraint")
        weld.Part0, weld.Part1, weld.Parent = torso, wings, wings
        wings.Parent, wingCharacter = character, character
    end
    local function resolve(name)
        local player = type(name) == "string" and Players:FindFirstChild(name)
        return player and player.Character or (type(name) == "string" and Workspace:FindFirstChild(name))
    end
    local function isJin() return string.lower(tostring(getRawLocalFightStyle())) == "jin" end
    local function option(key)
        local value = controller.JinStates and controller.JinStates[key]
        return value and value:get()
    end
    local function alive()
        return not controller.Stopped and _G.LarpkuranRageGeneration == larpkuranRageGeneration
    end
    local function targetAlive(name)
        local target = resolve(name)
        local hum = target and target:FindFirstChildOfClass("Humanoid")
        return hum and hum.Health > 0 and target:GetAttribute("Downed") ~= true
    end
    local function canCounter(name)
        local character, target = LocalPlayer.Character, resolve(name)
        local root, enemyRoot = rootOf(character), rootOf(target)
        local hum = character and character:FindFirstChildOfClass("Humanoid")
        if not character or not target or target == character or not root or not enemyRoot or not hum or hum.Health <= 0
            or character:GetAttribute("Equip") ~= true or not targetAlive(name) then return false end
        for _, attr in ipairs({"Downed", "Ragdoll", "Stunned", "Grappling", "M2Cooldown", "Greenzone"}) do
            if character:GetAttribute(attr) == true then return false end
        end
        if target:GetAttribute("Greenzone") == true or target:GetAttribute("Ragdoll") == true then return false end
        if controller.JinRuntime and controller.JinRuntime.character ~= character then return false end
        local selected = controller.FaceAtTarget or controller.CombatTargetPlayer or controller.TargetPlayer
        if controller.ParryOnlyTargetState and controller.ParryOnlyTargetState:get() == true
            and (not selected or selected.Character ~= target) then return false end
        local delta = enemyRoot.Position - root.Position
        if delta.Magnitude > math.clamp(tonumber(option("Range")) or 6, 2, 10) then return false end
        if delta.Magnitude > 0.05 and root.CFrame.LookVector:Dot(delta.Unit) < 0.35 then return false end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {character, target}
        if Workspace:Raycast(root.Position, delta, params) then return false end
        if visualState and visualState.M2Cooldown and visualState.M2Cooldown.GetLeft
            and visualState.M2Cooldown.GetLeft() > 0 then return false end
        return true
    end
    controller.JinRuntime = controller.CreateJinRuntime({
        option = option, now = os.clock, alive = alive, isJin = isJin,
        character = function() return LocalPlayer.Character end,
        localDead = function()
            local c = LocalPlayer.Character
            local h = c and c:FindFirstChildOfClass("Humanoid")
            return not h or h.Health <= 0 or c:GetAttribute("Downed") == true
        end,
        localName = function() local c = LocalPlayer.Character; return c and c.Name or LocalPlayer.Name end,
        canCounter = canCounter, targetAlive = targetAlive,
        perkAttribute = function(name)
            local character = LocalPlayer.Character
            return character and character:GetAttribute(name)
        end,
        electricReady = function()
            local c = LocalPlayer.Character
            return c ~= nil and c:GetAttribute("JinElectricWind") == true
        end,
        busy = function()
            local c = LocalPlayer.Character
            return controller.PulseActive or controller.FallbackBlockActive or (c and
                (c:GetAttribute("Blocking") == true or c:GetAttribute("CantAnything") == true
                or c:GetAttribute("ParryAttackLockout") == true or c:GetAttribute("BlockAttackLockout") == true
                or c:GetAttribute("CombatAttacking") == true or c:GetAttribute("CombatRecovery") == true))
        end,
        m2 = function(name)
            if not alive() or not option("Counter") or not isJin() or not canCounter(name) then return false end
            local c = LocalPlayer.Character
            if not c then return false end
            for _, attribute in ipairs({"Blocking", "CantAnything", "ParryAttackLockout", "BlockAttackLockout", "CombatAttacking", "CombatRecovery"}) do
                if c:GetAttribute(attribute) == true then return false end
            end
            local mod = getCombatModule("M2")
            if not mod or type(mod.OnM2Activated) ~= "function" then return false end
            local ok = pcall(mod.OnM2Activated)
            return ok
        end,
        defer = task.defer, wait = function() RunService.Heartbeat:Wait() end,
        clearWings = clearWings, wings = updateWings,
        inWarningRange = function(c)
            local a,b = rootOf(LocalPlayer.Character), rootOf(c)
            local h = c and c:FindFirstChildOfClass("Humanoid")
            return a and b and h and h.Health > 0 and c.Parent and (a.Position - b.Position).Magnitude <= 30
        end,
        delays = function(c,a,t)
            local _,_,delays = controller.ParryTiming.Resolve(c,a,t)
            return delays or {0.292, 0.842}
        end,
        value = function(key, fallback)
            local map = {electricDuration={"JinElectricWind","BuffSeconds"}, electricCooldown={"JinElectricWind","Cooldown"},
                zanshinDuration={"JinZanshin","BuffSeconds"}, zanshinCooldown={"JinZanshin","Cooldown"},
                pressureHits={"JinPressure","HitsRequired"}, pressureDuration={"JinPressure","LockSeconds"}}
            local field = map[key]
            local cfg = nativeConfig and nativeConfig.Styles and nativeConfig.Styles.jin
            local value = field and cfg and cfg[field[1]] and cfg[field[1]][field[2]]
            return type(value) == "number" and value > 0 and value or fallback
        end,
    })
    controller.JinRuntime.character, controller.JinRuntime.style = LocalPlayer.Character, isJin()
    controller.JinObserve = function(character, track)
        local animation = track.Animation
        local id = animation and tostring(animation.AnimationId):match("%d+")
        local attack = id and attacks[id]
        if attack then controller.JinRuntime:Observe(character, attack, track) end
    end
    local function receive(action, p1, p2, p3, p4)
        if not alive() then return end
        if action == "CombatPairCosmetic" then controller.JinRuntime:Event(p1,p2,p3,p4)
        else controller.JinRuntime:Event(action,p1,p2,p3) end
    end
    trackConnection("Jin_Step", RunService.Heartbeat:Connect(function()
        if not alive() then controller.JinRuntime:Stop(); return end
        local now = os.clock()
        if now - lastTick < 0.1 then return end
        lastTick = now
        if now >= nextBind then
            nextBind = now + 5
            nativeConfig = controller.ParryTiming.Config()
            local shared = ReplicatedStorage:FindFirstChild("Shared")
            local network = shared and shared:FindFirstChild("Network")
            for _, name in ipairs({"CombatBroadcastURE", "CombatClientRemoteEvent"}) do
                local remote = network and network:FindFirstChild(name)
                if remote and bound[name] ~= remote then
                    trackConnection("Jin_" .. name, remote.OnClientEvent:Connect(receive))
                    bound[name] = remote
                end
            end
        end
        controller.JinRuntime:Step()
        if controller.UpdateJinHUD then controller.UpdateJinHUD() end
    end))
end
controller.CreateJinHUD = function(host, input, model)
    local tweenService = game:GetService("TweenService")
    local ui = {tweens = {}, connections = {}, collapsed = false, stopped = false, position = nil}
    local function create(class, props, parent)
        local object = Instance.new(class)
        for key, value in pairs(props) do object[key] = value end
        object.Parent = parent
        return object
    end
    local function connect(signal, callback)
        local conn = signal:Connect(callback)
        table.insert(ui.connections, conn)
        return conn
    end
    local function corner(frame, radius)
        create("UICorner", {CornerRadius = UDim.new(0, radius)}, frame)
    end
    local gui = create("ScreenGui", {Name="LarpkuranJinHUD", ResetOnSpawn=false,
        DisplayOrder=85, ZIndexBehavior=Enum.ZIndexBehavior.Sibling,
        ScreenInsets=Enum.ScreenInsets.DeviceSafeInsets, ClipToDeviceSafeArea=true}, host)
    ui.gui = gui
    local safe = create("Frame", {Name="SafeArea",Size=UDim2.fromScale(1,1),BackgroundTransparency=1},gui)
    local panel = create("Frame", {Name="Panel",BackgroundColor3=Color3.fromRGB(17,18,27),
        BorderSizePixel=0,ClipsDescendants=true,Active=true},safe)
    ui.panel = panel
    corner(panel,14)
    create("UIGradient", {Rotation=35,Color=ColorSequence.new(Color3.fromRGB(25,22,36),Color3.fromRGB(12,15,23))},panel)
    local function animate(object, props, duration)
