    local ignoreList = {character}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then table.insert(ignoreList, p.Character) end
    end
    rayParams.FilterDescendantsInstances = ignoreList
    rayParams.RespectCanCollide = true
    rayParams.IgnoreWater = true
    local initialRay = root and workspace:Raycast(root.Position + Vector3.new(0, 2, 0), Vector3.new(0, -12, 0), rayParams)
    local groundOffset = 3.63
    if initialRay and initialRay.Instance then
        local hitModel = initialRay.Instance:FindFirstAncestorOfClass("Model")
        if not (hitModel and hitModel:FindFirstChildOfClass("Humanoid")) then
            groundOffset = root.Position.Y - initialRay.Position.Y
        end
    end
    local dropkickLockedY = initialRay and (initialRay.Position.Y + groundOffset) or (root and root.Position.Y)
    local speedConn
    speedConn = RunService.Stepped:Connect(function()
        if track.IsPlaying and humanoid.Parent and root and root.Parent then
            humanoid.WalkSpeed = targetSpeed
            if msClient then
                msClient._currentSpeed = targetSpeed
                msClient._targetSpeed = targetSpeed
            end
            if movementUtils and movementUtils.SetSpeed then
                pcall(movementUtils.SetSpeed, humanoid, targetSpeed)
            end
            local floorRay = workspace:Raycast(root.Position + Vector3.new(0, 3, 0), Vector3.new(0, -15, 0), rayParams)
            if floorRay and floorRay.Instance then
                local hitModel = floorRay.Instance:FindFirstAncestorOfClass("Model")
                if not (hitModel and hitModel:FindFirstChildOfClass("Humanoid")) then
                    dropkickLockedY = floorRay.Position.Y + groundOffset
                end
            end
            if dropkickLockedY then
                local pos = root.Position
                if math.abs(pos.Y - dropkickLockedY) > 0.01 then
                    root.CFrame = CFrame.new(pos.X, dropkickLockedY, pos.Z) * root.CFrame.Rotation
                end
            end
            local vel = root.AssemblyLinearVelocity
            if math.abs(vel.Y) > 0.01 then
                root.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
            end
        else
            if speedConn then
                speedConn:Disconnect()
                speedConn = nil
            end
        end
    end)
    local renderConn
    renderConn = RunService.RenderStepped:Connect(function()
        if track.IsPlaying and root and root.Parent and dropkickLockedY then
            local pos = root.Position
            if math.abs(pos.Y - dropkickLockedY) > 0.01 then
                root.CFrame = CFrame.new(pos.X, dropkickLockedY, pos.Z) * root.CFrame.Rotation
            end
            local vel = root.AssemblyLinearVelocity
            if math.abs(vel.Y) > 0.01 then
                root.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
            end
        else
            if renderConn then
                renderConn:Disconnect()
                renderConn = nil
            end
        end
    end)
    local cleanupDone = false
    local function cleanupDropkick()
        if cleanupDone then return end
        cleanupDone = true
        controller.DropkickActive = false
        controller.DropkickTargetSpeed = nil
        dropkickLockedY = nil
        if speedConn then
            speedConn:Disconnect()
            speedConn = nil
        end
        if renderConn then
            renderConn:Disconnect()
            renderConn = nil
        end
        if humanoid.Parent then
            humanoid.WalkSpeed = originalWalkSpeed
            if msClient then
                msClient._currentSpeed = originalWalkSpeed
                msClient._targetSpeed = originalWalkSpeed
            end
            if movementUtils and movementUtils.SetSpeed then
                pcall(movementUtils.SetSpeed, humanoid, originalWalkSpeed)
            end
        end
        animation:Destroy()
    end
    track.Stopped:Once(cleanupDropkick)
    track.Ended:Once(cleanupDropkick)
    task.delay(2.5, cleanupDropkick)
    track:Play()
    log("TOUCH animation played")
end
local KEYCODE_BY_NAME = {}
for _, item in ipairs(Enum.KeyCode:GetEnumItems()) do
    KEYCODE_BY_NAME[string.upper(item.Name)] = item
    KEYCODE_BY_NAME[item.Name] = item
end
local function getKeyCode(keyName, fallback)
    if typeof(keyName) == "EnumItem" then
        if keyName == Enum.KeyCode.Unknown or keyName == Enum.KeyCode.None then return nil end
        return keyName
    end
    local raw = tostring(keyName or ""):gsub("%s+", "")
    if raw ~= "" and string.upper(raw) ~= "NONE" and string.upper(raw) ~= "UNKNOWN" then
        local match = KEYCODE_BY_NAME[string.upper(raw)] or KEYCODE_BY_NAME[raw]
        if match and match ~= Enum.KeyCode.Unknown and match ~= Enum.KeyCode.None then return match end
    end
    if fallback then
        local fb = tostring(fallback):gsub("%s+", "")
        if fb ~= "" and string.upper(fb) ~= "NONE" and string.upper(fb) ~= "UNKNOWN" then
            local match = KEYCODE_BY_NAME[string.upper(fb)] or KEYCODE_BY_NAME[fb]
            if match and match ~= Enum.KeyCode.Unknown and match ~= Enum.KeyCode.None then return match end
        end
    end
    return nil
end
