        end
        if movementRole then
            local weight = controller.FakeStyleHiddenTracks[track]
            if weight and track.IsPlaying then
                pcall(function() track:AdjustWeight(weight, 0.05) end)
            end
        end
        controller.FakeStyleHiddenTracks[track] = nil
        pcall(function() replacementTrack:Destroy() end)
        pcall(function() animation:Destroy() end)
    end)
end
function fakeStyleHelpers.horizontalSpeed(character)
    local root = character and (character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart)
    if not root then return 0 end
    local velocity = root.AssemblyLinearVelocity
    return Vector3.new(velocity.X, 0, velocity.Z).Magnitude
end
function fakeStyleHelpers.desiredMovementRole(character, animator)
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 or humanoid.Sit then return nil end
    for _, attribute in ipairs({"Ragdoll", "Downed", "GrappleWinnerStun"}) do
        if character:GetAttribute(attribute) == true then return nil end
    end
    if type(fakeStyleIsSprinting) == "function" and fakeStyleIsSprinting(character) then return nil end
    if animator then
        local ok, tracks = pcall(function() return animator:GetPlayingAnimationTracks() end)
        if ok and tracks then
            for _, track in ipairs(tracks) do
                local okCheck, isRunning = pcall(function()
                    if not track or not track.IsPlaying then return false end
                    if controller.FakeStyleActiveTracks and controller.FakeStyleActiveTracks[track] then return false end
                    local group = type(fakeStyleTrackGroup) == "function" and fakeStyleTrackGroup(track)
                    if group ~= "movement" then return false end
                    local trackRole = type(fakeStyleMovementRoleForTrack) == "function" and fakeStyleMovementRoleForTrack(track)
                    return trackRole == "run" and (track.WeightCurrent or 0) > 0.05
                end)
                if okCheck and isRunning then
                    return nil
                end
            end
        end
    end
    local movingByInput = humanoid.MoveDirection.Magnitude > 0.05
    local movingByVelocity = type(fakeStyleHelpers.horizontalSpeed) == "function" and fakeStyleHelpers.horizontalSpeed(character) > 0.75
    if movingByInput or movingByVelocity then return "walk" end
    return "idle"
end
function fakeStyleHelpers.sourceMovementTrack(animator, role)
    if not animator or not role then return nil end
    local bestTrack, bestWeight = nil, 0.01
    local ok, tracks = pcall(function() return animator:GetPlayingAnimationTracks() end)
    if not ok or not tracks then return nil end
    for _, track in ipairs(tracks) do
        local okCheck, isMatch = pcall(function()
            if not track or not track.IsPlaying then return false end
            if controller.FakeStyleGuard and controller.FakeStyleGuard[track] then return false end
            if controller.FakeStyleActiveTracks and controller.FakeStyleActiveTracks[track] then return false end
            if controller.FakeStyleReplacementOrigins and controller.FakeStyleReplacementOrigins[track] then return false end
            local group = type(fakeStyleTrackGroup) == "function" and fakeStyleTrackGroup(track)
            if group ~= "movement" then return false end
            local trackRole = type(fakeStyleMovementRoleForTrack) == "function" and fakeStyleMovementRoleForTrack(track)
            return trackRole == role
        end)
        if okCheck and isMatch then
            local weight = math.max(track.WeightCurrent or 0, track.WeightTarget or 0)
            if weight > bestWeight then
                bestTrack, bestWeight = track, weight
            end
        end
    end
    return bestTrack
end
function fakeStyleHelpers.movementReplacementValid(role)
    local replacementTrack = controller.FakeStyleActiveGroups[role]
    if not replacementTrack or not replacementTrack.IsPlaying
        or not controller.FakeStyleActiveTracks[replacementTrack] then
        return false
    end
    local replacementAnimation = controller.FakeStyleMovementMap[role]
    local activeAnimation = replacementTrack.Animation
    return replacementAnimation ~= nil and activeAnimation ~= nil
        and activeAnimation.AnimationId == replacementAnimation.AnimationId
end
function fakeStyleHelpers.reconcileMovement(animator, character)
    if not animator or not character or not controller.FakeStylesEnabled then return end
    local desiredRole = fakeStyleHelpers.desiredMovementRole(character, animator)
    if desiredRole ~= controller.FakeStyleActiveMovementRole then
        controller.FakeStyleMovementTransitionAt = os.clock()
        controller.FakeStyleActiveMovementRole = desiredRole
    end
    for _, role in ipairs({"idle", "walk"}) do
        if role ~= desiredRole then stopFakeStyleMovementRole(role) end
    end
    if not desiredRole then return end
    if fakeStyleHelpers.movementReplacementValid(desiredRole) then return end
    local staleReplacement = controller.FakeStyleActiveGroups[desiredRole]
    if staleReplacement then
        stopFakeStyleMovementRole(desiredRole)
    end
    local sourceTrack = fakeStyleHelpers.sourceMovementTrack(animator, desiredRole)
    fakeStyleHelpers.ensureMovement(animator, desiredRole, sourceTrack)
end
local function rebuildLocalM1Animations()
    table.clear(controller.LocalM1Animations)
    local style = getLocalFightStyle()
    controller.LocalM1Style = style
    local roots = {
        ReplicatedStorage:FindFirstChild("Animations"),
        ReplicatedStorage:FindFirstChild("AnimationsLEGACY"),
    }
    for _, root in ipairs(roots) do
        local combat = root and root:FindFirstChild("Combat")
        local folder = combat and (combat:FindFirstChild(style .. "Anims") or combat:FindFirstChild(style))
        if folder then
            for _, animation in ipairs(folder:GetDescendants()) do
                local slot = animationSlot(animation.Name)
                if animation:IsA("Animation") and slot and slot ~= "M2" then
                    local id = string.match(animation.AnimationId, "%d+")
                    local combo = tonumber(string.match(slot, "^(%d+)"))
                    local timing = windups[style]
                    if id and combo and timing then
                        controller.LocalM1Animations[id] = {
                            Combo = combo,
                            Name = style .. ".M1",
                            Windup = timing.M1[combo] or 0.352,
                        }
                    end
                end
            end
        end
    end
end
