        if track then
            track.Priority = Enum.AnimationPriority.Action4
            track:Play(0.1, 1.2, 1)
            controller.SlenderManTrack = track
            if track.Length > 0 then controller.SlenderManStatus = "Active" end
            task.delay(0.2, function()
                if track and track.IsPlaying then
                    track:AdjustWeight(1.2, 0.1)
                end
            end)
        end
        return track
    end
    local tallTrack = getTallTrack() or playTallTrack()
    controller.FeatureDebugPush("Slenderman track=" .. tostring(tallTrack and tallTrack.IsPlaying or false))
    local validationPending = animAsset ~= "rbxassetid://92807081069528"
    if validationPending then
        local requestedAsset = animAsset
        task.delay(3, function()
            validationPending = false
            if controller.SlenderManActive and generation == controller.SlenderManGeneration and character.Parent
                and controller.SlenderManCurrentAnimId == requestedAsset and (not tallTrack or tallTrack.Length == 0) then
                if tallTrack then pcall(function() tallTrack:Stop(0.1) end) end
                animAsset = "rbxassetid://92807081069528"
                controller.SlenderManCurrentAnimId = animAsset
                controller.SlenderManStatus = "Custom animation unavailable; using default"
                playTallTrack()
            elseif controller.SlenderManActive and generation == controller.SlenderManGeneration
                and controller.SlenderManCurrentAnimId == requestedAsset then
                controller.SlenderManStatus = "Active"
            end
        end)
    end
    local nextTallCheck = 0
    if getgenv().GakuranTallConn then
        getgenv().GakuranTallConn:Disconnect()
        getgenv().GakuranTallConn = nil
    end
    getgenv().GakuranTallConn = RunService.Heartbeat:Connect(function()
        if not controller.SlenderManActive or not character.Parent or not humanoid or not humanoid.Parent or not lt or not hrp then return end
        local now = os.clock()
        if now < nextTallCheck then return end
        nextTallCheck = now + 0.10
        local t = getTallTrack()
        local currentOffset = lt.Position.Y - hrp.Position.Y
        if not validationPending and (not t or not t.IsPlaying or currentOffset < 1.0) then
            playTallTrack()
        elseif math.abs(t.WeightCurrent - 1.2) > 0.3 then
            t:AdjustWeight(1.2, 0.05)
        end
    end)
    table.insert(controller.SlenderManConnections, getgenv().GakuranTallConn)
    local stateConn = humanoid.StateChanged:Connect(function(old, new)
        if not controller.SlenderManActive or not character.Parent then return end
        if new == Enum.HumanoidStateType.GettingUp or new == Enum.HumanoidStateType.Landed then
            task.delay(0.1, function()
                if controller.SlenderManActive and character.Parent then
                    playTallTrack()
                end
            end)
        end
    end)
    table.insert(controller.SlenderManConnections, stateConn)
    local function setupValueWatch(valName)
        local val = character:FindFirstChild(valName)
        if val then
            local valConn = val.Changed:Connect(function(v)
                if not controller.SlenderManActive or not character.Parent then return end
                if v == false then
                    task.delay(0.2, function()
                        if controller.SlenderManActive and character.Parent then
                            playTallTrack()
                        end
                    end)
                end
            end)
            table.insert(controller.SlenderManConnections, valConn)
        end
    end
    setupValueWatch("Downed")
    setupValueWatch("Ragdoll")
end
controller.SetSlenderMan = function(enable)
