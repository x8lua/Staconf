    controller.ActiveDodgeDirection, controller.ActiveDodgeDistance = direction, dash.distance
    table.insert(dash.connections, character:GetAttributeChangedSignal("Equip"):Connect(function()
        if not controller.CanAutoDodge(character) then controller.StopAutoDodge() end
    end))
    table.insert(dash.connections, RunService.PreSimulation:Connect(function(dt)
        if controller.AutoDodgeMotion ~= dash then return end
