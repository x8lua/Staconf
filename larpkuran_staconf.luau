            local master = currentMaster or mainPlayer or getMainPlayer()
            local masterChar = master and master.Character
            local masterHRP = masterChar and rootOf(masterChar)
            local targetChar = target.Character
            local targetRoot = rootOf(targetChar)
            local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
            if not targetChar or not targetRoot or not targetHum or targetHum.Health <= 0 or not targetChar:IsDescendantOf(workspace) then
                break
            end
            local altChar = localPlayer.Character
            local altHum = altChar and altChar:FindFirstChildOfClass("Humanoid")
            local altHRP = altChar and rootOf(altChar)
            if not altChar or not altHRP or not altHum or altHum.Health <= 0 then
                task.wait(0.1)
                continue
            end
            if altHum.Sit then
                altHum.Sit = false
                altHum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
            altHum.PlatformStand = true
            workspace.Gravity = 0
            local refPos = masterHRP and masterHRP.Position or altHRP.Position
            local distFromMaster = (targetRoot.Position - refPos).Magnitude
            local yDiff = masterHRP and (masterHRP.Position.Y - targetRoot.Position.Y) or 0
            if distFromMaster >= 1000 or yDiff >= 200 or targetRoot.Position.Y < -350 then
                break
            end
            updateAttackHud(target, 0, 0)
            if hudDealText then
                hudDealText.Text = string.format("YEET | DIST: %d | Y: %d", math.floor(distFromMaster), math.floor(targetRoot.Position.Y))
            end
            RunService.Heartbeat:Wait()
            if not ownsYeet() then break end
            altChar = localPlayer.Character
            altHum = altChar and altChar:FindFirstChildOfClass("Humanoid")
            altHRP = altChar and rootOf(altChar)
            if not altChar or not altHRP or not altHum or altHum.Health <= 0 then
                task.wait(0.1)
                continue
            end
            if altHum.Sit then
                altHum.Sit = false
                altHum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
            local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
            local targetVel = targetRoot.AssemblyLinearVelocity
            local horizVel = Vector3.new(targetVel.X, 0, targetVel.Z)
            local isFalling = false
            if targetHum and targetHum.FloorMaterial == Enum.Material.Air and targetVel.Y < -4 then
                isFalling = true
            elseif targetHum and targetHum:GetState() == Enum.HumanoidStateType.Freefall and targetVel.Y < -2 then
                isFalling = true
            elseif targetVel.Y < -12 then
                isFalling = true
            end
            if isFalling then
                wasFalling = true
                yeetTweenIndex = 0
                local tPos = targetRoot.Position
                altHRP.CFrame = CFrame.new(tPos.X, tPos.Y + 6, tPos.Z)
                altHRP.AssemblyLinearVelocity = Vector3.zero
                if hudDealText then
                    hudDealText.Text = string.format("YEET | WAITING FALL | Y: %d", math.floor(tPos.Y))
                end
                RunService.RenderStepped:Wait()
                if not ownsYeet() then break end
                if altHRP.Parent then
                    altHRP.AssemblyLinearVelocity = Vector3.zero
                end
                RunService.Stepped:Wait()
                if not ownsYeet() then break end
                if altHRP.Parent then
                    altHRP.AssemblyLinearVelocity = Vector3.zero
                end
                continue
            end
            if wasFalling then
                wasFalling = false
                justLandedUntil = os.clock() + 0.8
                yeetTweenIndex = 0
            end
            local isStandingStill = (targetHum and targetHum.MoveDirection.Magnitude < 0.05 and horizVel.Magnitude < 2.5) or (horizVel.Magnitude < 1.5) or (os.clock() < justLandedUntil)
            if isStandingStill then
                local head = targetChar:FindFirstChild("Head")
                local tPos = targetRoot.Position
                local topY = head and (head.Position.Y + 1.5) or (tPos.Y + 3.4)
                local bottomY = tPos.Y - 2.8
                local alpha = yeetTweenIndex / YEET_TWEEN_STEPS
                local currentY = topY + (bottomY - topY) * alpha
                altHRP.CFrame = CFrame.new(tPos.X, currentY, tPos.Z)
                yeetTweenIndex = (yeetTweenIndex + 1) % (YEET_TWEEN_STEPS + 1)
            else
                yeetTweenIndex = 0
                local predicted = predictedTargetPosition(targetChar, targetRoot)
                altHRP.CFrame = targetFlingCFrame(targetRoot, predicted)
            end
            local velocity = altHRP.AssemblyLinearVelocity
            altHRP.AssemblyLinearVelocity = velocity * flingStrength + Vector3.new(0, -flingStrength, 0)
            RunService.RenderStepped:Wait()
            if not ownsYeet() then break end
            if altHRP.Parent then
                altHRP.AssemblyLinearVelocity = velocity
            end
            RunService.Stepped:Wait()
            if not ownsYeet() then break end
            if altHRP.Parent then
                altHRP.AssemblyLinearVelocity = velocity + Vector3.new(0, movel, 0)
                movel = -movel
            end
        end
        if not ownsYeet() then return end
        local wasCancelled = isYeetCancelledByUser
        stopYeet()
        if not wasCancelled then
            local master = currentMaster or mainPlayer or getMainPlayer()
            local masterChar = master and master.Character
            local masterHRP = masterChar and rootOf(masterChar)
            local altHRPFinal = localPlayer.Character and rootOf(localPlayer.Character)
            local isStandingOther = (currentMaster and mainPlayer and currentMaster ~= mainPlayer)
            if (not isStealthEnabled or isStandingOther) and masterHRP and altHRPFinal then
                safeTeleportTo(masterHRP.CFrame * CFrame.new(0, 3, 3), masterHRP, CFrame.new(0, 3, 3))
            elseif altHRPFinal then
                altHRPFinal.CFrame = CFrame.new(altHRPFinal.Position.X, BUFFER_RETURN_Y, altHRPFinal.Position.Z)
                altHRPFinal.AssemblyLinearVelocity = Vector3.zero
                altHRPFinal.AssemblyAngularVelocity = Vector3.zero
            end
            sayMessage(string.format("%s has been yeeted!", target.DisplayName))
        end
    end)
end
