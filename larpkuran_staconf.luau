function peerTracker.Snapshot.Encode(img, scale)
    scale = scale or 2
    local size = img.Size
    local sourceWidth, sourceHeight = math.floor(size.X), math.floor(size.Y)
    local width, height = math.max(1, math.floor(sourceWidth / scale)), math.max(1, math.floor(sourceHeight / scale))
    local source = img:ReadPixelsBuffer(Vector2.zero, size)
    local rowBytes = width * 3
    local stride = rowBytes + ((4 - rowBytes % 4) % 4)
    local pixelBytes = stride * height
    local output = buffer.create(54 + pixelBytes)
    local function put16(offset, value)
        buffer.writeu8(output, offset, value % 256)
        buffer.writeu8(output, offset + 1, math.floor(value / 256) % 256)
    end
    local function put32(offset, value)
        buffer.writeu8(output, offset, value % 256)
        buffer.writeu8(output, offset + 1, math.floor(value / 256) % 256)
        buffer.writeu8(output, offset + 2, math.floor(value / 65536) % 256)
        buffer.writeu8(output, offset + 3, math.floor(value / 16777216) % 256)
    end
    buffer.writeu8(output, 0, 66)
    buffer.writeu8(output, 1, 77)
    put32(2, 54 + pixelBytes)
    put32(10, 54)
    put32(14, 40)
    put32(18, width)
    put32(22, height)
    put16(26, 1)
    put16(28, 24)
    put32(34, pixelBytes)
    for y = 0, height - 1 do
        local sourceY = math.min(sourceHeight - 1, y * scale)
        local rowOffset = 54 + (height - 1 - y) * stride
        for x = 0, width - 1 do
            local sourceX = math.min(sourceWidth - 1, x * scale)
            local sourceOffset = (sourceY * sourceWidth + sourceX) * 4
            local destinationOffset = rowOffset + x * 3
            buffer.writeu8(output, destinationOffset, buffer.readu8(source, sourceOffset + 2) or 0)
            buffer.writeu8(output, destinationOffset + 1, buffer.readu8(source, sourceOffset + 1) or 0)
            buffer.writeu8(output, destinationOffset + 2, buffer.readu8(source, sourceOffset) or 0)
        end
    end
    return buffer.tostring(output)
end
function peerTracker.Snapshot.Capture(requestId)
