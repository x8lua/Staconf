local function canParry(enemyCharacter, scheduling)
    if not controller.Enabled then return false end
    if (controller.DisableBlockMidDash or (controller.DisableBlockMidDashState and controller.DisableBlockMidDashState:get() == true)) and controller.IsDashing and controller.IsDashing() then return false end
    local character = LocalPlayer.Character
    local localRoot, enemyRoot = rootOf(character), rootOf(enemyCharacter)
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local enemyHumanoid = enemyCharacter and enemyCharacter:FindFirstChildOfClass("Humanoid")
    if not localRoot or not enemyRoot or not humanoid or humanoid.Health <= 0 then return false end
    if not enemyHumanoid or enemyHumanoid.Health <= 0 then return false end
    local baseRadius = tonumber(controller.Radius) or 10.5
    local maxDist = math.max(baseRadius, 10.5)
    local currentDist = (localRoot.Position - enemyRoot.Position).Magnitude
    local toEnemy = enemyRoot.Position - localRoot.Position
    local toEnemyH = Vector3.new(toEnemy.X, 0, toEnemy.Z)
    local eVel = enemyRoot.AssemblyLinearVelocity or enemyRoot.Velocity or Vector3.zero
    local mVel = localRoot.AssemblyLinearVelocity or localRoot.Velocity or Vector3.zero
    local relVel = eVel - mVel
    local approachSpeed = toEnemyH.Magnitude > 0.05 and math.max(0, -relVel:Dot(toEnemyH.Unit)) or 0
    if scheduling then
        if currentDist > (maxDist + math.min(approachSpeed * 0.45, 11)) then return false end
    else
        if currentDist > (maxDist + 3.5 + math.min(approachSpeed * 0.25, 5.5)) then return false end
    end
    local buffered = character:GetAttribute("ParryBuffered") == true
        and character:GetAttribute("GuardBroken") ~= true
        and character:GetAttribute("ParryWindowDisabled") ~= true
    for _, attribute in ipairs({"Ragdoll", "Downed", "GrappleWinnerStun", "CantAnything", "GuardBroken", "Stunned", "Grappling", "SpecTimeSlowed", "Greenzone", "RpCombatLocked", "StaffModPeaceMode"}) do
        local transient = attribute == "Stunned" or attribute == "CantAnything"
        if not (transient and (buffered or scheduling)) then
            if character:GetAttribute(attribute) == true then return false end
        end
    end
    if not scheduling and (character:GetAttribute("BlockCooldown") == true
        or character:GetAttribute("ParryWindowDisabled") == true
        or character:GetAttribute("PerfectBlocking") == true) then return false end
    if character:GetAttribute("Equip") ~= true then
        return false
    end
    return true
end
