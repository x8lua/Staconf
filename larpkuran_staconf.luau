    local function handleToggleDrag(input)
        if not dragging or not activeInput then return end
        if (activeInput.UserInputType == Enum.UserInputType.Touch and input.UserInputType ~= Enum.UserInputType.Touch)
            or (activeInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.MouseMovement) then return end
        local currentPos = Vector2.new(input.Position.X, input.Position.Y)
        local delta = currentPos - dragStart
        if delta.Magnitude > 6 then
            dragMoved = true
        end
        if dragMoved then
