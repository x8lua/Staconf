    while hiddenfling and controller.FlingEnabled do
        RunService.Heartbeat:Wait()
        if controller.IsM1ing then
            continue
        end
        if controller.FlingDisableStandingStill and not isLocalPlayerMoving() then
            continue
        end
        local character = LocalPlayer.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if hrp then
            if controller.TargetFling then
                local targetCharacter = controller.TargetPlayer and controller.TargetPlayer.Character or controller.TargetCharacter
                controller.TargetCharacter = targetCharacter
                local targetRoot = rootOf(targetCharacter)
                if targetRoot and targetRoot:IsDescendantOf(workspace) then
                    startTargetLook()
                    local targetHum = targetCharacter and targetCharacter:FindFirstChildOfClass("Humanoid")
                    local targetVel = targetRoot.AssemblyLinearVelocity
                    local horizVel = Vector3.new(targetVel.X, 0, targetVel.Z)
                    local isFalling = false
                    if targetHum and targetHum.FloorMaterial == Enum.Material.Air and targetVel.Y < -4 then
                        isFalling = true
                    elseif targetHum and targetHum:GetState() == Enum.HumanoidStateType.Freefall and targetVel.Y < -2 then
                        isFalling = true
                    elseif targetVel.Y < -12 then
                        isFalling = true
                    end
                    if isFalling then
                        controllerYeetWasFalling = true
                        controllerYeetTweenIndex = 0
                        local tPos = targetRoot.Position
                        hrp.CFrame = CFrame.new(tPos.X, tPos.Y + 6, tPos.Z)
                        hrp.Velocity = Vector3.zero
                        RunService.RenderStepped:Wait()
                        if hrp.Parent then hrp.Velocity = Vector3.zero end
                        RunService.Stepped:Wait()
                        if hrp.Parent then hrp.Velocity = Vector3.zero end
                        continue
                    end
                    if controllerYeetWasFalling then
                        controllerYeetWasFalling = false
                        controllerYeetJustLandedUntil = os.clock() + 0.8
                        controllerYeetTweenIndex = 0
                    end
                    local isStandingStill = (targetHum and targetHum.MoveDirection.Magnitude < 0.05 and horizVel.Magnitude < 2.5) or (horizVel.Magnitude < 1.5) or (os.clock() < controllerYeetJustLandedUntil)
                    if isStandingStill then
                        local head = targetCharacter:FindFirstChild("Head")
                        local tPos = targetRoot.Position
                        local topY = head and (head.Position.Y + 1.5) or (tPos.Y + 3.4)
                        local bottomY = tPos.Y - 2.8
                        local alpha = controllerYeetTweenIndex / 6
                        local currentY = topY + (bottomY - topY) * alpha
                        hrp.CFrame = CFrame.new(tPos.X, currentY, tPos.Z)
                        controllerYeetTweenIndex = (controllerYeetTweenIndex + 1) % 7
                    else
                        controllerYeetTweenIndex = 0
                        local predicted = predictedTargetPosition(targetCharacter, targetRoot)
                        hrp.CFrame = targetFlingCFrame(targetRoot, predicted)
                    end
                else
                    stopTargetLook()
                end
            else
                stopTargetLook()
            end
            local velocity = hrp.Velocity
            local flingStrength = controller.TargetFling and controller.TargetFlingStrength or controller.FlingStrength
            hrp.Velocity = velocity * flingStrength + Vector3.new(0, -flingStrength, 0)
            RunService.RenderStepped:Wait()
            if hrp.Parent then hrp.Velocity = velocity end
            RunService.Stepped:Wait()
            if hrp.Parent then
                hrp.Velocity = velocity + Vector3.new(0, movel, 0)
                movel = -movel
            end
        end
    end
    stopTargetLook()
    flingRunning = false
end
