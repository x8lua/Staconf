local function fakeStyleMovementRole(name)
    local value = string.lower(tostring(name or "")):gsub("[^%w]", "")
    if value:find("idle", 1, true) then return "idle" end
    if value:find("walk", 1, true) then return "walk" end
    if value:find("run", 1, true) or value:find("jog", 1, true) then return "run" end
    return nil
end
local function fakeStyleMovementRoleForTrack(track)
    local animation = track and track.Animation
    local role = fakeStyleMovementRole(animation and animation.Name)
        or fakeStyleMovementRole(track and track.Name)
    if role then return role end
    if track and track.Priority == Enum.AnimationPriority.Core then return "idle" end
    return nil
end
function fakeStyleHelpers.destroyReplacement(replacementTrack)
    if not replacementTrack then return end
    local animation = controller.FakeStyleActiveTracks[replacementTrack]
    controller.FakeStyleActiveTracks[replacementTrack] = nil
    controller.FakeStyleReplacementRoles[replacementTrack] = nil
    controller.FakeStyleGuard[replacementTrack] = nil
    for originalTrack, activeReplacement in pairs(controller.FakeStyleReplacementOrigins) do
        if activeReplacement == replacementTrack then
            controller.FakeStyleReplacementOrigins[originalTrack] = nil
        end
    end
    for role, activeReplacement in pairs(controller.FakeStyleActiveGroups) do
        if activeReplacement == replacementTrack then
            controller.FakeStyleActiveGroups[role] = nil
        end
    end
    pcall(function() replacementTrack:Stop(0.05) end)
    pcall(function() replacementTrack:Destroy() end)
    if animation then pcall(function() animation:Destroy() end) end
end
local function fakeStyleIsSprinting(character, track)
    if character and character:GetAttribute("Sprinting") == true then return true end
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid:GetAttribute("Sprinting") == true then return true end
    local animation = track and track.Animation
    local name = string.lower(tostring(animation and animation.Name or "") .. " " .. tostring(track and track.Name or ""))
    return name:find("run", 1, true) ~= nil or name:find("jog", 1, true) ~= nil
end
local function stopFakeStyleMovementRole(role)
    local replacements, seen = {}, {}
    local groupedTrack = controller.FakeStyleActiveGroups[role]
    if groupedTrack then
        replacements[#replacements + 1] = groupedTrack
        seen[groupedTrack] = true
    end
    for replacementTrack, replacementRole in pairs(controller.FakeStyleReplacementRoles) do
        if replacementRole == role and not seen[replacementTrack] then
            replacements[#replacements + 1] = replacementTrack
            seen[replacementTrack] = true
        end
    end
    for originalTrack, replacementTrack in pairs(controller.FakeStyleReplacementOrigins) do
        local originalRole = fakeStyleMovementRoleForTrack(originalTrack)
        local replacementRole = controller.FakeStyleReplacementRoles[replacementTrack] or originalRole
        if replacementRole == role and not seen[replacementTrack] then
            replacements[#replacements + 1] = replacementTrack
            seen[replacementTrack] = true
        end
    end
    for _, replacementTrack in ipairs(replacements) do
        fakeStyleHelpers.destroyReplacement(replacementTrack)
    end
    controller.FakeStyleActiveGroups[role] = nil
    for originalTrack, weight in pairs(controller.FakeStyleHiddenTracks) do
        local replacementTrack = controller.FakeStyleReplacementOrigins[originalTrack]
        local originalRole = fakeStyleMovementRoleForTrack(originalTrack)
        local mappedRole = controller.FakeStyleReplacementRoles[replacementTrack] or originalRole
        if mappedRole == role or originalRole == role then
            if originalTrack.Parent and originalTrack.IsPlaying then
                pcall(function() originalTrack:AdjustWeight(weight, 0.05) end)
            end
            controller.FakeStyleHiddenTracks[originalTrack] = nil
        end
    end
    if controller.FakeStyleActiveMovementRole == role then
        controller.FakeStyleActiveMovementRole = nil
    end
end
function fakeStyleHelpers.movementAnimation(role)
    local animation = controller.FakeStyleMovementMap[role]
    if animation and animation.Parent and animation.AnimationId ~= "" then
        return animation
    end
    return nil
end
function fakeStyleHelpers.ensureMovement(animator, role, sourceTrack)
    if not animator or not role or not controller.FakeStylesEnabled then return nil end
    local replacementAnimation = fakeStyleHelpers.movementAnimation(role)
    if not replacementAnimation then return nil end
    local activeTrack = controller.FakeStyleActiveGroups[role]
    if activeTrack and controller.FakeStyleActiveTracks[activeTrack] and activeTrack.IsPlaying then
        local activeAnimation = activeTrack.Animation
        if activeAnimation and activeAnimation.AnimationId == replacementAnimation.AnimationId then
            return activeTrack
        end
        fakeStyleHelpers.destroyReplacement(activeTrack)
    end
    local retryAt = controller.FakeStyleMovementRetryAt[role] or 0
    if os.clock() < retryAt then return nil end
    controller.FakeStyleMovementRetryAt[role] = os.clock() + 0.25
    local animation = Instance.new("Animation")
    animation.Name = "LarpkuranFake_" .. role .. "_" .. replacementAnimation.Name
    animation.AnimationId = replacementAnimation.AnimationId
    local replacementTrack
    local ok = pcall(function()
        replacementTrack = animator:LoadAnimation(animation)
        controller.FakeStyleGuard[replacementTrack] = true
        replacementTrack.Priority = Enum.AnimationPriority.Movement
        replacementTrack.Looped = true
        local speed = sourceTrack and math.abs(sourceTrack.Speed or 1) or 1
        replacementTrack:Play(0.08, 1, math.max(speed, 0.05))
    end)
    if not ok or not replacementTrack then
        if replacementTrack then controller.FakeStyleGuard[replacementTrack] = nil end
        animation:Destroy()
        return nil
    end
    controller.FakeStyleActiveTracks[replacementTrack] = animation
    controller.FakeStyleReplacementRoles[replacementTrack] = role
    controller.FakeStyleActiveGroups[role] = replacementTrack
    controller.FakeStyleMovementSources[role] = sourceTrack
    controller.FakeStyleMovementRetryAt[role] = 0
    controller.FakeStyleMovementSeen += 1
    controller.FakeStylePlayed += 1
    controller.FakeStyleStatus = "Playing " .. replacementAnimation.Name
    replacementTrack.Stopped:Once(function()
        if controller.FakeStyleActiveGroups[role] == replacementTrack then
            controller.FakeStyleActiveGroups[role] = nil
        end
        controller.FakeStyleActiveTracks[replacementTrack] = nil
        controller.FakeStyleReplacementRoles[replacementTrack] = nil
        controller.FakeStyleGuard[replacementTrack] = nil
        if controller.FakeStyleMovementSources[role] == sourceTrack then
            controller.FakeStyleMovementSources[role] = nil
        end
        pcall(function() replacementTrack:Destroy() end)
        pcall(function() animation:Destroy() end)
    end)
    return replacementTrack
end
local function fakeStyleTrackGroup(track)
    local animation = track and track.Animation
    local name = string.lower(tostring(animation and animation.Name or "") .. " " .. tostring(track and track.Name or ""))
    if name:find("m1", 1, true) or name:find("m2", 1, true) or name:find("attack", 1, true) then return "attack" end
    if name:find("idle", 1, true) or name:find("walk", 1, true) or name:find("run", 1, true)
        or name:find("jog", 1, true) or name:find("jump", 1, true) or name:find("fall", 1, true)
        or name:find("climb", 1, true) or name:find("swim", 1, true) then
        return "movement"
    end
    if track and track.Priority == Enum.AnimationPriority.Movement then return "movement" end
    return "other"
end
local function restartDefaultAnimate(character)
    local animate = character and character:FindFirstChild("Animate")
    if not animate or not animate:IsA("LocalScript") then return end
    animate.Disabled = true
    task.defer(function()
        if animate and animate.Parent then animate.Disabled = false end
