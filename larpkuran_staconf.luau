function visualState.ReadDodgeCooldown(character, now)
    local custom = controller.EvasiveEnabledState and controller.EvasiveEnabledState:get() == true
    local configured = tonumber(controller.EvasiveCooldownState and controller.EvasiveCooldownState:get()) or 0
    local infinite = custom and configured <= 0
    local state = visualState.DodgeCooldown
    if state.Character ~= character or infinite then
        state.Character, state.Active, state.Started, state.Duration = character, false, nil, nil
        state.LastRemaining, state.EndsAt = nil, nil
    end
    if infinite then return false, 0, "" end
    if not character then return false, 0, "—" end
    local remaining = character:GetAttribute("EvasiveCooldownRemaining")
    local active = character:GetAttribute("IFRAMECD")
    if type(remaining) == "number" and remaining == remaining and remaining > 0 then
        if not state.Active then
            state.Started, state.Duration = now, remaining
        end
        if not state.Active or state.LastRemaining ~= remaining then
            state.EndsAt = now + remaining
            state.Duration = math.max(remaining, state.Duration or 0)
        end
        state.Active, state.LastRemaining = true, remaining
        local left = math.max(0, state.EndsAt - now)
        return true, math.clamp(left / state.Duration, 0, 1), left > 0 and string.format("%.1f s", left) or "COOLDOWN"
    end
    if active ~= nil and active ~= false then
        if not state.Active then
            state.Started = now
            local duration = custom and configured or nil
            if not duration and controller.ReadNativeDodgeDuration then
                local ok, value = pcall(controller.ReadNativeDodgeDuration, character)
                if ok and type(value) == "number" and value > 0 then duration = value end
            end
            state.Duration = duration
        end
        state.Active = true
        if state.Duration and state.Started then
            local left = math.max(0, (state.EndsAt or (state.Started + state.Duration)) - now)
            return true, math.clamp(left / state.Duration, 0, 1), left > 0 and string.format("~%.1f s", left) or "COOLDOWN"
        end
        return true, 0, "COOLDOWN"
    end
    state.Active, state.Started, state.Duration = false, nil, nil
    state.LastRemaining, state.EndsAt = nil, nil
    return false, 1, "READY"
end
