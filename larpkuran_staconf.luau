                                Body = bmp,
                            })
                        end)
                    end
                end
                pcall(function() image:Destroy() end)
            end
            peerTracker.Snapshot.Busy = false
        end)
    end)
    if not ok then peerTracker.Snapshot.Busy = false end
end
