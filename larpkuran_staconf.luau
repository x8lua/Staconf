    if s < 0.15 and v < 0.25 then
        dyeDesc = "Charcoal"
    elseif s < 0.15 and v >= 0.80 then
        dyeDesc = "Pale / Ash"
    elseif s < 0.15 then
        dyeDesc = "Grey"
    elseif h < 0.05 or h >= 0.95 then
        dyeDesc = "Red"
    elseif h >= 0.05 and h < 0.12 then
        dyeDesc = "Orange"
    elseif h >= 0.12 and h < 0.19 then
        dyeDesc = "Blonde / Yellow"
    elseif h >= 0.19 and h < 0.45 then
        dyeDesc = "Green"
    elseif h >= 0.45 and h < 0.55 then
        dyeDesc = "Cyan / Teal"
    elseif h >= 0.55 and h < 0.72 then
