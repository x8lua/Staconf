controller.LivePingSamples = {}
controller.GetLiveMetrics = function()
    local p = nil
    pcall(function()
        if LocalPlayer.GetNetworkPing then
            local np = LocalPlayer:GetNetworkPing()
            if np and np > 0 and np < 2 then
                p = np
            end
        end
    end)
    if not p then
        pcall(function()
            local Stats = game:GetService("Stats")
            local dp = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
            if dp and dp > 0 and dp < 2 then
                p = dp * 0.5
            end
        end)
    end
    p = p or 0.05
    table.insert(controller.LivePingSamples, p)
    if #controller.LivePingSamples > 10 then
        table.remove(controller.LivePingSamples, 1)
    end
    local sum = 0
    local minP, maxP = math.huge, 0
    for _, v in ipairs(controller.LivePingSamples) do
        sum = sum + v
        if v < minP then minP = v end
        if v > maxP then maxP = v end
    end
    local meanRtt = sum / #controller.LivePingSamples
    local jitter = (#controller.LivePingSamples > 1) and ((maxP - minP) * 0.5) or 0.005
    local fps = 60
    pcall(function()
        fps = math.clamp(workspace:GetRealPhysicsFPS(), 30, 240)
    end)
    local frameDelta = 1 / fps
    local oneWay = meanRtt * 0.5
    controller.LivePing = oneWay
    controller.LiveJitter = jitter
    controller.LiveFPS = fps
    controller.LiveRewindOffset = math.clamp(oneWay + 0.012, 0.02, 0.10)
    return {
        rtt = meanRtt,
        oneWay = oneWay,
        jitter = jitter,
        fps = fps,
        frameDelta = frameDelta
    }
end
