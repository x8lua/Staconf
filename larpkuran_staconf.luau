controller.RemovePlayerVisual = function(player)
    if controller.FaceAtTarget == player then
        controller.FaceAtTarget = nil
        controller.FaceAtFlickerTarget = nil
        controller.FaceAtFlickerUntil = 0
    end
    local visual = visualState.Players[player]
    if visual then
        if visual.Highlight then destroyVisual(visual.Highlight) end
        if visual.AttackZoneFolder then destroyVisual(visual.AttackZoneFolder) end
        if visual.Drawings then
            for _, obj in ipairs(visual.Drawings) do
                pcall(function() obj.Visible = false; obj:Remove() end)
            end
        end
        visualState.Players[player] = nil
    end
end
controller.HidePlayerAttackZone = function(entry)
    if not entry or not entry.AttackZoneVisible then return end
    entry.AttackZoneVisible = false
    if entry.AttackZoneSlices then
        for _, p in ipairs(entry.AttackZoneSlices) do
            if p.Transparency < 1 then
                p.Transparency = 1
                p.CFrame = CFrame.new(0, -9999, 0)
            end
        end
    end
    if entry.AttackZoneBorders then
        for _, b in ipairs(entry.AttackZoneBorders) do
            if b.Transparency < 1 then
                b.Transparency = 1
                b.CFrame = CFrame.new(0, -9999, 0)
            end
        end
    end
end
controller.HidePlayerDrawings = function(entry)
    if not entry then return end
    if entry.Drawings then
        for _, obj in ipairs(entry.Drawings) do
            if obj.Visible then obj.Visible = false end
        end
    end
end
controller.HidePlayerEsp = function(entry)
    if not entry then return end
    entry.Active = false
    if entry.Highlight and entry.Highlight.Enabled then
        entry.Highlight.Enabled = false
        entry.Highlight.Adornee = nil
    end
    if entry.Drawings then
        for _, obj in ipairs(entry.Drawings) do
            if obj.Visible then obj.Visible = false end
        end
    end
end
controller.WatchPlayerVisual = function(player)
    if _G.LarpkuranRageGeneration ~= larpkuranRageGeneration then return end
    controller.SetupPlayerVisual(player)
    if player ~= LocalPlayer then
        trackConnection("VisualState_CharacterAdded_" .. (player and player.Name or "Unknown"), player.CharacterAdded:Connect(function(character)
            if _G.LarpkuranRageGeneration ~= larpkuranRageGeneration then return end
            local existing = visualState.Players[player]
            if existing then
                existing.CachedParts = nil
                existing.CachedIsR15 = nil
                existing.CachedStyle = nil
            end
            controller.SetupPlayerVisual(player)
        end))
    end
end
local function updatePassiveHud()
    local hud = visualState.Hud
    if not hud or not hud.Alive then return end
    local tickNow = os.clock()
    if hud.LastUpdate and tickNow - hud.LastUpdate < 0.05 then return end
    hud.LastUpdate = tickNow
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local health = humanoid and math.max(0, humanoid.Health) or 0
    local maxHealth = humanoid and math.max(1, humanoid.MaxHealth) or 100
    hud.SetValue("Health", health / maxHealth, humanoid and tostring(math.ceil(health)) or "—")
    local stamina = character and character:GetAttribute("Stamina")
    if typeof(stamina) ~= "number" then
        local msClient = controller.MovementServiceClient or (controller.GetMovementClient and controller.GetMovementClient())
        if msClient and typeof(msClient._stamina) == "number" then
            stamina = msClient._stamina
        end
    end
    local maxStamina = character and character:GetAttribute("MaxStamina")
    if typeof(maxStamina) ~= "number" then maxStamina = 100 end
    local now = os.clock()
    local dt = math.clamp(now - (controller.LastStaminaTick or now), 0, 0.2)
    controller.LastStaminaTick = now
    local ms = controller.MovementServiceClient or (controller.GetMovementClient and controller.GetMovementClient())
    local isMoving = humanoid and humanoid.MoveDirection.Magnitude > 0.05
    local isSprinting = isMoving and ms and ((ms._running == true and ms._sprintInputDesired == true) or (ms._currentSpeed and ms._currentSpeed > 14))
    if controller.AutoRun then
        if ms then
            if ms.SetSprintInputDesired and ms._sprintInputDesired ~= true then
                pcall(function() ms:SetSprintInputDesired(true) end)
            end
            if isMoving and ms.StartSprint and ms._running ~= true then
                pcall(function() ms:StartSprint() end)
            end
        end
    end
    if controller.RunForever then
        if controller.VirtualStamina == nil then
            controller.VirtualStamina = (typeof(stamina) == "number" and stamina) or 100
        end
        if isSprinting then
            controller.VirtualStamina = controller.VirtualStamina - dt * 5
        else
            controller.VirtualStamina = math.min(maxStamina, controller.VirtualStamina + dt * 10)
        end
        if ms then
            ms._stamina = 100
            ms._staminaSeenPositive = true
        end
        stamina = controller.VirtualStamina
    else
        controller.VirtualStamina = nil
        if ms and typeof(stamina) == "number" and stamina > 0 then
            ms._staminaSeenPositive = true
        end
    end
    maxStamina = math.max(1, maxStamina)
    local knownStamina = typeof(stamina) == "number"
    hud.SetValue("Stamina", knownStamina and stamina / maxStamina or 0,
        knownStamina and string.format("%d%%", math.floor(stamina / maxStamina * 100 + 0.5)) or "—")
    local heavyLeft = visualState.M2Cooldown.GetLeft()
    local heavyDuration = math.max(tonumber(visualState.M2Cooldown.duration) or 0, 0)
    hud.SetValue("Heavy", heavyDuration > 0 and heavyLeft / heavyDuration or 0,
        heavyLeft > 0 and string.format("%.1f s", heavyLeft) or "READY")
    local showDodge, dodgeRatio, dodgeText = visualState.ReadDodgeCooldown(character, now)
    if showDodge then hud.EnsureDodge(); hud.SetValue("Dodge", dodgeRatio, dodgeText) end
    hud.ShowRows({
        Health = not (controller.HideHealthBarState and controller.HideHealthBarState:get() == true),
        Stamina = not (controller.HideStaminaBarState and controller.HideStaminaBarState:get() == true)
            and (isSprinting == true or (knownStamina and stamina < maxStamina - 0.5)),
        Heavy = visualState.M2Cooldown.uiEnabled:get() ~= false
            and not (controller.HideHeavyBarState and controller.HideHeavyBarState:get() == true)
            and (heavyLeft > 0),
        Dodge = showDodge,
    })
end
local function playTetrioSfx(path, vol)
    if not isCustomAssetSupported() then return end
    local assetPath = path
    if not isfile(assetPath) then
        local alt = assetPath:gsub("/", "\\")
        if isfile(alt) then
            assetPath = alt
        elseif assetPath:find("damgae") then
            local fix = assetPath:gsub("damgae", "damage")
            if isfile(fix) then assetPath = fix end
        end
    end
    if not isfile(assetPath) then
        local fileName = assetPath:match("([^/\\]+)$")
        if fileName and type(writefile) == "function" and type(game.HttpGet) == "function" then
            pcall(function()
                if type(isfolder) == "function" and not isfolder("larp") and type(makefolder) == "function" then
                    makefolder("larp")
                end
                local content = game:HttpGet("https://raw.githubusercontent.com/x8lua/scripts/main/combo/" .. fileName)
                if content and #content > 0 then
                    writefile(assetPath, content)
                end
            end)
        end
    end
    if not isfile(assetPath) then return end
    local id = safeGetCustomAsset(assetPath)
    if id then
        local sound = nil
        pcall(function()
            sound = Instance.new("Sound")
            sound.Name = "TetrioSfx"
            sound.SoundId = id
            sound.Volume = vol or 1
            sound.Parent = workspace
            sound:Play()
            sound.Ended:Connect(function() sound:Destroy() end)
            task.delay(6, function() if sound and sound.Parent then sound:Destroy() end end)
        end)
        return sound
    end
end
