controller.JinHUDSnapshot = function()
    local j=controller.JinRuntime
    if not j then return {status="Loading Jin…"} end
    j:SyncPerks()
    local now=os.clock()
    local char=LocalPlayer.Character
    local isJin=string.lower(tostring(getRawLocalFightStyle()))=="jin"
    local stance=char and char:GetAttribute("Equip")==true
    local parry=controller.Enabled and (not controller.HeavyAttackParryState or controller.HeavyAttackParryState:get())
    local counter=controller.JinStates.Counter:get()
    local reason=not counter and "OFF" or not isJin and "WAIT: actual Jin style required" or not stance and "WAIT: enter stance" or "ON · confirmed M1 parry only"
    local function perkDetail(attribute, untilTime, cooldown, attack)
        local signal=j.perkSignals and j.perkSignals[attribute]
        if signal and signal.active then
            return untilTime>now and "ACTIVE · "..attack.." · time approx."
                or "ACTIVE · "..attack.." · expiry unknown"
        end
        if untilTime>now then return "EVENT ESTIMATE · "..attack end
        local cd=j.perkSignals and j.perkSignals[attribute.."CD"]
        if cd and cd.active then return cooldown>now and string.format("Cooldown ~%.1fs",cooldown-now) or "Cooldown active" end
        if signal and signal.observed then return "Inactive · "..attack end
        return "Awaiting confirmed signal · "..attack
    end
    local hit=j.lastVictim and j.hits[j.lastVictim]
    local pressure=hit and string.format("%s · %d/3 observed hits",j.lastVictim,hit.count) or "Waiting for confirmed M1 hits"
    if hit and hit.lockUntil and hit.lockUntil>now then pressure=pressure..string.format("\nEstimated dash lock %.1fs",hit.lockUntil-now) end
    local casts=j:Warnings()
    local first=casts[1]
    local function phase(v) return v<0 and "PAUSE" or v==0 and "DONE" or string.format("%.2fs",v) end
    local lock=hit and hit.lockUntil and hit.lockUntil>now
    return {
        counterState=not counter and "OFF" or (not isJin or not stance) and "WAIT" or "ON",
        guardState=not controller.JinStates.Dual:get() and "OFF" or parry and stance and "ON" or "WAIT",
        ElectricWindSeconds=math.max(0,j.electricUntil-now),ElectricWindDuration=8,
        ElectricWindDetail=perkDetail("JinElectricWind",j.electricUntil,j.electricCooldown,"Next heavy ×1.35"),
        ZanshinSeconds=math.max(0,j.zanshinUntil-now),ZanshinDuration=6,
        ZanshinDetail=perkDetail("JinZanshin",j.zanshinUntil,j.zanshinCooldown,"Next light ×1.4"),
        hitCount=hit and hit.count or 0,pressureLocked=lock,
        pressureTarget=hit and (j.lastVictim..(lock and string.format(" · dash lock ~%.1fs",hit.lockUntil-now) or " · observed hits")) or "Awaiting confirmed hits",
        enemy=first and first.name,
        phases=first and ("01  "..phase(first.remaining[1]).."      02  "..phase(first.remaining[2])),
    }
end
