local Rere
do
	Rere = {}
	function Rere.State(initialValue)
		local state = {
			value = initialValue,
			listeners = {},
			_isState = true,
		}
		function state:get()
			return self.value
		end
		function state:set(val)
			if self.value == val then return end
			self.value = val
			for _, fn in ipairs(self.listeners) do
				pcall(fn, val)
			end
		end
		function state:onChange(fn)
			table.insert(self.listeners, fn)
			return function()
				local idx = table.find(self.listeners, fn)
				if idx then table.remove(self.listeners, idx) end
			end
		end
		return state
	end
	Rere.PushConfig = function(...) end
	Rere.PopConfig = function(...) end
