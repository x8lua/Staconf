local function clearStandParts()
    if standParts.Added then standParts.Added:Disconnect(); standParts.Added = nil end
    if standParts.Removing then standParts.Removing:Disconnect(); standParts.Removing = nil end
    standParts.Character = nil
    table.clear(standParts.Parts)
