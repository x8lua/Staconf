    if controller.MainGoonState and controller.MainGoonState:get() ~= enable then
        controller.MainGoonState:set(enable)
    end
    if controller.MainGoonConnections then
        for _, c in ipairs(controller.MainGoonConnections) do
            pcall(function() c:Disconnect() end)
        end
        table.clear(controller.MainGoonConnections)
    else
        controller.MainGoonConnections = {}
    end
    if enable then
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            if controller.MainGoonTrack then
                pcall(function() controller.MainGoonTrack:Stop(0) controller.MainGoonTrack:Destroy() end)
                controller.MainGoonTrack = nil
            end
            local minTime = 0.60
            local maxTime = 0.70
            local direction = 1
            local track = nil
            local isReloading = false
            local function reloadMainGoonAnim()
                if not controller.MainGoonActive or isReloading then return end
                isReloading = true
                local c = LocalPlayer.Character
                local h = c and c:FindFirstChildOfClass("Humanoid")
                if not h then isReloading = false return end
                local animator = h:FindFirstChildOfClass("Animator") or h
                if controller.MainGoonTrack then
                    pcall(function() controller.MainGoonTrack:Stop(0) controller.MainGoonTrack:Destroy() end)
                    controller.MainGoonTrack = nil
                end
                local anim = Instance.new("Animation")
                anim.AnimationId = "rbxassetid://698251653"
                local newTrack = animator:LoadAnimation(anim)
                if newTrack then
                    newTrack.Priority = Enum.AnimationPriority.Action4
                    newTrack.Looped = true
                    newTrack:Play()
                    newTrack.TimePosition = minTime
                    direction = 1
                    local spd = controller.MainGoonSpeedState and controller.MainGoonSpeedState:get() or 1.0
                    newTrack:AdjustSpeed(direction * spd)
                    controller.MainGoonTrack = newTrack
                    track = newTrack
                end
                isReloading = false
            end
            reloadMainGoonAnim()
            local lastHealth = hum.Health
            local healthConn = hum.HealthChanged:Connect(function(newH)
                if not controller.MainGoonActive then return end
                if newH < lastHealth then
                    lastHealth = newH
                    task.delay(0.04, function()
                        if controller.MainGoonActive then
                            if not track or not track.IsPlaying then
                                reloadMainGoonAnim()
                            end
                        end
                    end)
                else
                    lastHealth = newH
                end
