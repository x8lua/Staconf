        hideLoadingTween:Play()
        hideLoadingTween.Completed:Wait()
        local newWin = nil
        if oldWin then
            local searchStart = os.clock()
            while os.clock() - searchStart < 8 do
                local roots = parent:GetChildren()
                for _, r in ipairs(roots) do
                    if r.Name == "Iris_Root" then
                        local wb = r:FindFirstChild("WindowButton", true)
                        if wb and wb:FindFirstChild("Content") and wb.AbsoluteSize.X > 50 then
                            newWin = wb
                            break
                        end
                    end
                end
                if newWin then break end
                task.wait(0.05)
            end
        end
        local newContent = newWin and newWin:FindFirstChild("Content")
        if newContent then
            newContent.Visible = false
        end
        local targetPos = (newWin and newWin.AbsolutePosition) or startPos
        local targetSize = (newWin and newWin.AbsoluteSize) or startSize
        if oldWin and newWin then
            local tweenToNewGui = TweenService:Create(container, TweenInfo.new(0.65, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut), {
                AnchorPoint = Vector2.new(0, 0),
                Position = UDim2.fromOffset(targetPos.X, targetPos.Y),
                Size = UDim2.fromOffset(targetSize.X, targetSize.Y),
                BackgroundTransparency = 0
            })
            local tweenSplashImgBack = TweenService:Create(splashImg, TweenInfo.new(0.65, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut), {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.fromScale(0.5, 0.5),
                Size = UDim2.fromScale(0.7, 0.7)
            })
            tweenToNewGui:Play()
            tweenSplashImgBack:Play()
            tweenToNewGui.Completed:Wait()
            task.wait(1.5)
        else
            task.wait(0.5)
        end
        if newContent then
            newContent.Visible = true
        end
        local tweenFadeOutContainer = TweenService:Create(container, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            GroupTransparency = 1
        })
        tweenFadeOutContainer:Play()
        tweenFadeOutContainer.Completed:Wait()
        if spinConn then spinConn:Disconnect() end
        sg:Destroy()
        if _G.LarpkuranController and _G.LarpkuranController.LarpkuranOpenedState then
            pcall(function() _G.LarpkuranController.LarpkuranOpenedState:set(true) end)
        end
        if musicHandle then
            musicHandle:FadeOut(10.0)
        end
        _G.LarpkuranIsRestarting = false
    end)
end
