    c.isDrawingNow = false
    c.isDrawingPaused = false
    c.stopDrawingRequested = false
    function c.autoDrawSmallScanlines(thickness, delayMs)
        if c.isDrawingNow then return end
        c.isDrawingNow = true
        c.isDrawingPaused = false
        c.stopDrawingRequested = false
        task.spawn(function()
            local hasChalk = c.hasChalkCached
            if not hasChalk then
                c.statusState:set("Declined: Chalk not equipped! Click '🎒 Grab Chalk'")
                c.isDrawingNow = false
                return
            end
            local dist = c.currentBoardDist
            local isClose = c.isBoardClose
            if not isClose then
                c.statusState:set(string.format("Declined: Too far from blackboard (%.1f / 16.0 studs). Move closer!", dist))
                c.isDrawingNow = false
                return
            end
            local secKey = c.secretKeyState:get():gsub("^%s*(.-)%s*$", "%1")
            if c.rateLimitUntil > os.clock() and #secKey == 0 then
                local waitSec = math.ceil(c.rateLimitUntil - os.clock())
                c.statusState:set(string.format("⏳ Rate limited on drawing! Wait %ds (or enter Secret Key)", waitSec))
                c.isDrawingNow = false
                return
            end
            if not c.currentLoadedImage then
                c.generateImageFromVPS()
                local waitCount = 0
                while not c.currentLoadedImage and waitCount < 10 do
                    task.wait(0.1)
                    waitCount = waitCount + 1
                end
            end
            if not c.currentLoadedImage then
                c.statusState:set("Error: Image not loaded yet")
                c.isDrawingNow = false
                return
            end
            local board = c.getTargetBoard()
            if not board or not board.editableImage then
                c.statusState:set("Error: No blackboard nearby")
                c.isDrawingNow = false
                return warn("[Chalk] 身邊沒有找到黑板！")
            end
            local imgW, imgH = c.currentLoadedImage.Size.X, c.currentLoadedImage.Size.Y
            local buf = c.currentLoadedImage:ReadPixelsBuffer(Vector2.zero, Vector2.new(imgW, imgH))
            local boardId = board.boardId
            local boardEi = board.editableImage
            local authorGridObj = c.getAuthorGrid(boardId)
            local uid = game.Players.LocalPlayer.UserId
            local boardMarginX = c.selectionBox.Position.X.Scale
            local boardMarginY = c.selectionBox.Position.Y.Scale
            local boardScaleW = c.selectionBox.Size.X.Scale
            local boardScaleH = c.selectionBox.Size.Y.Scale
            local targetX1 = math.clamp(math.round(boardMarginX * 512), 0, 511)
            local targetY1 = math.clamp(math.round(boardMarginY * 384), 0, 383)
            local targetW = math.clamp(math.round(boardScaleW * 512), 1, 512 - targetX1)
            local targetH = math.clamp(math.round(boardScaleH * 384), 1, 384 - targetY1)
            local brushSize = math.clamp(math.round(thickness), 1, 8)
            local step = math.max(1, brushSize)
            local spans = {}
            for py = targetY1, targetY1 + targetH - 1, step do
                local imgY = math.clamp(math.floor(((py - targetY1) / targetH) * imgH), 0, imgH - 1)
                local inRun = false
                local runStartPx = 0
                for px = targetX1, targetX1 + targetW - 1, step do
                    local imgX = math.clamp(math.floor(((px - targetX1) / targetW) * imgW), 0, imgW - 1)
                    local offset = (imgY * imgW + imgX) * 4
                    local a = buffer.readu8(buf, offset + 3)
                    if a > 40 then
                        if not inRun then
                            inRun = true
                            runStartPx = px
                        end
                    else
                        if inRun then
                            table.insert(spans, {
                                y = py,
                                x1 = runStartPx,
                                x2 = px - 1
                            })
                            inRun = false
                        end
                    end
                end
                if inRun then
                    table.insert(spans, {
                        y = py,
                        x1 = runStartPx,
                        x2 = targetX1 + targetW - 1
                    })
                end
            end
            local totalLines = #spans
            if totalLines == 0 then
                c.statusState:set("No chalk lines to draw (Blank Image)")
                c.isDrawingNow = false
                return
            end
            c.boxImage.Visible = false
            c.statusState:set(string.format("Drawing %d lines (Thickness: %d)...", totalLines, brushSize))
            c.sendLogEvent("started", totalLines)
            local baseDelay = (delayMs or 95) / 1000
            local startTime = os.clock()
            local lastTimeUpdate = 0
            local relRemote = game.ReplicatedStorage:FindFirstChild("BLINK_RELIABLE_REMOTE")
            for idx, span in ipairs(spans) do
                if c.stopDrawingRequested or _G.LarpkuranRageGeneration ~= larpkuranRageGeneration then
                    c.statusState:set(string.format("Drawing stopped (%d / %d lines completed)", idx - 1, totalLines))
                    c.isDrawingNow = false
                    c.isDrawingPaused = false
                    c.sendLogEvent("stopped", idx - 1)
                    return
                end
                while _G.LarpkuranRageGeneration == larpkuranRageGeneration and (c.isDrawingPaused or not c.isBoardClose or not c.hasChalkCached) do
                    if c.stopDrawingRequested then
                        c.statusState:set(string.format("Drawing stopped (%d / %d lines completed)", idx - 1, totalLines))
                        c.isDrawingNow = false
                        c.isDrawingPaused = false
                        c.sendLogEvent("stopped", idx - 1)
                        return
                    end
                    if not c.isBoardClose then
                        c.statusState:set(string.format("⏸ Paused: Too far from blackboard (%.1f / 16.0 studs). Step closer to resume!", c.currentBoardDist))
                        c.timeLeftState:set("Paused (Out of Range)")
                    elseif not c.hasChalkCached then
                        c.statusState:set("⏸ Paused: Chalk unequipped! Equip chalk to resume...")
                        c.timeLeftState:set("Paused (No Chalk)")
                    elseif c.isDrawingPaused then
                        c.statusState:set(string.format("⏸ Paused by user (%d / %d lines). Click '▶ Resume Drawing' to continue.", idx - 1, totalLines))
                        c.timeLeftState:set("Paused")
                    end
                    task.wait(0.15)
                end
                local p1 = Vector2.new(span.x1, span.y)
                local p2 = Vector2.new(span.x2, span.y)
                if boardEi then
                    pcall(function()
                        boardEi:DrawLine(p1, p2, Color3.fromRGB(240, 240, 240), 0, Enum.ImageCombineType.Overwrite)
                        if brushSize > 1 then
                            for off = 1, math.floor(brushSize / 2) do
                                boardEi:DrawLine(p1 + Vector2.new(0, off), p2 + Vector2.new(0, off), Color3.fromRGB(240, 240, 240), 0, Enum.ImageCombineType.Overwrite)
                                boardEi:DrawLine(p1 - Vector2.new(0, off), p2 - Vector2.new(0, off), Color3.fromRGB(240, 240, 240), 0, Enum.ImageCombineType.Overwrite)
                            end
                        end
                    end)
                end
                if authorGridObj and authorGridObj.authorGrid then
                    for gx = math.floor(span.x1 / 16), math.floor(span.x2 / 16) do
                        local gy = math.floor(span.y / 16)
                        local gidx = gy * 32 + gx + 1
                        if not authorGridObj.authorGrid[gidx] then
                            authorGridObj.authorGrid[gidx] = uid
                            authorGridObj.authorCount = (authorGridObj.authorCount or 0) + 1
                        end
                    end
                end
                local u1 = span.x1 / 512
                local v1 = span.y / 384
                local u2 = span.x2 / 512
                local v2 = span.y / 384
                local netBuf = buffer.create(24)
                buffer.writeu32(netBuf, 0, boardId)
                buffer.writeu8(netBuf, 4, brushSize)
                buffer.writeu8(netBuf, 5, 240)
                buffer.writeu8(netBuf, 6, 240)
                buffer.writeu8(netBuf, 7, 240)
                buffer.writef32(netBuf, 8, u1)
                buffer.writef32(netBuf, 12, v1)
                buffer.writef32(netBuf, 16, u2)
                buffer.writef32(netBuf, 20, v2)
                local fired = false
                pcall(function()
                    if c.Client and c.Client.WhiteboardDrawBatch and c.Client.WhiteboardDrawBatch.Fire then
                        c.Client.WhiteboardDrawBatch.Fire(netBuf)
                        fired = true
                    end
                end)
                if not fired and relRemote then
                    pcall(function()
                        local fullBuf = buffer.create(25)
                        buffer.writeu8(fullBuf, 0, 105)
                        buffer.copy(fullBuf, 1, netBuf, 0, 24)
                        relRemote:FireServer(fullBuf, {})
                    end)
                end
                local pct = math.clamp(idx / totalLines, 0, 1)
                c.progressCountState:set(string.format("%d / %d lines (%.1f%%)", idx, totalLines, pct * 100))
                local totalBlocks = 20
                local filledBlocks = math.floor(pct * totalBlocks)
                local barStr = "[" .. string.rep("█", filledBlocks) .. string.rep("░", totalBlocks - filledBlocks) .. string.format("] %d%%", math.floor(pct * 100))
                c.progressBarState:set(barStr)
                local now = os.clock()
                if now - lastTimeUpdate >= 0.25 or idx == totalLines then
                    lastTimeUpdate = now
                    local elapsed = now - startTime
                    local rate = idx / math.max(elapsed, 0.001)
                    local remainingSec = (totalLines - idx) / math.max(rate, 0.001)
                    if remainingSec > 60 then
                        c.timeLeftState:set(string.format("Est. Time Left: %dm %02ds (%.1f lines/s)", math.floor(remainingSec / 60), math.floor(remainingSec % 60), rate))
                    else
                        c.timeLeftState:set(string.format("Est. Time Left: %.1fs (%.1f lines/s)", remainingSec, rate))
                    end
                end
                task.wait(baseDelay)
            end
            c.boxImage.Visible = true
            c.statusState:set(string.format("Drawing Completed! (%d lines in %.1fs)", totalLines, os.clock() - startTime))
            c.isDrawingNow = false
            c.isDrawingPaused = false
            c.sendLogEvent("completed", totalLines)
        end)
    end
    c.topDrawBtn.MouseButton1Click:Connect(function()
