local function safeTeleportTo(targetCFrame, dynamicRoot, offset)
    local altChar = localPlayer.Character
    local altHRP = altChar and rootOf(altChar)
    if not altHRP then return end
    local function getTargetCF()
        if dynamicRoot and dynamicRoot.Parent then
            return dynamicRoot.CFrame * (offset or CFrame.identity)
        end
        return targetCFrame
    end
    local currentPos = altHRP.Position
    local goalCF = getTargetCF()
    local totalDist = (goalCF.Position - currentPos).Magnitude
    if totalDist <= 25 then
        altHRP.CFrame = goalCF
        altHRP.AssemblyLinearVelocity = Vector3.zero
        altHRP.AssemblyAngularVelocity = Vector3.zero
        return
    end
    local stepDist = 20
    local steps = math.clamp(math.ceil(totalDist / stepDist), 2, 50)
    for i = 1, steps do
        if not isRunning or not altHRP or not altHRP.Parent then break end
        goalCF = getTargetCF()
        local t = i / steps
        local intermediatePos = currentPos:Lerp(goalCF.Position, t)
        altHRP.CFrame = CFrame.new(intermediatePos, goalCF.Position)
        altHRP.AssemblyLinearVelocity = Vector3.zero
        altHRP.AssemblyAngularVelocity = Vector3.zero
        RunService.Heartbeat:Wait()
    end
    if altHRP and altHRP.Parent then
        goalCF = getTargetCF()
        altHRP.CFrame = goalCF
        altHRP.AssemblyLinearVelocity = Vector3.zero
        altHRP.AssemblyAngularVelocity = Vector3.zero
    end
end
