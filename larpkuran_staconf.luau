function autoRoll.ShouldSkip(statKey, val)
    if autoRoll.IsLegendaryOrBetter(statKey, val) then
        if autoRoll.ShouldSkipItem(statKey, val) then
            return true, "Item"
        end
        return false, nil
    end
    if autoRoll.ShouldSkipRarity(statKey, val) then
        return true, "Rarity"
    end
    if autoRoll.ShouldSkipItem(statKey, val) then
        return true, "Item"
    end
    return false, nil
end
function autoRoll.Stop()
    autoRoll.Running = false
    autoRoll.ConfirmStep = 0
    autoRoll.SlowModeTimerState:set(0)
    autoRoll.SlowModeDecision = nil
    autoRoll.StatusState:set("Stopped")
end
function autoRoll.Start()
    if autoRoll.Running then return end
    autoRoll.ConfirmStep = 0
    autoRoll.Running = true
    autoRoll.RollCount = 0
    autoRoll.RollCountState:set(0)
    autoRoll.StatusState:set("Running...")
    task.spawn(function()
        local RerollCurrencyServiceClient = nil
        pcall(function()
            RerollCurrencyServiceClient = require(ReplicatedStorage.Shared.Services.RerollService.RerollCurrencyServiceClient)
        end)
        local RerollSpinRemote = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("RerollSpin")
        local RerollUndoRemote = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("RerollUndo")
        local function doSpin(statKey)
            if RerollCurrencyServiceClient and RerollCurrencyServiceClient.RequestReroll then
                return RerollCurrencyServiceClient:RequestReroll(statKey)
            elseif RerollSpinRemote then
                local ok, r1, r2 = pcall(function() return RerollSpinRemote:InvokeServer(statKey) end)
                if ok then return r1, r2 end
            end
            return false, {Reason = "RemoteNotFound"}
        end
        local function doUndo(statKey)
            if RerollCurrencyServiceClient and RerollCurrencyServiceClient.RequestRerollUndo then
                return RerollCurrencyServiceClient:RequestRerollUndo(statKey)
            elseif RerollUndoRemote then
                pcall(function() RerollUndoRemote:InvokeServer(statKey) end)
            end
        end
        while autoRoll.Running do
            local statKey = autoRoll.CurrentStatState:get()
            local desired = tostring(autoRoll.DesiredValueState:get() or ""):lower()
            desired = desired:match("^%s*(.-)%s*$")
            if statKey == "HairColor" and desired ~= "" then
                local isValid, statusMsg = autoRoll.ValidateHairColorTarget(desired)
                if not isValid then
                    autoRoll.Running = false
                    autoRoll.StatusState:set("Cancelled: Unknown target '" .. desired .. "'")
                    break
                end
            end
            local curVal = autoRoll.GetCurrentValue(statKey)
            local curDisplay = autoRoll.FormatValueWithRarity(statKey, curVal)
            local isCurMatch = autoRoll.MatchesDesired(statKey, curVal, desired)
            if isCurMatch then
                autoRoll.Running = false
                autoRoll.StatusState:set("Found target: " .. curDisplay)
                break
            end
            local ok, res = doSpin(statKey)
            if not ok then
                local reason = (typeof(res) == "table" and res.Reason) or "Spin failed"
                local reasonStr = tostring(reason)
                if reasonStr:lower():find("cooldown") then
                    autoRoll.StatusState:set("ERROR: cooldown")
                    task.wait(1)
                else
                    autoRoll.Running = false
                    autoRoll.StatusState:set("Error: " .. reasonStr)
                    break
                end
            end
            if typeof(res) == "table" then
                if res.Mode == "NeedsPurchase" then
                    autoRoll.Running = false
                    autoRoll.StatusState:set("Out of rerolls!")
                    break
                end
                if res.Mode == "Spent" then
                    autoRoll.RollCount = autoRoll.RollCount + 1
                    autoRoll.RollCountState:set(autoRoll.RollCount)
                    local newVal = autoRoll.GetCurrentValue(statKey)
                    local deadline = os.clock() + 1.2
                    while os.clock() < deadline and (newVal == nil or newVal == curVal) do
                        task.wait(0.05)
                        newVal = autoRoll.GetCurrentValue(statKey)
                    end
                    if newVal == nil then
                        newVal = autoRoll.GetCurrentValue(statKey)
                    end
                    local newDisplay = autoRoll.FormatValueWithRarity(statKey, newVal)
                    autoRoll.LastRolledState:set(newDisplay)
                    autoRoll.StatusState:set("Rolled: " .. newDisplay)
                    local isLegendaryOrAbove = autoRoll.IsLegendaryOrBetter(statKey, newVal)
                    local isNewMatch = autoRoll.MatchesDesired(statKey, newVal, desired)
                    if isNewMatch then
                        autoRoll.Running = false
                        autoRoll.StatusState:set("SUCCESS: " .. newDisplay)
                        break
                    end
                    if isLegendaryOrAbove and autoRoll.StopOnLegendaryState:get() == true then
                        autoRoll.Running = false
                        autoRoll.StatusState:set("Stopped on Legendary+: " .. newDisplay)
                        break
                    end
                    local shouldSkip, skipReason = autoRoll.ShouldSkip(statKey, newVal)
                    if shouldSkip then
                        autoRoll.StatusState:set("Auto-skipping (" .. skipReason .. "): " .. newDisplay)
                        if res.CanUndo == 1 and autoRoll.AutoUndoState:get() == true then
                            task.wait(0.1)
                            doUndo(statKey)
                            autoRoll.StatusState:set("Undid (" .. skipReason .. " skip): " .. newDisplay)
                        end
                    else
                        if autoRoll.SlowModeState:get() == true then
                            autoRoll.SlowModeDecision = nil
                            autoRoll.SlowModeCanUndoState:set(res.CanUndo == 1)
                            local duration = math.clamp(tonumber(autoRoll.SlowModeDurationState:get()) or 7, 1, 60)
                            local expireTime = os.clock() + duration
                            while os.clock() < expireTime and autoRoll.Running and not autoRoll.SlowModeDecision do
                                local remaining = math.max(0, math.ceil(expireTime - os.clock()))
                                autoRoll.SlowModeTimerState:set(remaining)
                                task.wait(0.05)
                            end
                            autoRoll.SlowModeTimerState:set(0)
                            if not autoRoll.Running or autoRoll.SlowModeDecision == "keep" then
                                autoRoll.Running = false
                                autoRoll.StatusState:set("Kept: " .. newDisplay)
                                break
                            end
                            if autoRoll.SlowModeDecision == "undo" then
                                if res.CanUndo == 1 then
                                    task.wait(0.1)
                                    doUndo(statKey)
                                    autoRoll.StatusState:set("Undid roll: " .. newDisplay)
                                    task.wait(0.3)
                                end
                            end
                            autoRoll.SlowModeDecision = nil
                        else
                            if res.CanUndo == 1 and autoRoll.AutoUndoState:get() == true and desired ~= "" and not isNewMatch and not isLegendaryOrAbove then
                                task.wait(0.1)
                                doUndo(statKey)
                                autoRoll.StatusState:set("Undid roll: " .. newDisplay)
                            end
                        end
                    end
                end
            end
            local delaySec = math.clamp(tonumber(autoRoll.RollDelayState:get()) or 1.0, 0.5, 5)
            task.wait(delaySec)
        end
    end)
end
end)()
