    for _, player in ipairs(Players:GetPlayers()) do
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if player ~= LocalPlayer and typeof(humanoid) == "Instance" and humanoid:IsA("Humanoid") and humanoid.Health > 0 and rootOf(character) then
            if not (controller.PeerUserIds and controller.PeerUserIds[player.UserId]) and not controller.DetectedAlts[player.Name:lower()] then
                table.insert(candidates, player)
            end
        end
    end
    if #candidates == 0 then return nil end
    if normalizedQuery == "" or normalizedQuery == "random" then
        return candidates[math.random(1, #candidates)]
    end
    local bestPlayer, bestScore
    for _, player in ipairs(candidates) do
        local score = rageTargetScore(player, normalizedQuery)
        if score > 0 and (not bestScore or score > bestScore) then
            bestPlayer, bestScore = player, score
        end
    end
