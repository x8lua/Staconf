    track.Stopped:Once(function()
        controller.FakeStyleGuard[track] = nil
        if movementRole then
            local weight = controller.FakeStyleHiddenTracks[track]
            if weight and track.IsPlaying then
                pcall(function() track:AdjustWeight(weight, 0.05) end)
            end
        end
        controller.FakeStyleHiddenTracks[track] = nil
    end)
    controller.FakeStyleCurrentAttackTrack = replacementTrack
    controller.FakeStyleActiveTracks[replacementTrack] = animation
    controller.FakeStyleReplacementOrigins[track] = replacementTrack
    controller.FakeStyleReplacementRoles[replacementTrack] = movementRole
    if movementRole then
