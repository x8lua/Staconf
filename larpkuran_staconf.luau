local function isCharacterPart(part)
    local parent = part.Parent
    while parent and parent ~= workspace do
        if parent:FindFirstChildOfClass("Humanoid") then
            return true
        end
        parent = parent.Parent
    end
    return false
end
local function neutralizeVoidPart(p)
    if not p or not p.Parent or not p:IsA("BasePart") then return false end
    if p.Name == "LarpkuranStandSkySanctum" then return false end
    local visuals = workspace:FindFirstChild("Larpkuran3DVisuals")
    if visuals and p:IsDescendantOf(visuals) then return false end
    local n = p.Name:lower()
    local matched = false
    for _, kw in ipairs(voidKeywords) do
        if n:find(kw) then
            matched = true
            break
        end
    end
    if not matched and p.Position.Y < -320 and (p.CanTouch or p:FindFirstChildOfClass("TouchTransmitter") or not p.CanCollide) then
        matched = true
    end
    if matched and not isCharacterPart(p) then
        pcall(function()
            p.CanTouch = false
            p.CanCollide = false
            for _, desc in ipairs(p:GetChildren()) do
                if desc:IsA("TouchTransmitter") then
                    desc:Destroy()
                end
            end
            p:Destroy()
        end)
        controller.VoidPartsDestroyed = (controller.VoidPartsDestroyed or 0) + 1
        return true
    end
    return false
end
local function sweepVoidParts()
    pcall(function()
        workspace.FallenPartsDestroyHeight = -50000
    end)
    for index, p in ipairs(workspace:GetDescendants()) do
        if controller.Stopped then return end
        if p:IsA("BasePart") then neutralizeVoidPart(p) end
        if index % 400 == 0 then task.wait() end
    end
end
