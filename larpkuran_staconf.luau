local function isFacingTarget(enemyCharacter)
    local localChar = LocalPlayer.Character
    local localRoot = rootOf(localChar)
    local enemyRoot = rootOf(enemyCharacter)
    if not localRoot or not enemyRoot then return false end
    local localPos = localRoot.Position
    local enemyPos = enemyRoot.Position
    local toEnemyH = Vector3.new(enemyPos.X - localPos.X, 0, enemyPos.Z - localPos.Z)
    local toUsH = Vector3.new(localPos.X - enemyPos.X, 0, localPos.Z - enemyPos.Z)
    if toEnemyH.Magnitude < 0.05 or toUsH.Magnitude < 0.05 then return true end
    local myLookH = Vector3.new(localRoot.CFrame.LookVector.X, 0, localRoot.CFrame.LookVector.Z)
    local isWeFacing = false
    if myLookH.Magnitude > 0.05 and myLookH.Unit:Dot(toEnemyH.Unit) > 0.15 then
        isWeFacing = true
    else
        local cam = Workspace.CurrentCamera
        if cam then
            local camLookH = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
            if camLookH.Magnitude > 0.05 and camLookH.Unit:Dot(toEnemyH.Unit) > 0.15 then
                isWeFacing = true
            end
        end
    end
    if not isWeFacing then return false end
    local enemyAngVel = enemyRoot.AssemblyAngularVelocity or enemyRoot.RotVelocity or Vector3.zero
    local isSpinning = math.abs(enemyAngVel.Y) > 2.5
    if not isSpinning then
        local enemyLookH = Vector3.new(enemyRoot.CFrame.LookVector.X, 0, enemyRoot.CFrame.LookVector.Z)
        if enemyLookH.Magnitude > 0.05 then
            local enemyDot = enemyLookH.Unit:Dot(toUsH.Unit)
            if toUsH.Magnitude > 2 and enemyDot < 0.15 then
                return false
            elseif toUsH.Magnitude <= 2 and enemyDot < -0.2 then
                return false
            end
        end
    end
    return true
end
