local function rageTweenForAttack(localRoot, targetRoot, dodgeNow, token, underground)
    if not targetRoot or targetRoot.Position.Y < -350 then return false end
    local aimPosition = ragePredictedPosition(targetRoot)
    if aimPosition.Y < -350 then return false end
    if underground then
        local depth = math.clamp(tonumber(rageConfig.UndergroundDepth) or 6, 4, 10)
        local targetY = aimPosition.Y - depth
        if not rageConfig.SmoothedUndergroundY or math.abs(rageConfig.SmoothedUndergroundY - targetY) > 12 then
            rageConfig.SmoothedUndergroundY = targetY
        else
            rageConfig.SmoothedUndergroundY = rageConfig.SmoothedUndergroundY + (targetY - rageConfig.SmoothedUndergroundY) * 0.35
        end
        local undergroundPosition = Vector3.new(aimPosition.X, rageConfig.SmoothedUndergroundY, aimPosition.Z)
        local lookDirection = aimPosition - undergroundPosition
        local undergroundGoal
        if lookDirection.Magnitude > 0.05 then
            undergroundGoal = CFrame.lookAt(undergroundPosition, aimPosition, Vector3.new(0, 0, -1))
        else
            undergroundGoal = CFrame.new(undergroundPosition)
        end
        return ragePlayTween(localRoot, undergroundGoal, rageConfig.TweenTime, token)
    end
    local offset = aimPosition - localRoot.Position
    local horizontal = Vector3.new(offset.X, 0, offset.Z)
    if horizontal.Magnitude < 0.05 then
        local look = localRoot.CFrame.LookVector
        horizontal = Vector3.new(look.X, 0, look.Z)
    end
    if horizontal.Magnitude < 0.05 then return false end
    local direction = horizontal.Unit
    local spacing = math.clamp(tonumber(rageConfig.Range) or 4, 2, 5)
    local side = Vector3.new(-direction.Z, 0, direction.X)
    if rageConfig.StrafeEnabled and rageConfig.StrafeRadius > 0 then
        rageConfig.StrafePhase += rageConfig.StrafeStep
    else
        rageConfig.StrafePhase = 0
    end
    local strafeOffset = side * math.sin(rageConfig.StrafePhase) * rageConfig.StrafeRadius
    local position = aimPosition - direction * spacing + strafeOffset
    local safePosY = aimPosition.Y - (underground and 6 or 0)
    position = Vector3.new(position.X, safePosY, position.Z)
    local goal = CFrame.lookAt(position, aimPosition)
    if dodgeNow and rageConfig.UseDodge then
        rageConfig.DodgePhase += 1
        local dodgeSign = rageConfig.DodgePhase % 2 == 0 and 1 or -1
        local dodgePosition = aimPosition - direction * (spacing + rageConfig.DodgeBackstep)
            + side * dodgeSign * rageConfig.DodgeRadius
        local safeDodgeY = aimPosition.Y - (underground and math.clamp(tonumber(rageConfig.UndergroundDepth) or 6, 4, 10) or 0)
        dodgePosition = Vector3.new(dodgePosition.X, safeDodgeY, dodgePosition.Z)
        local dodgeGoal = CFrame.lookAt(dodgePosition, aimPosition)
        if not ragePlayTween(localRoot, dodgeGoal, math.min(rageConfig.DodgeTime, rageConfig.TweenTime * 0.75), token) then
            return false
