        local delta = root.Position - dash.position
        dash.travelled += Vector3.new(delta.X, 0, delta.Z).Magnitude
        dash.position = root.Position
        local velocity = root:FindFirstChild("EvasiveDashLinearVelocity")
        if velocity and velocity ~= dash.previous and velocity:IsA("LinearVelocity") then dash.velocity = velocity end
        local remaining = dash.distance - dash.travelled
        if remaining <= 0.01 or dash.elapsed >= 0.2 then controller.StopAutoDodge(); return end
        if dash.velocity and dash.velocity.Parent then
            local speed = math.min(dash.distance / 0.2, remaining / dt)
            dash.velocity.VectorVelocity = direction * speed
            local current = root.AssemblyLinearVelocity
            root.AssemblyLinearVelocity = Vector3.new(direction.X * speed, current.Y, direction.Z * speed)
        end
