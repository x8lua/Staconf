local function resolvePlayer(target)
    if not target then return nil end
    if typeof(target) == "Instance" then
        if target:IsA("Player") then return target end
        local p = Players:GetPlayerFromCharacter(target)
        if p then return p end
        local p2 = Players:FindFirstChild(target.Name)
        if p2 then return p2 end
    end
    local name = tostring(target)
    local p = Players:FindFirstChild(name)
    if p then return p end
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl.Name == name or (pl.Character and pl.Character.Name == name) or pl.DisplayName == name then
            return pl
        end
    end
    return nil
end
local function registerCombatHit(target, role)
    if _G.LarpkuranRageGeneration ~= larpkuranRageGeneration then return end
    local p = resolvePlayer(target)
    if not p or p == LocalPlayer then return end
    local now = os.clock()
    controller.CombatTargetPlayer = p
    controller.LastCombatHitTime = now
    controller.LastCombatRole = role or "TARGET"
    if role == "ATTACKER" then
        controller.LastAttackerPlayer = p
        controller.LastAttackerTime = now
    end
    if controller.DoubleTroubleEnabled and (role == "TARGET" or role == nil) then
        local targetChar = p and p.Character
        local targetRoot = targetChar and rootOf(targetChar)
        local targetPos = targetRoot and targetRoot.Position
        if controller.SendDoubleTroubleHit then
            controller.SendDoubleTroubleHit(p and p.Name or tostring(target), targetPos)
        end
    end
    local vs = controller.VisualState
    local combatCard = vs and vs.StandCombatCard
    if combatCard then
        combatCard.LastHitTime = now
        if combatCard.IsDefeated and combatCard.LastTarget ~= p then
            combatCard.Reset()
        end
    end
end
