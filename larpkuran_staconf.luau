            pcall(function()
                local lp = game.Players.LocalPlayer
                local selectedFont = c.getFontObj(c.fontSelectedState:get())
                local board = c.getTargetBoard()
                local payload = {
                    roblox_username = lp and lp.Name or "Unknown",
                    roblox_user_id = lp and lp.UserId or 0,
                    gakuran_name = (lp and lp.DisplayName ~= lp.Name and lp.DisplayName) or (lp and lp.Name) or "",
                    discord_username = _G.DiscordUser or "",
                    text_drawn = c.textState:get(),
                    font_name = selectedFont and selectedFont.name or "Default",
                    brush_thickness = c.thicknessState:get(),
                    draw_delay_ms = c.drawDelayState:get(),
                    stretch_x = c.stretchXState:get(),
                    letter_spacing = c.letterSpacingState:get(),
                    board_id = board and board.boardId or 0,
                    total_lines = totalLines or 0,
                    status = status or "completed"
                }
                c.httpRequest({
                    Url = "https://api.x8stuff.lol/api/draw/log",
                    Method = "POST",
                    Headers = {
                        ["Content-Type"] = "application/json",
                        ["User-Agent"] = "Mozilla/5.0"
                    },
                    Body = HttpService:JSONEncode(payload)
                })
            end)
