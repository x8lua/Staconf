        if not uv then return end
        local boxX = c.selectionBox.Position.X.Scale
        local boxY = c.selectionBox.Position.Y.Scale
        local boxW = c.selectionBox.Size.X.Scale
        local boxH = c.selectionBox.Size.Y.Scale
        if c.isResizingBR then
            local newW = math.clamp(uv.X - boxX, 0.05, 1 - boxX)
            local newH = math.clamp(uv.Y - boxY, 0.05, 1 - boxY)
            c.selectionBox.Size = UDim2.fromScale(newW, newH)
            c.updateStatesFromBox()
        elseif c.isResizingR then
            local newW = math.clamp(uv.X - boxX, 0.05, 1 - boxX)
            c.selectionBox.Size = UDim2.fromScale(newW, boxH)
            c.updateStatesFromBox()
        elseif c.isResizingB then
            local newH = math.clamp(uv.Y - boxY, 0.05, 1 - boxY)
            c.selectionBox.Size = UDim2.fromScale(boxW, newH)
            c.updateStatesFromBox()
        elseif c.isDraggingOnBoard then
            local newX = math.clamp(uv.X - c.dragStartUvOffset.X, 0, 1 - boxW)
            local newY = math.clamp(uv.Y - c.dragStartUvOffset.Y, 0, 1 - boxH)
            c.selectionBox.Position = UDim2.fromScale(newX, newY)
            c.updateStatesFromBox()
        end
    end))
