	if os.clock() % 0.25 < 0.03 then
		for _, fn in ipairs(statusUpdaters) do
			pcall(fn)
		end
	end
end)
onUnload(function() heartbeatConn:Disconnect() end)
if controller.LarpkuranOpenedState then
	controller.LarpkuranOpenedState:onChange(function(isOpen)
		window.Minimized = not isOpen
	end)
end
userInputService.InputEnded:Connect(function(input, processed)
	local kb = controller.Keybinds and controller.Keybinds.HideUI or "RightControl"
	local okKey, code = pcall(function() return Enum.KeyCode[kb] end)
	if okKey and code and input.KeyCode == code and not processed then
		window.Minimized = not window.Minimized
		if controller.LarpkuranOpenedState then
			controller.LarpkuranOpenedState:set(not window.Minimized)
		end
	end
end)
_G.LarpkuranStaconfWindow = window
_G.LarpkuranController = controller
end
initStaconfUI()
end
do
    local env = type(getgenv) == "function" and getgenv() or _G
    local requested = env.LarpRole == "Stand" or _G.LarpRole == "Stand"
    local candidate = env.MainUsername or _G.MainUsername or _G.StandMainUsername
    env.LarpRole, env.MainUsername, env.StandMainUsername = "Main", nil, nil
    _G.LarpRole, _G.MainUsername, _G.StandMainUsername = "Main", nil, nil
    if _G.StandOwnerWatchConn then
        pcall(function() _G.StandOwnerWatchConn:Disconnect() end)
        _G.StandOwnerWatchConn = nil
    end
    destroyOldStand()
    if requested then
        task.spawn(function() runStandMode(candidate) end)
    else
        task.spawn(runMainMode)
    end
end
