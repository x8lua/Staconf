        else
            replacementTrack = animator:LoadAnimation(animation)
        end
        replacementTrack.Priority = Enum.AnimationPriority.Action4
        replacementTrack.Looped = false
        replacementTrack:Play(0, 1, math.max(math.abs(track.Speed or 1), 0.05))
        controller.FakeStyleHiddenTracks[track] = track.WeightCurrent or 1
