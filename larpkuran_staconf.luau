local function addToggle(sec, title, sub, stateObj, onChange, info)
	local row = titledRow(sec, title, sub, info)
	local cur = false
	if stateObj then
		if stateObj.get then
			cur = stateObj:get() == true
		elseif typeof(stateObj) == "boolean" then
			cur = stateObj
		end
	end
	local t = row:Right():Toggle({
		Value = cur,
		ValueChanged = function(self, val)
			if stateObj and stateObj.set then stateObj:set(val) end
			if onChange then pcall(onChange, val) end
		end,
	})
	if stateObj and stateObj.onChange then
		stateObj:onChange(function(val)
			pcall(function() t.Value = (val == true) end)
		end)
	end
	return t
end
