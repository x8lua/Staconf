local function matchesTarget(value, query)
    value = string.lower(tostring(value or ""))
    return value == query or string.sub(value, 1, #query) == query or string.find(value, query, 1, true) ~= nil
end
local function findFlingTarget(input)
    local query = string.lower(tostring(input or "")):gsub("%s+", "")
    local candidates = {}
    for _, player in ipairs(Players:GetPlayers()) do
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if player ~= LocalPlayer and typeof(humanoid) == "Instance" and humanoid:IsA("Humanoid") and humanoid.Health > 0 and rootOf(character) then
            if not (controller.PeerUserIds and controller.PeerUserIds[player.UserId]) then
                table.insert(candidates, player)
            end
        end
    end
    if #candidates == 0 then return nil end
    if query == "" or query == "random" then return candidates[math.random(1, #candidates)] end
    for _, player in ipairs(candidates) do if matchesTarget(gakuranNameOf(player):gsub("%s+", ""), query) then return player end end
    for _, player in ipairs(candidates) do if matchesTarget(player.Name, query) then return player end end
    for _, player in ipairs(candidates) do if matchesTarget(player.DisplayName, query) then return player end end
    return nil
end
