        notifiedMods[p.UserId] = true
        task.spawn(function()
            local c = p.Character
            if not c then
                pcall(function() c = p.CharacterAdded:Wait() end)
            end
            if c and not c:FindFirstChild("PlayerInfoBillboard") then
                pcall(function() c:WaitForChild("PlayerInfoBillboard", 2) end)
            end
            pcall(showModal, p, roleTitle)
        end)
    end
    controller.CheckAllMods = function()
        if not config.AntiMod then return end
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and not notifiedMods[p.UserId] then
                local role = getModRole(p)
                if role then
                    handleModJoined(p)
                end
            end
        end
    end
    if _G.LarpkuranAntiModConn then
        pcall(function() _G.LarpkuranAntiModConn:Disconnect() end)
        _G.LarpkuranAntiModConn = nil
    end
    if not larpStartup.nexomia and type(getconnections) == "function" then
        pcall(function()
            for _, c in ipairs(getconnections(Players.PlayerAdded)) do
                if type(c.Function) == "function" then
                    local info = debug.getinfo(c.Function)
                    if info and info.source and string.find(info.source, "larpkuran") then
                        if info.linedefined >= 27150 and info.linedefined <= 27300 then
                            if type(c.Disconnect) == "function" then
                                pcall(c.Disconnect, c)
                            elseif type(c.Disable) == "function" then
                                pcall(c.Disable, c)
                            end
                        end
                    end
                end
            end
        end)
    end
    local antiModConn = Players.PlayerAdded:Connect(function(p)
        handleModJoined(p)
    end)
    _G.LarpkuranAntiModConn = antiModConn
    if controller.Connections then
        table.insert(controller.Connections, antiModConn)
    end
    if config.AntiMod then
        task.spawn(controller.CheckAllMods)
    end
end
