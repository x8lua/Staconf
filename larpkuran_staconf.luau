        local ePlayer = Players:GetPlayerFromCharacter(enemyCharacter) or Players:FindFirstChild(enemyCharacter.Name)
        if ePlayer ~= tPlayer and enemyCharacter ~= tPlayer.Character then
            return
        end
    end
    if isAutoOrientActive() and isWithinParryRadius(enemyCharacter) then
        if not (controller.DontParryWhenNotFacing and not isFacingTarget(enemyCharacter)) then
            controller.AutoFaceTarget = enemyCharacter
            controller.AutoFaceUntil = os.clock() + 0.5
            faceCharacter(enemyCharacter)
        end
    end
    local pugilist = controller.BoxingStates or controller.PugilistStates
    local interceptActive = pugilist and (pugilist.Counter and pugilist.Counter:get() == true or pugilist.Intercept and pugilist.Intercept:get() == true)
    if interceptActive then
        local curStyle = tostring(getLocalFightStyle() or controller.LocalM1Style or ""):lower()
        if curStyle:find("boxing") then
            local myChar = LocalPlayer.Character
            local myRoot = rootOf(myChar)
            local enemyRoot = rootOf(enemyCharacter)
            local maxRange = tonumber(pugilist.Reach and pugilist.Reach:get() or pugilist.CounterRange and pugilist.CounterRange:get()) or 5.5
            if myChar and myRoot and enemyRoot and (myRoot.Position - enemyRoot.Position).Magnitude <= maxRange then
                if myChar:GetAttribute("M2Cooldown") ~= true and myChar:GetAttribute("Downed") ~= true and myChar:GetAttribute("Ragdoll") ~= true and myChar:GetAttribute("Stunned") ~= true then
                    controller.TriggerCount = (controller.TriggerCount or 0) + 1
                    controller.LastTarget = enemyCharacter.Name
                    controller.LastAnimation = (attack and attack.Name or "Attack") .. " (INTERCEPT)"
                    controller.LastState = "Pugilist instant M2 intercept"
                    releaseM1Hold()
                    if isAutoOrientActive() and isWithinParryRadius(enemyCharacter) then
                        controller.AutoFaceTarget = enemyCharacter
                        controller.AutoFaceUntil = os.clock() + 0.5
                        faceCharacter(enemyCharacter, true)
                    end
                    fireAliM2Action()
                    return
                end
            end
        end
    end
    if controller.AliStates and controller.AliStates.Counter and controller.AliStates.Counter:get() == true then
        local myChar = LocalPlayer.Character
        local myRoot = rootOf(myChar)
        local enemyRoot = rootOf(enemyCharacter)
        local maxRange = tonumber(controller.AliStates.CounterRange and controller.AliStates.CounterRange:get()) or 7.5
        if myRoot and enemyRoot and (myRoot.Position - enemyRoot.Position).Magnitude <= maxRange then
            if typeof(applyAliRotationHold) == "function" then
                applyAliRotationHold(enemyCharacter)
            end
        end
    end
    local dodgeStates = controller.DodgeStates
    local dodgeEnabled = dodgeStates and dodgeStates.Enabled:get() == true
    local shouldDodge = false
    local dodgeAttempted = false
    if dodgeEnabled then
        local isAltEnemy = false
        if enemyCharacter then
            local p = Players:GetPlayerFromCharacter(enemyCharacter) or Players:FindFirstChild(enemyCharacter.Name)
            local pName = p and p.Name:lower() or enemyCharacter.Name:lower()
            if (controller.AltUsername and controller.AltUsername ~= "" and (pName == controller.AltUsername:lower() or (p and p.DisplayName:lower() == controller.AltUsername:lower())))
                or (controller.DetectedAlts and controller.DetectedAlts[pName]) then
                isAltEnemy = true
            end
        end
        if not isAltEnemy then
            local isHeavy = attack.Heavy == true
            local dodgeAllHeavies = dodgeStates.AllHeavies:get() == true
            local dodgeAllM1s = dodgeStates.AllM1s and dodgeStates.AllM1s:get() == true
            local dodgeIfCantParry = dodgeStates.IfCantParry:get() == true
            local canParryNow = controller.Enabled
                and (os.clock() >= (controller.ParryRecoveryUntil or 0))
                and canParry(enemyCharacter, true)
            if isHeavy then
                if dodgeAllHeavies then
                    shouldDodge = true
                elseif not canParryNow and dodgeIfCantParry then
                    shouldDodge = true
                elseif not controller.Enabled then
                    shouldDodge = true
                end
            else
                if dodgeAllM1s then
                    shouldDodge = true
                elseif not canParryNow and dodgeIfCantParry then
                    shouldDodge = true
                end
            end
        end
    end
    local wcStates = controller.WingChunStates
    local wcCounterActive = wcStates and wcStates.Counter:get() == true
    local wcInsteadOfDodge = wcStates and wcStates.CounterInsteadOfDodge:get() == true
    if shouldDodge then
        if wcCounterActive and wcInsteadOfDodge and canWingChunCounter(enemyCharacter, attack) then
            executeWingChunCounter(enemyCharacter, attack, speed)
            return
        end
        dodgeAttempted = true
        if performDodge(enemyCharacter, attack, speed) then return end
        if attack.Heavy == true and dodgeStates.AllHeavies:get() == true
            and dodgeStates.ParryM2 and dodgeStates.ParryM2:get() == false then
            controller.LastState = "M2 dodge skipped; parry fallback disabled"
            return
        end
    end
    if wcCounterActive and canWingChunCounter(enemyCharacter, attack) then
        executeWingChunCounter(enemyCharacter, attack, speed)
        return
    end
    if not controller.Enabled then
        if not dodgeAttempted and dodgeEnabled and dodgeStates.IfCantParry:get() == true then
            performDodge(enemyCharacter, attack, speed)
        end
        return
    end
    if not canParry(enemyCharacter, true) then
        local fallbackActive = controller.FallbackSafetyBlock or (controller.FallbackSafetyBlockState and controller.FallbackSafetyBlockState:get() == true)
        if fallbackActive and not controller.PulseActive and not controller.FallbackBlockActive then
            local myChar = LocalPlayer.Character
            local myRoot = rootOf(myChar)
            local enemyRoot = rootOf(enemyCharacter)
            if myChar and myRoot and enemyRoot and myChar:GetAttribute("Equip") == true and myChar:GetAttribute("Ragdoll") ~= true and myChar:GetAttribute("Downed") ~= true then
                local dist = (myRoot.Position - enemyRoot.Position).Magnitude
                local maxFallbackRange = tonumber(controller.FallbackBlockRangeState and controller.FallbackBlockRangeState:get() or controller.FallbackBlockRange) or 12
                if dist <= maxFallbackRange then
                    local dur = tonumber(controller.FallbackBlockDurationState and controller.FallbackBlockDurationState:get() or controller.FallbackBlockDuration) or 0.45
                    controller.FallbackBlockActive = true
                    controller.BlockingUntil = os.clock() + dur
                    controller.LastState = "Fallback safety block"
                    task.spawn(function()
                        local blockMod = getCombatModule("Block")
                        if blockMod and typeof(blockMod.Block) == "function" and typeof(blockMod.Unblock) == "function" then
                            pcall(blockMod.Block)
                            task.wait(dur)
                            if controller.FallbackBlockActive then
                                pcall(blockMod.Unblock)
                                controller.FallbackBlockActive = false
                                if (controller.M1PriorityEnabled or controller.ParryInterruptedM1 or isM1Held()) and isM1Held() then
                                    controller.ParryInterruptedM1 = false
                                    task.spawn(function()
                                        RunService.Heartbeat:Wait()
                                        if isM1Held() and not controller.PulseActive and not controller.FallbackBlockActive and controller.ParryTiming.Preparing == nil then
                                            resumeM1Hold()
                                        end
                                    end)
                                end
                            end
                        else
                            controller.FallbackBlockActive = false
                        end
                    end)
                end
            end
        end
        return
    end
    if (controller.DisableBlockMidDash or (controller.DisableBlockMidDashState and controller.DisableBlockMidDashState:get() == true)) and controller.IsDashing and controller.IsDashing() then
        controller.LastState = "Skipped mid dash"
        return
    end
    if controller.DontParryWhenNotFacing and not isFacingTarget(enemyCharacter) then
        controller.LastState = "Skipped: not facing"
        return
    end
    if controller.SkipFirstHit and not attack.Heavy and (attack.Combo or 1) <= 1 then
        controller.LastState = "Skipped first M1"
        return
    end
    if math.random(1, 100) > (controller.ParryChance or 100) then
        controller.LastState = "Skipped by chance"
        if not dodgeAttempted and dodgeEnabled and dodgeStates.IfCantParry:get() == true then
            performDodge(enemyCharacter, attack, speed)
        end
        return
    end
    local timing = controller.ParryTiming
    local key = track or enemyCharacter
    if timing.Pending[key] then return end
    local ticket = {}
    local prepared = false
    timing.Pending[key] = ticket
    local myChar = LocalPlayer.Character
    local epoch = controller.ParryEpoch
    local hitDelay, window, multiDelays = timing.Resolve(enemyCharacter, attack, track)
    local started = os.clock()
    local ping = 0.05
    pcall(function() ping = LocalPlayer:GetNetworkPing() end)
    local nextPingSample = started + 0.1
    local function valid()
        if not controller.Enabled or controller.ParryEpoch ~= epoch
            or LocalPlayer.Character ~= myChar
            or _G.LarpkuranRageGeneration ~= larpkuranRageGeneration then return false end
        if not myChar or not myChar.Parent or not enemyCharacter.Parent then return false end
        if string.lower(tostring(attack.Style)) == "jin" and myChar:GetAttribute("Equip") ~= true then return false end
        if track and not track.IsPlaying then return false end
        if controller.DontParryWhenNotFacing and not isFacingTarget(enemyCharacter) then return false end
        return canParry(enemyCharacter, true)
    end
    controller.TriggerCount = (controller.TriggerCount or 0) + 1
    controller.LastTarget = enemyCharacter.Name
    controller.LastAnimation = attack.Name
    controller.LastState = "Scheduled"
    task.spawn(function()
        local ok, err = pcall(function()
            local currentHits = multiDelays or {hitDelay}
            for hitIdx, curHitDelay in ipairs(currentHits) do
                prepared = false
                while valid() and os.clock() - started < 3 do
                    local liveSpeed = track and track.Speed or tonumber(speed) or 1
                    local currentSpeed = (liveSpeed and liveSpeed > 0.01) and liveSpeed or 1
                    local position = track and track.TimePosition
                        or ((tonumber(trackTimePos) or 0) + (os.clock() - started) * currentSpeed)
                    if currentSpeed > 0.01 then
                        local remaining = (curHitDelay - position) / currentSpeed
                        local now = os.clock()
                        if string.lower(tostring(attack.Style)) == "jin" and track and (tonumber(track.Speed) or 1) <= 0.01 then
                            RunService.Heartbeat:Wait()
                            continue
                        end
                        if now >= nextPingSample then
                            nextPingSample = now + 0.1
                            pcall(function()
                                local rawP = LocalPlayer:GetNetworkPing()
                                controller.SmoothedPing = controller.SmoothedPing and (controller.SmoothedPing * 0.8 + rawP * 0.2) or rawP
                                ping = controller.SmoothedPing
                            end)
                        end
                        local latestSend = timing.Transport(ping)
                        if remaining < -0.035 then
                            controller.LastState = "Hit window passed; block unavailable"
                            if not dodgeAttempted and not controller.PulseActive and dodgeEnabled and dodgeStates.IfCantParry:get() == true then
                                performDodge(enemyCharacter, attack, currentSpeed)
                            end
                            break
                        end
                        if attack.Heavy and controller.HeavyAttackParryState and controller.HeavyAttackParryState:get() == false then break end
                        if controller.PerfectParryState and controller.PerfectParryState:get() == false then break end
                        local lead = timing.Lead(math.max(0, remaining), window, ping, attack.Heavy == true)
                        if remaining <= lead + 0.08 and not prepared and not controller.PulseActive then
                            prepared = true
                            timing.Preparing = ticket
                            controller.LastState = "Preparing block"
                            releaseM1Hold()
                        end
                        if prepared and not controller.PulseActive and not canParry(enemyCharacter) then
                            controller.LastState = "Waiting for block recovery"
                        end
                        if remaining <= lead and canParry(enemyCharacter) and not controller.PulseActive then
                            if typeof(releaseM1Hold) == "function" then releaseM1Hold() end
                            if not valid() then break end
                            if isAutoOrientActive() and isWithinParryRadius(enemyCharacter) then
                                faceCharacter(enemyCharacter, true)
                            end
                            controller.LastParryTiming = {
                                animation = attack.Name .. (hitIdx > 1 and ("_Hit" .. tostring(hitIdx)) or ""),
                                remaining = remaining, lead = lead,
                                oneWay = ping, transport = latestSend, observedAt = started, sentAt = now,
                                late = remaining < latestSend,
                            }
                            log(string.format("PARRY %s target=%s hit=%d remain=%.3f lead=%.3f transit=%.3f", attack.Name, enemyCharacter.Name, hitIdx, remaining, lead, latestSend))
                            local pulseAttack = attack
                            if controller.JinStates and controller.JinStates.Dual:get() == true
                                and string.lower(tostring(attack.Style)) == "jin" and currentHits[hitIdx + 1] then
                                pulseAttack = table.clone(attack)
                                pulseAttack.JinReleaseBy = now + math.max(0.08,
                                    (currentHits[hitIdx + 1] - position) / currentSpeed - lead - 0.06)
                            end
                            pulseBlock(enemyCharacter, pulseAttack, math.max(0, remaining), valid,
                                math.max(0, remaining - latestSend))
                            break
                        end
                    end
                    RunService.Heartbeat:Wait()
                end
                if hitIdx < #currentHits then
                    while controller.PulseActive and valid() do
                        RunService.Heartbeat:Wait()
                    end
                    task.wait(0.015)
                end
            end
        end)
        if timing.Pending[key] == ticket then timing.Pending[key] = nil end
        if timing.Preparing == ticket then timing.Preparing = nil end
        if not ok then controller.LastError = tostring(err) end
    end)
end
local function watchCharacter(character)
