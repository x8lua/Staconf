            updateAttackHud(target, damageDone, targetDamageToDeal)
            if damageDone >= targetDamageToDeal and ticks >= 1 then
                break
            end
            setFightingStance(true)
            if altHRP and enemyRoot then
                local aimPos = predictedPosition(enemyRoot)
                if standRageMode == 1 and not isDefenseActive then
                    for p in pairs(getStandParts(localPlayer.Character)) do
                        if p.Parent and p.CanCollide then p.CanCollide = false end
                    end
                    local forward = Vector3.new(enemyRoot.CFrame.LookVector.X, 0, enemyRoot.CFrame.LookVector.Z)
                    if forward.Magnitude < 0.05 then
                        forward = Vector3.new(0, 0, -1)
                    else
                        forward = forward.Unit
                    end
                    local backPos = aimPos - forward * 3.2
                    local goal = CFrame.lookAt(backPos, aimPos)
                    local tw = TweenService:Create(altHRP, TweenInfo.new(0.05, Enum.EasingStyle.Linear), {CFrame = goal})
                    tw:Play()
                    tw.Completed:Wait()
                    altHRP.AssemblyLinearVelocity = Vector3.zero
                    altHRP.AssemblyAngularVelocity = Vector3.zero
                else
                    local groundY = getGroundY(enemyRoot.Position)
                    local vel = enemyRoot.AssemblyLinearVelocity
                    local isAiring = enemyH and (enemyH.FloorMaterial == Enum.Material.Air or enemyH:GetState() == Enum.HumanoidStateType.Freefall or enemyH:GetState() == Enum.HumanoidStateType.Jumping or math.abs(vel.Y) > 1.5)
                    local effectiveY = enemyRoot.Position.Y
                    if isAiring or enemyRoot.Position.Y > (groundY + 0.5) then
                        if vel.Y < -2 and enemyRoot.Position.Y < groundY then
                            effectiveY = enemyRoot.Position.Y
                        else
                            effectiveY = groundY
                        end
                    end
                    local depth = isDefenseActive and 6.0 or attackUndergroundDepth
                    local safeY = math.clamp(effectiveY - depth, -330, 2000)
                    local underPos = Vector3.new(aimPos.X, safeY, aimPos.Z)
                    local lookDir = aimPos - underPos
                    if lookDir.Magnitude > 0.05 then
                        altHRP.CFrame = CFrame.lookAt(underPos, aimPos, Vector3.new(0, 0, -1))
                    else
                        altHRP.CFrame = CFrame.new(underPos)
                    end
                    altHRP.AssemblyLinearVelocity = Vector3.zero
                    altHRP.AssemblyAngularVelocity = Vector3.zero
                end
                ticks = ticks + 1
                local useM2 = ticks % 5 == 0
                if useM2 then
