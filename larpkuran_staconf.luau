    handleMainChatCommand = function(txt)
        local cleaned = tostring(txt or ""):gsub('^%s+', ''):gsub('%s+$', '')
        if cleaned:sub(1, 1) == '"' or cleaned:sub(1, 1) == "'" then cleaned = cleaned:sub(2) end
        if cleaned:sub(-1, -1) == '"' or cleaned:sub(-1, -1) == "'" then cleaned = cleaned:sub(1, -2) end
        cleaned = cleaned:gsub("^%s*(.-)%s*$", "%1")
        local split = string.split(cleaned, " ")
        local cmd = string.lower(split[1] or ""):gsub("[%p]+$", "")
        if cmd == "/unpair" or cmd == "!unpair" then
            local target = tostring(split[2] or ""):lower()
            if controller.UnpairStand and (target == "" or controller.DetectedAlts[target]) then
                controller.UnpairStand(false, target)
            end
        elseif cmd == "/cancel" or cmd == "!cancel" or cmd == "/stop" or cmd == "!stop" then
            controller.IsWrestlingBringActive = false
        elseif cmd == "/wbring" or cmd == "!wbring" or cmd == "/wb" or cmd == "!wb" or cmd == "/wrestlingbring" or cmd == "!wrestlingbring" then
            local customPos = nil
            local query = ""
            local n = #split
            if n >= 4 and tonumber(split[n-2]) and tonumber(split[n-1]) and tonumber(split[n]) then
                customPos = Vector3.new(tonumber(split[n-2]), tonumber(split[n-1]), tonumber(split[n]))
                if n > 4 then
                    query = table.concat(split, " ", 2, n - 3)
                end
            else
                query = table.concat(split, " ", 2)
            end
            local target = nil
            if query ~= "" then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and (p.Name:lower():find(query:lower(), 1, true) or p.DisplayName:lower():find(query:lower(), 1, true)) then
                        target = p
                        break
                    end
                end
            end
            if not target then
                target = controller.CombatTargetPlayer or controller.FaceAtTarget
            end
            if not target then
                local bestDist = 9999
                local myRoot = rootOf(LocalPlayer.Character)
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character and rootOf(p.Character) and myRoot then
                        local d = (rootOf(p.Character).Position - myRoot.Position).Magnitude
                        if d < bestDist then
                            bestDist = d
                            target = p
                        end
                    end
                end
            end
            if target and target ~= LocalPlayer and controller.ExecuteMainWrestlingBring then
                controller.ExecuteMainWrestlingBring(target, customPos)
            end
        elseif cmd == "/doubletrouble" or cmd == "!doubletrouble" or cmd == "/dt" or cmd == "!dt" then
            local now = os.clock()
            local opt = string.lower(split[2] or ""):gsub("[%p]+$", "")
            local targetState = nil
            if opt == "on" or opt == "true" or opt == "1" or opt == "enable" then
                targetState = true
            elseif opt == "off" or opt == "false" or opt == "0" or opt == "disable" then
                targetState = false
            else
                if (now - (controller._lastDTToggleTime or 0)) > 0.4 then
                    controller._lastDTToggleTime = now
                    targetState = not controller.DoubleTroubleEnabled
                else
                    return
                end
            end
            if targetState ~= nil and targetState ~= controller.DoubleTroubleEnabled then
                controller.DoubleTroubleEnabled = targetState
                if controller.DoubleTroubleState then
                    controller.DoubleTroubleState:set(controller.DoubleTroubleEnabled)
                end
                task.spawn(function()
                    if type(writefile) == "function" then
                        pcall(function()
                            local hs = game:GetService("HttpService")
                            writefile(("larpkuran_stand_cmd_" .. LocalPlayer.Name:lower() .. ".json"), hs:JSONEncode({
                                id = hs:GenerateGUID(false),
                                cmd = string.format("/doubletrouble %s", controller.DoubleTroubleEnabled and "on" or "off"),
                                time = tick()
                            }))
                        end)
                    end
                end)
            end
        elseif cmd == "/newspaper" or cmd == "!newspaper" or cmd == "!autojob" or cmd == "/job" or cmd == "!job" then
            local rest = table.concat(split, " ", 2):lower()
            if rest:find("stop") or rest:find("off") then
                controller.AutoNewspaperState:set(false)
            elseif rest:find("start") or rest:find("on") then
                controller.AutoNewspaperState:set(true)
            else
                controller.AutoNewspaperState:set(not controller.AutoNewspaperState:get())
            end
        elseif cmd == "/defense" or cmd == "!defense" or cmd == "/protect" or cmd == "!protect" then
            task.spawn(function()
                if type(writefile) == "function" then
                    pcall(function()
                        local hs = game:GetService("HttpService")
                        writefile(("larpkuran_stand_cmd_" .. LocalPlayer.Name:lower() .. ".json"), hs:JSONEncode({
                            id = hs:GenerateGUID(false),
                            cmd = cleaned,
                            time = tick()
                        }))
                    end)
                end
            end)
        else
            if cmd:sub(1, 1) == "/" or cmd:sub(1, 1) == "!" then
                task.spawn(function()
                    if type(writefile) == "function" then
                        pcall(function()
                            local hs = game:GetService("HttpService")
                            writefile(("larpkuran_stand_cmd_" .. LocalPlayer.Name:lower() .. ".json"), hs:JSONEncode({
                                id = hs:GenerateGUID(false),
                                cmd = cleaned,
                                time = tick()
                            }))
                        end)
                    end
                end)
            end
        end
    end
