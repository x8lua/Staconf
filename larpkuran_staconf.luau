    end)
    function c.clearBoard()
        local hasEraser = c.hasEraserCached
        local dist = c.currentBoardDist
        local isClose = c.isBoardClose
        if not isClose then
            c.statusState:set(string.format("Declined: Too far from blackboard (%.1f / 16.0 studs). Move closer!", dist))
            return
        elseif not hasEraser then
            c.statusState:set("Declined: Eraser not equipped! Click '🧽 Grab Eraser'")
            return
        end
        task.spawn(function()
            local board = c.getTargetBoard()
            if not board then return warn("[Chalk] 身邊沒有找到黑板！") end
            local clearBuf = buffer.create(5)
            buffer.writeu8(clearBuf, 0, 106)
            buffer.writeu32(clearBuf, 1, board.boardId)
            local relRemote = game.ReplicatedStorage:FindFirstChild("BLINK_RELIABLE_REMOTE")
            if relRemote then
                relRemote:FireServer(clearBuf, {})
            end
            pcall(function()
                if c.Client and c.Client.WhiteboardClear and c.Client.WhiteboardClear.Fire then
                    c.Client.WhiteboardClear.Fire({BoardId = board.boardId})
                end
            end)
            if board.editableImage then
                pcall(function()
                    board.editableImage:DrawRectangle(Vector2.zero, Vector2.new(512, 384), Color3.new(0, 0, 0), 0, Enum.ImageCombineType.Overwrite)
                end)
            end
            local authorGridObj = c.getAuthorGrid(board.boardId)
            if authorGridObj then
                authorGridObj.authorGrid = {}
                authorGridObj.authorCount = 0
            end
            c.progressCountState:set("0 / 0 lines (0.0%)")
            c.progressBarState:set("[░░░░░░░░░░░░░░░░░░░░] 0%")
            c.timeLeftState:set("Board Cleared")
            c.boxImage.Visible = true
            c.statusState:set("Board Cleared (Replicated to server)")
        end)
    end
    task.spawn(function()
        while _G.LarpkuranRageGeneration == larpkuranRageGeneration do
            task.wait(0.15)
            if controller.Stopped or _G.LarpkuranRageGeneration ~= larpkuranRageGeneration then break end
            c.updateEquippedAndDistances()
            local player = game.Players.LocalPlayer
            local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local closestPart, closestDist = nil, math.huge
                for _, part in ipairs(c.allBoardParts) do
                    if part.Parent then
                        local dist = (part.Position - root.Position).Magnitude
                        if dist < closestDist then
                            closestDist = dist
                            closestPart = part
                        end
                    end
                end
                c.currentBoardDist = closestDist
                c.isBoardClose = closestDist <= 16.0
                if closestPart and c.isBoardClose and not c.isDrawingNow then
                    if not c.cachedBoard or c.cachedBoard.part ~= closestPart then
                        c.getTargetBoard(closestPart)
                        c.statusState:set(string.format("Switched to nearest board (ID: %s, %.1f studs)", tostring(closestPart:GetAttribute("WhiteboardId")), closestDist))
                    end
                    if c.showPreviewState:get() then
                        c.boardSg.Enabled = true
                        c.selectionBox.Visible = true
                    end
                elseif not c.isDrawingNow then
                    c.boardSg.Enabled = false
                    c.selectionBox.Visible = false
                end
            elseif not c.isDrawingNow then
                c.boardSg.Enabled = false
                c.selectionBox.Visible = false
            end
        end
    end)
    c.lastTextVal = c.textState:get()
    c.lastStretchVal = c.stretchXState:get()
    c.lastSpacingVal = c.letterSpacingState:get()
    c.lastFontVal = c.fontSelectedState:get()
    c.debounceThread = nil
    task.spawn(function()
        while _G.LarpkuranRageGeneration == larpkuranRageGeneration do
            task.wait(0.1)
            if controller.Stopped or _G.LarpkuranRageGeneration ~= larpkuranRageGeneration then break end
            local curText = c.textState:get()
            local curStretch = c.stretchXState:get()
            local curSpacing = c.letterSpacingState:get()
            local curFont = c.fontSelectedState:get()
            if curText ~= c.lastTextVal or curStretch ~= c.lastStretchVal or curSpacing ~= c.lastSpacingVal or curFont ~= c.lastFontVal then
                c.lastTextVal = curText
                c.lastStretchVal = curStretch
                c.lastSpacingVal = curSpacing
                c.lastFontVal = curFont
                local secKey = c.secretKeyState:get():gsub("^%s*(.-)%s*$", "%1")
                if #secKey > 0 then
                    c.rateLimitUntil = 0
                end
                local selFontObj = c.getFontObj(curFont)
                c.boxText.Text = curText
                c.boxText.Font = selFontObj.robloxFont or Enum.Font.SourceSansBold
                if c.debounceThread then task.cancel(c.debounceThread) end
                c.debounceThread = task.delay(0.25, function()
                    c.generateImageFromVPS()
                end)
            end
        end
    end)
    c.generateImageFromVPS()
    trackConnection("ChalkStudio_Cleanup", {
        Disconnect = function()
            c.isDrawingNow = false
            if c.debounceThread then pcall(task.cancel, c.debounceThread); c.debounceThread = nil end
            pcall(function() c.boardSg:Destroy() end)
        end
    })
end)()
