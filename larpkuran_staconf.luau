        local basePos = startPos:Lerp(endPos, t)
        local arcY = 4 * arcHeight * t * (1 - t)
        local curPos = basePos + Vector3.new(0, arcY, 0)
        local nextT = math.min(1, t + 0.03)
        local nextBase = startPos:Lerp(endPos, nextT)
        local nextArcY = 4 * arcHeight * nextT * (1 - nextT)
        local nextPos = nextBase + Vector3.new(0, nextArcY, 0)
        local dir = nextPos - curPos
        if dir.Magnitude > 0.01 then
            altHRP.CFrame = CFrame.lookAt(curPos, curPos + dir)
        else
            altHRP.CFrame = CFrame.new(curPos)
        end
        altHRP.AssemblyLinearVelocity = Vector3.zero
        altHRP.AssemblyAngularVelocity = Vector3.zero
        if curPos.Y < (refY - 10) and t > 0.65 then
            break
        end
        RunService.Heartbeat:Wait()
    end
