    local function applyInteractKey(keyName)
        if not keyName or keyName == "" or keyName == "E" then return end
        local kc = resolveInput(keyName)
        if not kc or typeof(kc) ~= "EnumItem" then return end
        for _, inst in ipairs(workspace:GetDescendants()) do
            if inst:IsA("ProximityPrompt") then
                pcall(function() inst.KeyboardKeyCode = kc end)
            end
        end
