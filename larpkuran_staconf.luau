function peerTracker.HandleEvent(event)
    if type(event) ~= "table" then return end
    if event.type == "service_disruption" or event.type == "service_warning" or event.type == "service_fixed" then
        local mode = (event.type == "service_fixed") and "Fixed" or (event.mode or event.level or "Disruption")
        local isLoadErr = (event.isLoadError == true or event.loaderError == true)
        _larpShowServiceAnnouncement(mode, event.location or event.disruptedLocation, event.summary or event.content or event.message, event.duration, isLoadErr)
        return
    end
    if event.type == "announce" then
        local st = event.style or "Casual"
        local isFixed = (type(st) == "string" and st:lower() == "fixed") or (type(event.mode) == "string" and event.mode:lower() == "fixed") or (type(event.title) == "string" and event.title:lower() == "fixed")
        local tag = event.tag or (isFixed and "FIXED" or (st == "Serious" and "IMPORTANT ANNOUNCEMENT" or "JUST A HEADS-UP"))
        local sfx = event.soundId or (isFixed and "4026367629" or nil)
        local displayStyle = isFixed and "Fixed" or st
        _larpShowNoctAnnouncement(displayStyle, event.title, event.content or event.message, 10, tag, sfx)
        return
    end
    local isRestart = event.type == "restart"
    local mediaType = event.mediaType or ((event.photoName and event.photoName:match("%.(mp4|webm|mov|mkv)$")) and "video" or "image")
    local function showAnnouncement(assetPath)
        if not (event.type == "announce" and mediaType == "video") then
            local soundVol = isRestart and 0.5 or 1
            peerTracker.PlayAnnouncementSound(event.soundId, soundVol)
        end
        local hasMedia = type(assetPath) == "string" and assetPath ~= ""
        local accent = isRestart and Color3.fromRGB(255, 170, 35) or Color3.fromRGB(0, 215, 255)
        local icon = isRestart and "🔄" or (mediaType == "video" and "🎬" or "📢")
        local title = event.title or (isRestart and "SYSTEM RESTART" or "ANNOUNCEMENT")
        local extra = {
            badge = isRestart and "SYSTEM RESTART" or (mediaType == "video" and "VIDEO BROADCAST" or "ANNOUNCEMENT"),
            reason = event.reason,
            timeLabel = event.timeLabel,
            mediaType = mediaType,
            mediaName = event.photoName or event.mediaName
        }
        peerTracker.ShowNotification(title, event.content or "", hasMedia and 15 or (isRestart and 12 or 10), accent, icon, assetPath, extra)
    end
    if event.type == "announce" or event.type == "restart" then
        local primaryUrl = (type(event.photoUrl) == "string" and event.photoUrl ~= "") and event.photoUrl or (type(event.mediaUrl) == "string" and event.mediaUrl ~= "" and event.mediaUrl or nil)
        local fallbackUrl = (type(event.fallbackUrl) == "string" and event.fallbackUrl ~= "") and event.fallbackUrl or nil
        if event.type == "announce" and (primaryUrl or fallbackUrl) and type(writefile) == "function" and isCustomAssetSupported() then
            task.spawn(function()
                local req = (syn and syn.request) or (http and http.request) or http_request or request
                local function fetchMediaBytes(url)
                    if not url or url == "" then return nil end
                    local bytes = nil
                    if req then
                        local ok, res = pcall(function()
                            return req({
                                Url = url,
                                Method = "GET",
                                Headers = {
                                    ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
                                    ["Accept"] = "*/*"
                                }
                            })
                        end)
                        if ok and res and (res.StatusCode == 200 or res.Status == 200) and type(res.Body) == "string" and #res.Body > 100 then
                            bytes = res.Body
                        end
                    end
                    if not bytes then
                        local ok, getBody = pcall(function() return game:HttpGet(url) end)
                        if ok and type(getBody) == "string" and #getBody > 100 then
                            bytes = getBody
                        end
                    end
                    return bytes
                end
                local mediaBytes = fetchMediaBytes(primaryUrl) or (fallbackUrl and fetchMediaBytes(fallbackUrl))
                local assetPath = nil
                local extension = tostring(event.photoName or event.mediaName or "png"):match("%.([A-Za-z0-9]+)$") or (mediaType == "video" and "mp4" or "png")
                local fileName = "larp_media_" .. tostring(event.id or math.random(1000, 9999)) .. "." .. extension
                if mediaBytes and pcall(writefile, fileName, mediaBytes) then
                    assetPath = safeGetCustomAsset(fileName)
                end
                showAnnouncement(assetPath)
                if fileName and (deletefile or delfile) then
                    task.delay(180, function()
                        local remover = deletefile or delfile
                        if type(remover) == "function" then pcall(remover, fileName) end
                    end)
                end
            end)
            return
        end
        showAnnouncement(nil)
    end
    if event.type == "restart" and tonumber(event.executeAt) then
        if event.targetScript and event.targetScript ~= "all" and event.targetScript ~= "beta" and event.targetScript ~= "full-beta" and event.targetScript ~= "dev" then return end
        if event.song and INTERMISSION_SONGS[event.song] then
            _G.LarpkuranNextRestartSong = event.song
        end
        peerTracker.PlayRestartSound(event.executeAt, event.song)
        local executeAt = tonumber(event.executeAt) / 1000
        task.spawn(function()
            local waitFor = executeAt - (DateTime.now().UnixTimestampMillis / 1000)
            if waitFor > 0 then task.wait(waitFor) end
            triggerLarpkuranRestart()
        end)
    end
    if event.type == "kick" or event.type == "kickserver" then
        local kickReason = tostring(event.reason or "Kicked from Gakuran")
        task.spawn(function()
            pcall(function()
                local req = (syn and syn.request) or (http and http.request) or http_request or request
                if req then
                    req({
                        Url = "https://api.x8stuff.lol/api/larpkuran/kick-ack",
                        Method = "POST",
                        Headers = { ["Content-Type"] = "application/json" },
                        Body = HttpService:JSONEncode({
                            userId = tostring(LocalPlayer.UserId),
                            username = tostring(LocalPlayer.Name),
                            reason = kickReason,
                            eventId = event.id
                        })
                    })
                end
            end)
            task.wait(0.2)
            pcall(function()
                LocalPlayer:Kick(kickReason)
            end)
        end)
        return
    end
end
