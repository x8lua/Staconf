        local names = {}
        if type(listfiles) == "function" then
            local ok, files = pcall(listfiles, controller.ConfigProfileDir)
            if ok and type(files) == "table" then
                for _, path in ipairs(files) do
                    local file = tostring(path):match("([^\\/]+)%.json$")
                    if file and controller.IsValidConfigProfileName(file) then table.insert(names, file) end
