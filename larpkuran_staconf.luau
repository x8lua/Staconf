        or (originalAnimation and controller.FakeStyleNameMap[originalAnimation.Name:lower()] ~= false and controller.FakeStyleNameMap[originalAnimation.Name:lower()])
        or (track.Name and controller.FakeStyleNameMap[tostring(track.Name):lower()] ~= false and controller.FakeStyleNameMap[tostring(track.Name):lower()])
    if not replacement then
        rebuildFakeStyleMap()
        replacement = (slot and controller.FakeStyleSlotMap[slot])
            or controller.FakeStyleObjectMap[originalAnimation]
            or (originalId and controller.FakeStyleIdMap[originalId])
            or (originalAnimation and controller.FakeStyleNameMap[originalAnimation.Name:lower()] ~= false and controller.FakeStyleNameMap[originalAnimation.Name:lower()])
            or (track.Name and controller.FakeStyleNameMap[tostring(track.Name):lower()] ~= false and controller.FakeStyleNameMap[tostring(track.Name):lower()])
    end
