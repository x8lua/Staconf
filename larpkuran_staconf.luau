do
local function disconnectAttackVelocityConnection(state, key)
    local connection = state and state[key]
    if connection then pcall(function() connection:Disconnect() end) end
    if state then state[key] = nil end
end
local function stopAttackVelocity()
    local state = _G.NoAttackSlowState
    if type(state) ~= "table" then return end
    state.enabled = false
    for _, key in ipairs({"speedConnection", "heartbeat", "characterConnection"}) do disconnectAttackVelocityConnection(state, key) end
    _G.AttackSlowSpeedOverride = nil
end
local function startAttackVelocity(speed)
    local state = _G.NoAttackSlowState or {}
    for _, key in ipairs({"speedConnection", "heartbeat", "characterConnection"}) do disconnectAttackVelocityConnection(state, key) end
    state.enabled, state.attackSpeed = true, math.clamp(tonumber(speed) or 25, 4, 30)
    _G.NoAttackSlowState, _G.AttackSlowSpeedOverride = state, state.attackSpeed
    local function bindCharacter(character)
        disconnectAttackVelocityConnection(state, "speedConnection")
        disconnectAttackVelocityConnection(state, "heartbeat")
        if not state.enabled then return end
        local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
        if not humanoid then return end
        local correcting = false
        local function enforceAttackSpeed()
            if correcting or not state.enabled or not character.Parent or not humanoid.Parent then return end
            local incapacitated = character:GetAttribute("Stunned") == true or character:GetAttribute("Ragdoll") == true or character:GetAttribute("Downed") == true
            local attacking = character:GetAttribute("CombatAttacking") == true or character:GetAttribute("M1") == true or character:GetAttribute("M2") == true or character:GetAttribute("PendingM2") == true
            if attacking and not incapacitated and humanoid.WalkSpeed ~= state.attackSpeed then
                correcting = true; humanoid.WalkSpeed = state.attackSpeed; correcting = false
            end
        end
        state.enforce = enforceAttackSpeed
        state.speedConnection = humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(enforceAttackSpeed)
        state.heartbeat = RunService.Heartbeat:Connect(enforceAttackSpeed)
        character:SetAttribute("AttackSlowSpeedOverride", state.attackSpeed)
        enforceAttackSpeed()
    end
    state.characterConnection = LocalPlayer.CharacterAdded:Connect(bindCharacter)
    if LocalPlayer.Character then bindCharacter(LocalPlayer.Character) end
end
local function syncAttackVelocity()
    local enabledNow, speedNow = attackVelocity.enabledState:get() == true, math.clamp(tonumber(attackVelocity.speedState:get()) or 25, 4, 30)
    local state = _G.NoAttackSlowState
    if enabledNow then
        if not attackVelocity.active or type(state) ~= "table" or state.enabled ~= true then startAttackVelocity(speedNow); attackVelocity.active = true
        elseif attackVelocity.speed ~= speedNow then state.attackSpeed = speedNow; _G.AttackSlowSpeedOverride = speedNow; if type(state.enforce) == "function" then pcall(state.enforce) end end
        attackVelocity.speed = speedNow
    elseif attackVelocity.active or (state and state.enabled) then stopAttackVelocity(); attackVelocity.active, attackVelocity.speed = false, nil end
end
controller.SyncAttackVelocity = syncAttackVelocity
