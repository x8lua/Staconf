    function c.generateImageFromVPS()
        if c.isGenerating then return end
        if not c.httpRequest then return end
        local text = c.textState:get()
        if #text == 0 then return end
        c.isGenerating = true
        local selectedFont = c.getFontObj(c.fontSelectedState:get())
        local secKey = c.secretKeyState:get():gsub("^%s*(.-)%s*$", "%1")
        local stretchVal = c.stretchXState:get() / 100
        local spacingVal = c.letterSpacingState:get()
        c.statusState:set(string.format("Rendering preview (%s)...", selectedFont.name))
        task.spawn(function()
            local encodedText = HttpService:UrlEncode(text)
            local encodedFont = HttpService:UrlEncode(selectedFont.id)
            local encodedKey = HttpService:UrlEncode(secKey)
            local url = string.format("%s/render?text=%s&font=%s&size=96&stretch_x=%.2f&letter_spacing=%d&tight_fit=true&is_preview=true&key=%s", c.VPS_URL, encodedText, encodedFont, stretchVal, spacingVal, encodedKey)
            local success, res = pcall(function()
                return c.httpRequest({
                    Url = url,
                    Method = "GET",
                    Headers = {
                        ["X-Secret-Key"] = secKey
                    }
                })
            end)
            c.isGenerating = false
            if not success or not res then
                c.boxText.Text = text
                c.boxText.Font = selectedFont.robloxFont or Enum.Font.SourceSansBold
                c.boxText.Visible = true
                c.boxImage.Visible = false
                c.statusState:set("Error: Cannot connect to render service")
                return
            end
            if res.StatusCode == 429 then
                c.boxText.Text = text
                c.boxText.Font = selectedFont.robloxFont or Enum.Font.SourceSansBold
                c.boxText.Visible = true
                c.boxImage.Visible = false
                local retrySec = 80
                pcall(function()
                    local data = HttpService:JSONDecode(res.Body)
                    if data and data.retry_after then
                        retrySec = tonumber(data.retry_after) or 80
                    end
                end)
                c.rateLimitUntil = os.clock() + retrySec
                c.statusState:set(string.format("⏳ Rate Limited: Wait %ds (or enter Secret Key)", retrySec))
                return
            end
            if res.StatusCode ~= 200 then
                c.boxText.Text = text
                c.boxText.Font = selectedFont.robloxFont or Enum.Font.SourceSansBold
                c.boxText.Visible = true
                c.boxImage.Visible = false
                local code = tonumber(res and (res.StatusCode or res.status_code or res.status)) or 0
                c.statusState:set(string.format("Render Error (HTTP %d)", code))
                return
            end
            local pngBytes = res.Body
            local fileName = "larpkuran_chalk_preview.png"
            pcall(function()
                if type(writefile) == "function" then
                    writefile(fileName, pngBytes)
                end
            end)
            if c.customAsset then
                local assetUri = c.customAsset(fileName)
                local ok, loadedEi = pcall(function()
                    local AssetService = game:GetService("AssetService")
                    return AssetService:CreateEditableImageAsync(Content.fromUri(assetUri))
                end)
                if ok and loadedEi then
                    c.currentLoadedImage = loadedEi
                    c.currentAssetId = assetUri
                    pcall(function()
                        c.boxImage.ImageContent = Content.fromObject(loadedEi)
                    end)
                    c.boxImage.Image = assetUri or ""
                    c.boxImage.Visible = true
                    c.boxText.Visible = false
                    c.statusState:set(string.format("Preview Ready: %s (%dx%d)", selectedFont.name, loadedEi.Size.X, loadedEi.Size.Y))
                else
                    c.boxText.Text = text
                    c.boxText.Font = selectedFont.robloxFont or Enum.Font.SourceSansBold
                    c.boxText.Visible = true
                    c.boxImage.Visible = false
                    c.statusState:set(string.format("Preview Ready (Local Font): %s", selectedFont.name))
                end
            end
        end)
    end
    function c.sendLogEvent(status, totalLines)
