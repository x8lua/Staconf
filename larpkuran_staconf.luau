                end
            end
            task.wait(0.04)
        end
        isRetaliating = false
        currentRetaliateTarget = nil
        hideAttackHud()
        if not isDefenseActive then
            setFightingStance(false)
            if originalGravity ~= nil then
                workspace.Gravity = originalGravity
                originalGravity = nil
            end
            local char2 = localPlayer.Character
            local hum2 = char2 and char2:FindFirstChildOfClass("Humanoid")
            if hum2 and originalPlatformStand ~= nil then
                hum2.PlatformStand = originalPlatformStand
                originalPlatformStand = nil
            end
            local master = currentMaster or mainPlayer
            local masterChar2 = master and master.Character
            local masterHRP2 = masterChar2 and rootOf(masterChar2)
            local altHRP2 = localPlayer.Character and rootOf(localPlayer.Character)
            local isStandingOther = (currentMaster and mainPlayer and currentMaster ~= mainPlayer)
            if (not isStealthEnabled or isStandingOther) and masterHRP2 and altHRP2 then
                safeTeleportTo(masterHRP2.CFrame * CFrame.new(0, 3, 3), masterHRP2, CFrame.new(0, 3, 3))
            elseif altHRP2 then
                altHRP2.CFrame = CFrame.new(altHRP2.Position.X, BUFFER_RETURN_Y, altHRP2.Position.Z)
                altHRP2.AssemblyLinearVelocity = Vector3.zero
