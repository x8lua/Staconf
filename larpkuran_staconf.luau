controller.InitHitboxVisualizer = function()
    if getgenv and getgenv().HitboxVisualizerCleanup then
        pcall(getgenv().HitboxVisualizerCleanup)
    end
    local hv = {
        conn = {},
        adorn = {},
        col = {M1 = Color3.fromRGB(255, 72, 72), M2 = Color3.fromRGB(255, 168, 48)},
        def = Color3.fromRGB(180, 220, 255)
    }
    controller.HitboxVis = hv
    function hv.getColor(part)
        local attackName = part:FindFirstChild("AttackName")
        if attackName and attackName:IsA("StringValue") then
            return hv.col[attackName.Value] or hv.def
        end
        if part.Name:find("M1") then
            return hv.col.M1
        elseif part.Name:find("M2") then
            return hv.col.M2
        end
        return hv.def
    end
    function hv.getDist(pos1, pos2)
        local dx = pos1.X - pos2.X
        local dz = pos1.Z - pos2.Z
        return math.sqrt(dx * dx + dz * dz)
    end
    function hv.getAttacker(part)
        local ownerVal = part:FindFirstChild("Owner") or part:WaitForChild("Owner", 0.05)
        local ownerName = ownerVal and ownerVal:IsA("StringValue") and ownerVal.Value
        local lp = _LocalPlayer or Players.LocalPlayer
        if ownerName then
            local player = Players:FindFirstChild(ownerName)
            if player and player.Character then
                return player.Character, player == lp
            end
            local char = Workspace:FindFirstChild(ownerName)
            if char and char:IsA("Model") then
                return char, char.Name == (lp and lp.Name or "")
            end
        end
        local closestChar = nil
        local closestDist = 8
        for _, player in ipairs(Players:GetPlayers()) do
            local c = player.Character
            local hrp = c and c:FindFirstChild("HumanoidRootPart")
            if hrp then
                local d = hv.getDist(hrp.Position, part.Position)
                if d < closestDist then
                    closestDist = d
                    closestChar = c
                end
            end
        end
        if closestChar then
            return closestChar, closestChar.Name == (lp and lp.Name or "")
        end
        return nil, false
    end
    function hv.getForwardDist(part)
        local attackName = part:FindFirstChild("AttackName")
        if attackName and attackName:IsA("StringValue") and attackName.Value == "M2" then
            return 3.2
        end
        if part.Name:find("M2") then
            return 3.2
        end
        return 4.0
    end
    function hv.viz(p)
        if not controller.HitboxVisualizerEnabled or not p:IsA("BasePart") or p:FindFirstChild("HitboxVisualizerAdornment") then return end
        local lp = _LocalPlayer or Players.LocalPlayer
        local c = lp and lp.Character
        local h = c and c:FindFirstChild("HumanoidRootPart")
        if not h then return end
        local attackerChar, isMe = hv.getAttacker(p)
        local attackerHRP = attackerChar and attackerChar:FindFirstChild("HumanoidRootPart")
        local distToMe = (attackerHRP and (attackerHRP.Position - h.Position).Magnitude) or hv.getDist(h.Position, p.Position)
        if distToMe > 30 then return end
        local initialCF = p.CFrame
        if attackerHRP then
            if initialCF.Position.Magnitude < 0.1 then
                initialCF = attackerHRP.CFrame * CFrame.new(0, 0, -hv.getForwardDist(p))
            else
                initialCF = CFrame.new(initialCF.Position.X, attackerHRP.Position.Y, initialCF.Position.Z) * (initialCF - initialCF.Position)
            end
        end
        p.Anchored = true
        p.AssemblyLinearVelocity = Vector3.zero
        p.AssemblyAngularVelocity = Vector3.zero
        local m = Instance.new("BoolValue")
        m.Name = "HitboxVisualizerAdornment"
        m.Parent = p
        local b = Instance.new("BoxHandleAdornment")
        b.Name = "HitboxVisualizerAdornment"
        b.Adornee = Workspace.Terrain
        b.CFrame = initialCF
        b.Size = p.Size
        b.Color3 = hv.getColor(p)
        b.Transparency = 1
        b.AlwaysOnTop = true
        b.ZIndex = 5
        b.Parent = Workspace.Terrain
        table.insert(hv.adorn, b)
        local sc = p:GetPropertyChangedSignal("Size"):Connect(function()
            if b and b.Parent then b.Size = p.Size end
        end)
        table.insert(hv.conn, sc)
        task.spawn(function()
            TweenService:Create(b, TweenInfo.new(0.05, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Transparency = 0.35}):Play()
            task.wait(0.12)
            local tw = TweenService:Create(b, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Transparency = 1})
            tw:Play()
            tw.Completed:Connect(function()
                if sc and sc.Connected then sc:Disconnect() end
                if b and b.Parent then b:Destroy() end
                if m and m.Parent then m:Destroy() end
            end)
        end)
    end
    task.spawn(function()
        local hf = Workspace:WaitForChild("Hitboxes", 10)
        if hf then
            for _, ch in ipairs(hf:GetChildren()) do hv.viz(ch) end
            table.insert(hv.conn, hf.ChildAdded:Connect(hv.viz))
        end
    end)
    trackConnection("HitboxVisualizer_Cleanup", {Disconnect = function()
        if not controller.HitboxVis then return end
        for _, cn in ipairs(controller.HitboxVis.conn) do if cn and cn.Connected then cn:Disconnect() end end
        for _, bx in ipairs(controller.HitboxVis.adorn) do if bx and bx.Parent then bx:Destroy() end end
    end})
    if getgenv then
        getgenv().HitboxVisualizerCleanup = function()
            if not controller.HitboxVis then return end
            for _, cn in ipairs(controller.HitboxVis.conn) do if cn and cn.Connected then cn:Disconnect() end end
            for _, bx in ipairs(controller.HitboxVis.adorn) do if bx and bx.Parent then bx:Destroy() end end
        end
    end
end
