controller.ResolveBabyId = function(assetId)
    local strId = tostring(assetId)
    if controller.BabyConfig.ResolvedIds[strId] then return controller.BabyConfig.ResolvedIds[strId] end
    local formatted = "rbxassetid://" .. strId
    local s, objs = pcall(function() return game:GetObjects(formatted) end)
    if s and objs and objs[1] then
        local obj = objs[1]
        if obj:IsA("Animation") and obj.AnimationId ~= "" then
            controller.BabyConfig.ResolvedIds[strId] = obj.AnimationId
            return obj.AnimationId
        end
        local animChild = obj:FindFirstChildWhichIsA("Animation", true)
        if animChild and animChild.AnimationId ~= "" then
            controller.BabyConfig.ResolvedIds[strId] = animChild.AnimationId
            return animChild.AnimationId
        end
    end
    controller.BabyConfig.ResolvedIds[strId] = formatted
    return formatted
end
local safeRequireModule = function(m)
    if not m or typeof(m) ~= "Instance" then return nil end
    if getrenv and type(getrenv) == "function" then
        local ok_r, renv = pcall(getrenv)
        if ok_r and type(renv) == "table" and renv.require then
            local ok, res = pcall(renv.require, m)
            if ok and res ~= nil then return res end
        end
    end
    if type(raw_require) == "function" then
        local ok, res = pcall(raw_require, m)
        if ok and res ~= nil then return res end
    end
    local ok, res = pcall(require, m)
    if ok and res ~= nil then return res end
    return nil
end
controller.GetMovementService = function()
    if controller.MovementServiceCache then return controller.MovementServiceCache end
    local now = os.clock()
    if now < (controller.MovementServiceNextSearch or 0) then return nil end
    controller.MovementServiceNextSearch = now + 2
    controller.MovementServiceCacheAt = now
    local seen = {}
    local enumerators = {[1] = getloadedmodules, [2] = getinstances, [3] = getnilinstances}
    for index = 1, 3 do
        local enumerate = enumerators[index]
        if typeof(enumerate) == "function" then
            local listed, modules = pcall(enumerate)
            if listed and type(modules) == "table" then
                for _, m in ipairs(modules) do
                    if typeof(m) == "Instance" and m:IsA("ModuleScript") and m.Name == "MovementServiceClient" and not seen[m] then
                        seen[m] = true
                        local res = safeRequireModule(m)
                        if type(res) == "table" and typeof(res._getBaselineWalkSpeed) == "function" and typeof(res._getSprintSpeedForCharacter) == "function" then
                            controller.MovementServiceCache = res
                            return res
                        end
                    end
                end
            end
        end
    end
    controller.MovementServiceCache = nil
    return nil
end
controller.GetMovementUtils = function()
    if controller.MovementUtilsCache then return controller.MovementUtilsCache end
    local now = os.clock()
    if now < (controller.MovementUtilsNextSearch or 0) then return nil end
    controller.MovementUtilsNextSearch = now + 2
    controller.MovementUtilsCacheAt = now
    if type(getMovementUtils) == "function" then
        local mu = getMovementUtils()
        if mu then
            controller.MovementUtilsCache = mu
            return mu
        end
    end
    local seen = {}
    local enumerators = {[1] = getloadedmodules, [2] = getinstances, [3] = getnilinstances}
    for index = 1, 3 do
        local enumerate = enumerators[index]
        if typeof(enumerate) == "function" then
            local listed, modules = pcall(enumerate)
            if listed and type(modules) == "table" then
                for _, m in ipairs(modules) do
                    if typeof(m) == "Instance" and m:IsA("ModuleScript") and m.Name == "MovementServiceUtils" and not seen[m] then
                        seen[m] = true
                        local res = safeRequireModule(m)
                        if type(res) == "table" and typeof(res.GetMaxAuthorizedMoveSpeed) == "function" then
                            controller.MovementUtilsCache = res
                            return res
                        end
                    end
                end
            end
        end
    end
    return nil
end
controller.IsPlayerRunning = function(character, humanoid)
    if not character or not humanoid then return false end
    local ms = controller.GetMovementService()
    if ms then
        if ms._running == true then return true end
        if ms._sprintInputDesired == true and humanoid.MoveDirection.Magnitude > 0.05 then return true end
    end
    return character:GetAttribute("Sprinting") == true
end
controller.HookBabyMovement = function()
    local ms = controller.GetMovementService()
    local mu = controller.GetMovementUtils and controller.GetMovementUtils()
    if not ms then return false end
    local previous = controller.BabyMovementHook
    if previous and previous.service == ms and (not mu or previous.utils == mu) then return true end
    if previous then controller.UnhookBabyMovement() end
    local hook = {
        service = ms,
        utils = mu,
        rawWalk = rawget(ms, "_getBaselineWalkSpeed"),
        rawSprint = rawget(ms, "_getSprintSpeedForCharacter"),
        walk = ms._getBaselineWalkSpeed,
        sprint = ms._getSprintSpeedForCharacter,
        sprintSpeed = ms._sprintSpeed,
    }
    hook.walkWrapper = function(self, ...)
        if controller.BabySpeedModifierActive then
            return controller.BabyWalkSpeedState and tonumber(controller.BabyWalkSpeedState:get()) or 12
        end
        return hook.walk(self, ...)
    end
    hook.sprintWrapper = function(self, ...)
        if controller.BabySpeedModifierActive then
            return controller.BabySprintSpeedState and tonumber(controller.BabySprintSpeedState:get()) or 24
        end
        return hook.sprint(self, ...)
    end
    rawset(ms, "_getBaselineWalkSpeed", hook.walkWrapper)
    rawset(ms, "_getSprintSpeedForCharacter", hook.sprintWrapper)
    if mu then
        hook.rawMuWalk = rawget(mu, "GetBaseWalkSpeed")
        hook.rawMuSprint = rawget(mu, "GetSprintSpeedForCharacter")
        hook.rawMuMax = rawget(mu, "GetMaxAuthorizedMoveSpeed")
        hook.muWalk = mu.GetBaseWalkSpeed
        hook.muSprint = mu.GetSprintSpeedForCharacter
        hook.muMax = mu.GetMaxAuthorizedMoveSpeed
        hook.muWalkWrapper = function(...)
            if controller.BabySpeedModifierActive then
                return controller.BabyWalkSpeedState and tonumber(controller.BabyWalkSpeedState:get()) or 12
            end
            return hook.muWalk(...)
        end
        hook.muSprintWrapper = function(...)
            if controller.BabySpeedModifierActive then
                return controller.BabySprintSpeedState and tonumber(controller.BabySprintSpeedState:get()) or 24
            end
            return hook.muSprint(...)
        end
        hook.muMaxWrapper = function(...)
            if controller.BabySpeedModifierActive then
                local w = controller.BabyWalkSpeedState and tonumber(controller.BabyWalkSpeedState:get()) or 12
                local s = controller.BabySprintSpeedState and tonumber(controller.BabySprintSpeedState:get()) or 24
                return math.max(w, s)
            end
            return hook.muMax(...)
        end
        rawset(mu, "GetBaseWalkSpeed", hook.muWalkWrapper)
        rawset(mu, "GetSprintSpeedForCharacter", hook.muSprintWrapper)
        rawset(mu, "GetMaxAuthorizedMoveSpeed", hook.muMaxWrapper)
    end
    controller.BabyMovementHook = hook
    controller.BabyOriginalSprintSpeed = hook.sprintSpeed
    controller.FeatureDebugPush("Baby speed: native MovementServiceClient connected")
    return true
end
controller.UnhookBabyMovement = function()
    local hook = controller.BabyMovementHook
    if not hook then return end
    local ms = hook.service
    local mu = hook.utils
    if rawget(ms, "_getBaselineWalkSpeed") == hook.walkWrapper then
        rawset(ms, "_getBaselineWalkSpeed", hook.rawWalk)
    end
    if rawget(ms, "_getSprintSpeedForCharacter") == hook.sprintWrapper then
        rawset(ms, "_getSprintSpeedForCharacter", hook.rawSprint)
    end
    if mu then
        if rawget(mu, "GetBaseWalkSpeed") == hook.muWalkWrapper then
            rawset(mu, "GetBaseWalkSpeed", hook.rawMuWalk)
        end
        if rawget(mu, "GetSprintSpeedForCharacter") == hook.muSprintWrapper then
            rawset(mu, "GetSprintSpeedForCharacter", hook.rawMuSprint)
        end
        if rawget(mu, "GetMaxAuthorizedMoveSpeed") == hook.muMaxWrapper then
            rawset(mu, "GetMaxAuthorizedMoveSpeed", hook.rawMuMax)
        end
    end
    ms._sprintSpeed = hook.sprintSpeed
    controller.BabyMovementHook = nil
    controller.BabyOriginalSprintSpeed = nil
    if typeof(ms._restoreLocomotionSpeed) == "function" then
        pcall(ms._restoreLocomotionSpeed, ms)
    end
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid and ms and not ms._running then
        pcall(function() humanoid.WalkSpeed = ms:_getBaselineWalkSpeed() end)
    end
end
controller.SyncRunAnimSpeed = function(speed)
    if controller.IsBabyEmoteActive and controller.IsBabyEmoteActive(LocalPlayer.Character) then return end
    local targetSpeed = tonumber(speed) or 1.0
    if targetSpeed <= 0 then targetSpeed = 1.0 end
    local ms = controller.GetMovementService and controller.GetMovementService()
    if ms and ms._runTrack and ms._runTrack ~= controller.BabyDuoTrack then
        if math.abs((tonumber(ms._runTrack.Speed) or 1.0) - targetSpeed) > 0.05 then
            pcall(function() ms._runTrack:AdjustSpeed(targetSpeed) end)
        end
    end
    local ch = LocalPlayer.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    if hum then
        for _, t in ipairs(hum:GetPlayingAnimationTracks()) do
            if t.IsPlaying and t ~= controller.BabyDuoTrack then
                local lower = t.Name:lower()
                if lower:find("run") or lower:find("sprint") or lower:find("blend") or t.Priority == Enum.AnimationPriority.Movement then
                    if math.abs((tonumber(t.Speed) or 1.0) - targetSpeed) > 0.05 then
                        pcall(function() t:AdjustSpeed(targetSpeed) end)
                    end
                end
            end
        end
    end
end
controller.ApplyBabyMovementSpeed = function(character, humanoid, running)
    if not humanoid or not humanoid.Parent then return end
    if controller.BabyOriginalHumanoidWalkSpeed == nil then
        controller.BabyOriginalHumanoidWalkSpeed = tonumber(humanoid.WalkSpeed) or 16
    end
    if not controller.BabySpeedModifierActive then return end
    local walkSpeed = controller.BabyWalkSpeedState and tonumber(controller.BabyWalkSpeedState:get()) or 12
    local sprintSpeed = controller.BabySprintSpeedState and tonumber(controller.BabySprintSpeedState:get()) or 24
    local desired = running and sprintSpeed or walkSpeed
    local ms = controller.GetMovementService()
    if ms then
        controller.HookBabyMovement()
        pcall(function()
            ms._sprintSpeed = sprintSpeed
            ms._targetSpeed = desired
            ms._currentSpeed = desired
        end)
    end
    if desired and desired > 0 and math.abs((tonumber(humanoid.WalkSpeed) or 0) - desired) > 0.02 then
        pcall(function() humanoid.WalkSpeed = desired end)
    end
end
