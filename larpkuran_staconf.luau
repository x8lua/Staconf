local function playRestartIntermissionMusic(specificSongName, customVolume)
    local TweenService = game:GetService("TweenService")
    local RunService = game:GetService("RunService")
    local SoundService = game:GetService("SoundService")
    if _G.LarpkuranRestartMusic and _G.LarpkuranRestartMusic.Sound then
        pcall(function()
            _G.LarpkuranRestartMusic.Sound:Stop()
            _G.LarpkuranRestartMusic.Sound:Destroy()
        end)
        _G.LarpkuranRestartMusic = nil
    end
    local available = {}
    for name, data in pairs(INTERMISSION_SONGS) do
        local p = "larp/load/" .. name
        if type(isfile) == "function" and isfile(p) then
            table.insert(available, { name = name, path = p, loop = data.Loop })
        end
    end
    if #available == 0 then
        for name, data in pairs(INTERMISSION_SONGS) do
            table.insert(available, { name = name, path = "larp/load/" .. name, loop = data.Loop })
        end
    end
    local chosenName = specificSongName or _G.LarpkuranNextRestartSong
    if not chosenName then
        local body = nil
        local req = (syn and syn.request) or (http and http.request) or http_request or request
        if req then
            local ok, res = pcall(req, {
                Url = "https://api.x8stuff.lol/api/larpkuran/restart-song",
                Method = "GET"
            })
            if ok and res and (res.StatusCode == 200 or res.Status == 200) and res.Body then
                body = res.Body
            end
        end
        if not body then
            pcall(function()
                body = game:HttpGet("https://api.x8stuff.lol/api/larpkuran/restart-song")
            end)
        end
        if body then
            local pOk, data = pcall(function() return HttpService:JSONDecode(body) end)
            if pOk and data and data.song and INTERMISSION_SONGS[data.song] then
                chosenName = data.song
                _G.LarpkuranNextRestartSong = chosenName
            end
        end
    end
    local chosen
    if chosenName and INTERMISSION_SONGS[chosenName] then
        chosen = { name = chosenName, path = "larp/load/" .. chosenName, loop = INTERMISSION_SONGS[chosenName].Loop }
    else
        chosen = available[math.random(1, #available)]
    end
    if not chosen then return nil end
    _G.LarpkuranNextRestartSong = chosen.name
    if type(isfile) == "function" and not isfile(chosen.path) and type(writefile) == "function" then
        pcall(function()
            local encoded = HttpService:UrlEncode(chosen.name)
            local body = game:HttpGet("https://raw.githubusercontent.com/x8lua/scripts/main/load/" .. encoded)
            if body and #body > 1000 then writefile(chosen.path, body) end
        end)
    end
    local assetId = safeGetCustomAsset(chosen.path)
    if not assetId then return nil end
    local sound = Instance.new("Sound")
    sound.Name = "LarpkuranRestartIntermission"
    sound.SoundId = assetId
    local vol = tonumber(customVolume)
    sound.Volume = vol and math.clamp(vol, 0, 0.5) or 0.5
    sound.PlaybackSpeed = 1
    sound.Looped = false
    sound.Parent = workspace
    sound:Play()
    sound:GetPropertyChangedSignal("Volume"):Connect(function()
        if sound.Volume > 0.5 then
            sound.Volume = 0.5
        end
    end)
    local active = true
    local loopPoint = chosen.loop or 0
    local loopConn
    loopConn = sound.Ended:Connect(function()
        if not active or not sound.Parent then
            if loopConn then loopConn:Disconnect() end
            return
        end
        sound.TimePosition = loopPoint
        sound:Play()
    end)
    local loopHeartbeat
    loopHeartbeat = RunService.Heartbeat:Connect(function()
        if not active or not sound.Parent then
            if loopHeartbeat then loopHeartbeat:Disconnect() end
            return
        end
        if sound.TimeLength > 0 and sound.TimePosition >= (sound.TimeLength - 0.15) then
            sound.TimePosition = loopPoint
            if not sound.IsPlaying then sound:Play() end
        end
    end)
    local handle = {
        Sound = sound,
        Song = chosen,
        FadeOut = function(self, duration)
            active = false
            if loopConn then loopConn:Disconnect() end
            if loopHeartbeat then loopHeartbeat:Disconnect() end
            local dur = duration or 10.0
            local tween = TweenService:Create(sound, TweenInfo.new(dur, Enum.EasingStyle.Linear), { Volume = 0 })
            tween:Play()
            tween.Completed:Connect(function()
                pcall(function() sound:Stop(); sound:Destroy() end)
                if _G.LarpkuranRestartMusic and _G.LarpkuranRestartMusic.Sound == sound then
                    _G.LarpkuranRestartMusic = nil
                end
            end)
        end
    }
    _G.LarpkuranRestartMusic = handle
    return handle
end
