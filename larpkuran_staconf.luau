            if not controller.ServerProofBound then
                controller.ServerProofBound = true
                local ccre = ReplicatedStorage:WaitForChild("Shared", 3)
                ccre = ccre and ccre:WaitForChild("Network", 3)
                ccre = ccre and ccre:WaitForChild("CombatClientRemoteEvent", 3)
                if ccre then
                    trackConnection("CombatClientRemote_Proof", ccre.OnClientEvent:Connect(function(action, p1)
                        if action == "CombatM1HoldSwing" or action == "CombatM2Swing" or action == "CombatM1Response" or action == "CombatM2Response" then
                            local tChar = nil
                            if typeof(p1) == "Instance" then
                                if p1:IsA("Model") then tChar = p1 elseif p1:IsA("Player") then tChar = p1.Character end
                            elseif typeof(p1) == "string" then
                                tChar = workspace:FindFirstChild(p1) or (Players:FindFirstChild(p1) and Players:FindFirstChild(p1).Character)
                            end
                            if tChar and controller.LastServerProofTime then
                                controller.LastServerProofTime[tChar] = os.clock()
                            end
                        end
                    end))
                end
            end
        end)
        trackConnection("Enemy_AnimationPlayed_" .. (character and character.Name or "Unknown"), animator.AnimationPlayed:Connect(function(track)
            if controller.JinObserve then controller.JinObserve(character, track) end
            local dodgeActive = controller.DodgeStates and controller.DodgeStates.Enabled:get() == true
            if _G.LarpkuranRageGeneration ~= larpkuranRageGeneration or (not controller.Enabled and not dodgeActive) then return end
            local localChar = LocalPlayer.Character
            local localRoot = localChar and (localChar:FindFirstChild("HumanoidRootPart") or localChar.PrimaryPart)
            local enemyRoot = character and (character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart)
            if not localRoot or not enemyRoot then return end
            if controller.DontParryWhenNotFacing and not dodgeActive and not isFacingTarget(character) then return end
            if controller.ParryOnlyTargetState and controller.ParryOnlyTargetState:get() == true then
                local tPlayer = controller.FaceAtTarget or controller.CombatTargetPlayer or controller.TargetPlayer
                if not tPlayer then return end
                local ePlayer = Players:GetPlayerFromCharacter(character) or Players:FindFirstChild(character.Name)
                if ePlayer ~= tPlayer and character ~= tPlayer.Character then
                    return
                end
            end
            local spatial = controller.SpatialStates or controller.AutoParryStates
            local dist = (localRoot.Position - enemyRoot.Position).Magnitude
            local maxRange = math.max(tonumber(spatial and (spatial.Distance and spatial.Distance:get() or spatial.Range and spatial.Range:get())) or (tonumber(controller.Radius) or 10.5), 10.5)
            local toUs = Vector3.new(localRoot.Position.X - enemyRoot.Position.X, 0, localRoot.Position.Z - enemyRoot.Position.Z)
            local enemyLook = enemyRoot.CFrame.LookVector
            local enemyLookH = Vector3.new(enemyLook.X, 0, enemyLook.Z)
            local eVel = enemyRoot.AssemblyLinearVelocity or enemyRoot.Velocity or Vector3.zero
            local mVel = localRoot.AssemblyLinearVelocity or localRoot.Velocity or Vector3.zero
            local relVel = eVel - mVel
            local approachSpeed = toUs.Magnitude > 0.05 and math.max(0, relVel:Dot(toUs.Unit)) or 0
            local predictedDist = math.max(0, dist - (approachSpeed * 0.38))
            if dist > maxRange and predictedDist > (maxRange + 1.5) then return end
            if dist > 22 then return end
            local enemyAngVel = enemyRoot.AssemblyAngularVelocity or enemyRoot.RotVelocity or Vector3.zero
            local isSpinning = math.abs(enemyAngVel.Y) > 2.5
            if dist > 10 and not isSpinning and approachSpeed < 4 and toUs.Magnitude > 0.1 and enemyLookH.Magnitude > 0.1 then
                local enemyFacingDot = enemyLookH.Unit:Dot(toUs.Unit)
                if enemyFacingDot < 0.15 then return end
            end
            local maxHeight = tonumber(spatial and (spatial.VerticalLimit and spatial.VerticalLimit:get() or spatial.MaxHeightDiff and spatial.MaxHeightDiff:get())) or 12
            if math.abs(enemyRoot.Position.Y - localRoot.Position.Y) > maxHeight then return end
            local maxCone = tonumber(spatial and (spatial.Cone and spatial.Cone:get() or spatial.FOV and spatial.FOV:get())) or 360
            if maxCone < 360 then
                local look = localRoot.CFrame.LookVector
                local lookH = Vector3.new(look.X, 0, look.Z)
                local toEnemyH = Vector3.new(enemyRoot.Position.X - localRoot.Position.X, 0, enemyRoot.Position.Z - localRoot.Position.Z)
                if lookH.Magnitude > 0.001 and toEnemyH.Magnitude > 0.001 then
                    local dot = math.clamp(lookH.Unit:Dot(toEnemyH.Unit), -1, 1)
                    local angle = math.deg(math.acos(dot))
                    if angle > (maxCone / 2) then return end
                end
            end
            local animation = track.Animation
            local id = animation and string.match(animation.AnimationId, "%d+")
            local attack = id and attacks[id]
            if not attack and animation then
                local animName = tostring(animation.Name or track.Name or "")
                if not (animName:find("EHit") or animName:find("Hit") or animName:find("Block") or animName:find("Guardbreak") or animName:find("Stun") or animName:find("Downed") or animName:find("Ragdoll") or animName:find("Miss") or animName:find("Success")) then
                    local combo = tonumber(string.match(animName, "^(%d+)"))
                    local heavy = string.find(animName, "M2") ~= nil or string.find(animName:lower(), "heavy") ~= nil
                    local isM1 = string.find(animName, "M1") ~= nil
                    local isWcId = (id == "94976161225956" or id == "130903067566077" or id == "139503477666199" or id == "135699957281468")
                    if isWcId and not combo then
                        if id == "94976161225956" then combo = 1
                        elseif id == "130903067566077" then combo = 2
                        elseif id == "139503477666199" then combo = 3
                        elseif id == "135699957281468" then combo = 4
                        end
                        isM1 = true
                    end
                    if heavy or (combo and isM1) then
                        local detectedStyle = nil
                        pcall(function()
                            local animUtils = ReplicatedStorage:FindFirstChild("Shared") and ReplicatedStorage.Shared:FindFirstChild("Utils") and ReplicatedStorage.Shared.Utils:FindFirstChild("CombatAnimationUtils")
                            if animUtils then
                                local animMod = require(animUtils)
                                if animMod and animMod.GetCombatStyleForCharacter then
                                    detectedStyle = animMod.GetCombatStyleForCharacter(character)
                                end
                            end
                        end)
                        local pData = character:FindFirstChild("PlayerData")
                        local pStyle = pData and (pData:GetAttribute("CombatStyle") or pData:GetAttribute("Style"))
                        local style = (isWcId or (pStyle and tostring(pStyle):lower():find("wing"))) and "WingChun"
                            or detectedStyle or character:GetAttribute("FightStyle") or character:GetAttribute("Style") or character:GetAttribute("CombatStyle") or pStyle or "Default"
                        local styleKey = tostring(style)
                        for k in pairs(windups) do
                            if k:lower() == styleKey:lower() then styleKey = k break end
                        end
                        local timing = windups[styleKey] or windups["Default"] or windups["Basic"]
                        local windup = timing and (heavy and timing.M2 or (timing.M1 and timing.M1[combo])) or (heavy and 0.537 or 0.352)
                        local multiDelays = (styleKey:lower() == "boxing" and heavy) and {0.585, 1.035} or (timing and timing.M2Multi and heavy and timing.M2Multi) or (styleKey:lower() == "mishima" and heavy) and {0.4287, 0.962} or (styleKey:lower() == "jin" and heavy) and {0.292, 0.842} or nil
                        local finalWindup = (styleKey:lower() == "boxing" and heavy) and 0.585 or windup
                        attack = {
                            Name = styleKey .. "." .. (heavy and (animName ~= "" and animName or "M2") or ("M1_" .. tostring(combo or 1))),
                            Windup = finalWindup,
                            Heavy = heavy,
                            Style = styleKey,
                            Combo = combo or 1,
                            MultiDelays = multiDelays,
                        }
                        if id then attacks[id] = attack end
                    end
                end
            end
            if not attack then return end
            parry(character, attack, track.Speed, track.TimePosition, track)
        end))
    end)
end
