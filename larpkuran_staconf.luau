        if keyName == "MouseButton1" then return Enum.UserInputType.MouseButton1 end
        if keyName == "MouseButton2" then return Enum.UserInputType.MouseButton2 end
        if keyName == "MouseButton3" then return Enum.UserInputType.MouseButton3 end
