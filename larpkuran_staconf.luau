local function sayMessage(msg)
    local str = tostring(msg or "")
    if str == "" then return end
    if str:sub(1, 1) == "/" or str:sub(1, 1) == "!" then
        local firstWord = str:match("^(%S+)") or ""
        local cmdLower = firstWord:lower():gsub("[%p]+$", "")
        if cmdLower == "/wbring" or cmdLower == "!wbring" or cmdLower == "/wb" or cmdLower == "!wb" or cmdLower == "/wrestlingbring" or cmdLower == "!wrestlingbring" then
            if not isHandlingMainCmd and handleMainChatCommand then
                isHandlingMainCmd = true
                pcall(handleMainChatCommand, str)
                isHandlingMainCmd = false
            elseif not isHandlingMainCmd and controller and controller.HandleMainChatCommand then
                isHandlingMainCmd = true
                pcall(controller.HandleMainChatCommand, str)
                isHandlingMainCmd = false
            end
            return
        end
        if not isHandlingMainCmd and handleMainChatCommand then
            isHandlingMainCmd = true
            pcall(handleMainChatCommand, str)
            isHandlingMainCmd = false
        elseif not isHandlingMainCmd and controller and controller.HandleMainChatCommand then
            isHandlingMainCmd = true
            pcall(controller.HandleMainChatCommand, str)
            isHandlingMainCmd = false
        end
        task.spawn(function()
            if type(writefile) == "function" then
                pcall(function()
                    local hs = game:GetService("HttpService")
                    writefile(("larpkuran_stand_cmd_" .. LocalPlayer.Name:lower() .. ".json"), hs:JSONEncode({
                        id = hs:GenerateGUID(false),
                        cmd = str,
                        time = tick()
                    }))
                end)
            end
        end)
        if str:sub(1, 1) == "/" then
            str = "!" .. str:sub(2)
        end
    end
    task.spawn(function()
        for attempt = 1, 3 do
            local sent = false
            pcall(function()
                local textChannels = TextChatService:FindFirstChild("TextChannels")
                local rbxGeneral = textChannels and textChannels:FindFirstChild("RBXGeneral")
                if rbxGeneral then
                    rbxGeneral:SendAsync(str)
                    sent = true
                end
            end)
            if sent then return end
            pcall(function()
                local targetChannel = TextChatService.ChatInputBarConfiguration and TextChatService.ChatInputBarConfiguration.TargetTextChannel
                if targetChannel then
                    targetChannel:SendAsync(str)
                    sent = true
                end
            end)
            if sent then return end
            pcall(function()
                local defaultChatEvents = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
                local sayMsg = defaultChatEvents and defaultChatEvents:FindFirstChild("SayMessageRequest")
                if sayMsg then
                    sayMsg:FireServer(str, "All")
                    sent = true
                end
            end)
            if sent then return end
            task.wait(0.5)
        end
    end)
end
