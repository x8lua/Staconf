local function isSenderAuthorized(sender)
    if not sender then return false end
    if sender == localPlayer then return true end
    if isRealOwner(sender) then return true end
    if currentMaster and sender == currentMaster then return true end
    if standAdmins[sender.UserId] or standAdmins[sender.Name:lower()] then return true end
    return false
end
local function anim2track(asset_id)
    local success, objs = pcall(function()
        return game:GetObjects(asset_id)
    end)
    if success and objs then
        for i = 1, #objs do
            if objs[i]:IsA("Animation") then
                return objs[i].AnimationId
            end
        end
    end
    return asset_id
end
local function handleChat(sender, message)
    if not isRunning or typeof(message) ~= "string" then
        return
    end
    if not isSenderAuthorized(sender) then
        return
    end
    local isOwner = isRealOwner(sender)
    local cleaned = message:match("^[\"']?(.-)[\"']?$") or message
    cleaned = cleaned:gsub("^%s*(.-)%s*$", "%1")
    local firstChar = cleaned:sub(1, 1)
    if firstChar ~= "/" and firstChar ~= "!" then
        return
    end
    local now = os.clock()
    local isDtHitCmd = cleaned:sub(1, 6) == "/dthit" or cleaned:sub(1, 6) == "!dthit"
    if not isDtHitCmd and cleaned == lastCommandStr and (now - lastCommandTime) < 0.4 then
        return
    end
    lastCommandStr = cleaned
    lastCommandTime = now
    local split = string.split(cleaned, " ")
    local rawCmd = string.lower(split[1] or "")
    local cmd = rawCmd:gsub("[%p]+$", "")
    if cmd == "" then cmd = rawCmd end
    local targetQueryCandidate = table.concat(split, " ", 2):gsub("^%s*(.-)%s*$", "%1")
    if cmd == "/unpair" or cmd == "!unpair" then
        if sender ~= localPlayer and not isRealOwner(sender) then return end
        if targetQueryCandidate ~= "" and targetQueryCandidate:lower() ~= localPlayer.Name:lower() then return end
        local saved = clearLarpkuranPairing(localPlayer.Name)
        MAIN_USERNAME = ""
        currentMaster = nil
        mainPlayer = nil
        table.clear(standAdmins)
        stopScript()
        if not saved then warn("[Stand] Unpaired this session; persistent files could not all be cleared.") end
        return
    end
    local isStandTargetCmd = (cmd == "/stand" or cmd == "!stand") and (targetQueryCandidate ~= "" and targetQueryCandidate ~= "me" and targetQueryCandidate ~= "reset" and targetQueryCandidate ~= "main")
    if isOwner and not isStandTargetCmd then
        if cmd == "/s" or cmd == "!s" or cmd == "/summon" or cmd == "!summon" or cmd == "/stand" or cmd == "!stand" or cmd == "/bring" or cmd == "!bring" or cmd == "/tp" or cmd == "!tp" then
            if GoonState.stop then GoonState.stop() end
            if currentMaster ~= (mainPlayer or sender) then
                currentMaster = mainPlayer or sender
                lastTrackedMaster = currentMaster
                lastMainHealth = currentMaster.Character and currentMaster.Character:FindFirstChildOfClass("Humanoid") and currentMaster.Character:FindFirstChildOfClass("Humanoid").Health or 100
                isRetaliating = false
                currentRetaliateTarget = nil
            end
        end
        if currentCommandSender and not isRealOwner(currentCommandSender) then
            if isRageActive or isGrabActive or isStompActive or isSayActive or isRetaliating or isYeetActive or isSaveActive or isBlockGuardActive then
                stopRagepunch()
                isGrabActive = false
                isStompActive = false
                isSayActive = false
                isRetaliating = false
                isYeetActive = false
                isSaveActive = false
                stopBlockGuard()
                currentSayTarget = nil
                currentRetaliateTarget = nil
                currentStompTarget = nil
                currentYeetTarget = nil
