    local hardSnap = trackingStates and (trackingStates.ImpactSnap and trackingStates.ImpactSnap:get() == true or trackingStates.HardSnap and trackingStates.HardSnap:get() == true)
    local rotSpeed = math.clamp(tonumber(trackingStates and (trackingStates.Smoothness and trackingStates.Smoothness:get() or trackingStates.Speed and trackingStates.Speed:get())) or 0.80, 0.05, 1)
    local isNewTarget = (controller.LastFacedCharacter ~= character)
