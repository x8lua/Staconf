local function localizeString(str: string?): string?
    if type(str) ~= "string" then return str end
    local curLang = _G.LarpkuranLanguage or "English"
    if curLang ~= "ZH-TW" then return str end
    local exact = I18N_ZH_TW[str]
    if exact then return exact end
    for prefix, rep in pairs(I18N_PREFIXES) do
        local plen = #prefix
        if str:sub(1, plen) == prefix then
            return rep .. str:sub(plen + 1)
        end
    end
    return str
end
_G.LarpkuranLocalize = localizeString
end
