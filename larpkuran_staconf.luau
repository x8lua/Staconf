controller.FeatureAnimationTracks = controller.FeatureAnimationTracks or setmetatable({}, {__mode = 'k'})
controller.LoadFeatureAnimation = function(character, name, animationId, looped)
    if not character then
        controller.FeatureDebugPush('ERROR: animation character missing')
        return nil
    end
    local rawId = tostring(animationId or ''):gsub('%s+', '')
    local numericId = rawId:match('%d+')
    local normalizedId = rawId
    if numericId and not rawId:match('^rbxassetid://') then
        normalizedId = 'rbxassetid://' .. numericId
    end
    local trackName = tostring(name or 'LarpkuranFeatureAnimation')
    controller.FeatureDebugPush(string.format('Load request: %s | %s', trackName, normalizedId))
    local humanoid = character:FindFirstChildOfClass('Humanoid')
    if not humanoid then
        controller.FeatureDebugPush('ERROR: Humanoid not found')
        return nil
    end
    local perCharacter = controller.FeatureAnimationTracks[character]
    if not perCharacter then
        perCharacter = {}
        controller.FeatureAnimationTracks[character] = perCharacter
    end
    local cacheKey = trackName .. '|' .. normalizedId
    local cached = perCharacter[cacheKey]
    if cached and cached.Animation and cached.Animation.AnimationId == normalizedId then
        cached.Looped = looped ~= false
        controller.FeatureDebugPush('Reused cached AnimationTrack')
        return cached
    end
    for _, existing in ipairs(humanoid:GetPlayingAnimationTracks()) do
        local existingId = existing.Animation and existing.Animation.AnimationId
        if existing and existingId == normalizedId then
            existing.Name = trackName
            existing.Looped = looped ~= false
            perCharacter[cacheKey] = existing
            controller.FeatureDebugPush('Reused existing AnimationTrack')
            return existing
        end
    end
    local handler = controller.GetAnimationHandler()
    if handler and typeof(handler.LoadAnim) == 'function' then
        local ok, track = pcall(handler.LoadAnim, character, trackName, normalizedId, nil, true)
        if ok and track then
            track.Name = trackName
            track.Looped = looped ~= false
            perCharacter[cacheKey] = track
            controller.FeatureDebugPush('Loaded through AnimationHandler.LoadAnim')
            return track
        end
        controller.FeatureDebugPush('AnimationHandler.LoadAnim failed; using native Animator fallback')
    else
        controller.FeatureDebugPush('AnimationHandler unavailable; using native Animator fallback')
    end
    local animator = humanoid:FindFirstChildOfClass('Animator') or humanoid:FindFirstChild('Animator')
    if not animator then
        controller.FeatureDebugPush('Animator missing; creating Animator')
        local ok, created = pcall(function()
            local a = Instance.new('Animator')
            a.Parent = humanoid
            return a
        end)
        if ok then animator = created end
    end
    local animation = Instance.new('Animation')
    animation.Name = trackName
    animation.AnimationId = normalizedId
    local track, source
    if animator then
        local ok, result = pcall(function() return animator:LoadAnimation(animation) end)
        if ok and result then
            track, source = result, 'Animator:LoadAnimation'
        end
    end
    if not track then
        local ok, result = pcall(function() return humanoid:LoadAnimation(animation) end)
        if ok and result then
            track, source = result, 'Humanoid:LoadAnimation'
        end
    end
    if not track then
        pcall(function() animation:Destroy() end)
        controller.FeatureDebugPush('ERROR: native animation loaders failed')
        return nil
    end
    track.Name = trackName
    track.Looped = looped ~= false
    perCharacter[cacheKey] = track
    controller.FeatureDebugPush('Loaded through ' .. source)
    return track
end
