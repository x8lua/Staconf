controller.IsOtherPlayerPart = function(hit, myChar)
    if not hit or not hit.Parent then return nil end
    local otherChar = hit.Parent
    if otherChar:IsA("Accessory") or otherChar:IsA("Tool") then
        otherChar = otherChar.Parent
    end
    if not otherChar or otherChar == myChar then return nil end
    local otherHum = otherChar:FindFirstChildOfClass("Humanoid")
    if not otherHum or otherHum.Health <= 0 then return nil end
    local otherPlayer = Players:GetPlayerFromCharacter(otherChar)
    if otherPlayer and otherPlayer ~= LocalPlayer then
        return otherChar
    end
    if not otherPlayer and otherHum then
        return otherChar
    end
    return nil
end
controller.CheckPlayerContact = function(char)
    local myHRP = char:FindFirstChild("HumanoidRootPart")
    if not myHRP then return false, false end
    local myHead = char:FindFirstChild("Head")
    local checkStompParts = controller.BabyTrippingStunned and {myHead, myHRP} or {myHead}
    local isTouching = false
    local isSteppingOn = false
    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer ~= LocalPlayer and otherPlayer.Character then
            local oc = otherPlayer.Character
            local ohum = oc:FindFirstChildOfClass("Humanoid")
            local ohrp = oc:FindFirstChild("HumanoidRootPart")
            if ohum and ohum.Health > 0 and ohrp then
                for _, myPart in ipairs(checkStompParts) do
                    if myPart then
                        local dx = ohrp.Position.X - myPart.Position.X
                        local dz = ohrp.Position.Z - myPart.Position.Z
                        local horizDist = math.sqrt(dx * dx + dz * dz)
                        local dy = ohrp.Position.Y - myPart.Position.Y
                        if horizDist <= 2.2 and dy >= 0.1 and dy <= 4.8 then
                            isSteppingOn = true
                            isTouching = true
                            break
                        end
                    end
                end
                if not isTouching then
                    local dx = ohrp.Position.X - myHRP.Position.X
                    local dy = math.abs(ohrp.Position.Y - myHRP.Position.Y)
                    local dz = ohrp.Position.Z - myHRP.Position.Z
                    local horizDist = math.sqrt(dx * dx + dz * dz)
                    if horizDist <= 2.8 and dy <= 3.5 then
                        isTouching = true
                    end
                end
                if isSteppingOn then break end
            end
        end
    end
    return isTouching, isSteppingOn
end
controller.ApplyBabyTripping = function(char)
    if not controller.BabyTrippingActive or not char then return end
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    local hum = char:WaitForChild("Humanoid", 5)
    if not hrp or not hum then return end
    controller.BabyTrippingStunned = false
    local tripStartTime = 0
    local unstepStartTime = 0
    local lastGetUpTime = 0
    local lastAttemptTime = 0
    local wasSteppedOn = false
    local touchedThisFrame = false
    hum.PlatformStand = false
    local function attemptTrip()
        if not controller.BabyTrippingActive or hum.Health <= 0 then return end
        if os.clock() - lastGetUpTime < 0.4 then return end
        if controller.BabyTrippingStunned then return end
        local now = os.clock()
        if now - lastAttemptTime < 0.5 then return end
        lastAttemptTime = now
        local tripChance = controller.BabyTripChanceState and tonumber(controller.BabyTripChanceState:get())
        if tripChance == nil then tripChance = 100 end
        if tripChance < 100 then
            if tripChance <= 0 or math.random(1, 100) > tripChance then
                return
            end
        end
        controller.BabyTrippingStunned = true
        tripStartTime = now
        unstepStartTime = 0
        hum.PlatformStand = true
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.FallingDown) end)
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.PlatformStanding) end)
        if hrp and hrp.Parent then
            pcall(function()
                hrp.AssemblyLinearVelocity = hrp.CFrame.LookVector * 10 + Vector3.new(0, -6, 0)
            end)
        end
    end
    local function hookPart(part)
        if part:IsA("BasePart") then
            local touchConn = part.Touched:Connect(function(hit)
                if not controller.BabyTrippingActive or not hit or not hit.Parent then return end
                local otherChar = controller.IsOtherPlayerPart(hit, char)
                if otherChar then
                    touchedThisFrame = true
                    attemptTrip()
                end
            end)
            table.insert(controller.BabyTrippingConnections, touchConn)
        end
    end
    for _, p in ipairs(char:GetDescendants()) do
        hookPart(p)
    end
    local descConn = char.DescendantAdded:Connect(hookPart)
    table.insert(controller.BabyTrippingConnections, descConn)
    local psConn = hum:GetPropertyChangedSignal("PlatformStand"):Connect(function()
        if controller.BabyTrippingActive and controller.BabyTrippingStunned and not hum.PlatformStand then
            hum.PlatformStand = true
        end
    end)
    table.insert(controller.BabyTrippingConnections, psConn)
    local TRIP_DURATION = 1.0
    local hbConn = RunService.Heartbeat:Connect(function()
        if not controller.BabyTrippingActive or not char.Parent or not hum or hum.Health <= 0 then return end
        local isTouching, isSteppingOn = controller.CheckPlayerContact(char)
        if touchedThisFrame then
            isTouching = true
            touchedThisFrame = false
        end
        if not isTouching and not isSteppingOn then
            if os.clock() - lastAttemptTime >= 0.2 then
                lastAttemptTime = 0
            end
        end
        if isTouching and not controller.BabyTrippingStunned and (os.clock() - lastGetUpTime >= 0.4) then
            attemptTrip()
        end
        if isSteppingOn then
            if not controller.BabyTrippingStunned and (os.clock() - lastGetUpTime >= 0.4) then
                attemptTrip()
            end
            if controller.BabyTrippingStunned then
                wasSteppedOn = true
                unstepStartTime = 0
                if not hum.PlatformStand then
                    hum.PlatformStand = true
                end
                if hum:GetState() ~= Enum.HumanoidStateType.PlatformStanding and hum:GetState() ~= Enum.HumanoidStateType.FallingDown then
                    pcall(function() hum:ChangeState(Enum.HumanoidStateType.PlatformStanding) end)
                end
            end
        else
            if wasSteppedOn then
                wasSteppedOn = false
                unstepStartTime = os.clock()
            end
            if controller.BabyTrippingStunned then
                if not hum.PlatformStand then
                    hum.PlatformStand = true
                end
                if hum:GetState() ~= Enum.HumanoidStateType.PlatformStanding and hum:GetState() ~= Enum.HumanoidStateType.FallingDown then
                    pcall(function() hum:ChangeState(Enum.HumanoidStateType.PlatformStanding) end)
                end
                local canGetUp = false
                if unstepStartTime > 0 then
                    if os.clock() - unstepStartTime >= TRIP_DURATION then
                        canGetUp = true
                    end
                else
                    if os.clock() - tripStartTime >= TRIP_DURATION then
                        canGetUp = true
                    end
                end
                if canGetUp then
                    controller.BabyTrippingStunned = false
                    tripStartTime = 0
                    unstepStartTime = 0
                    wasSteppedOn = false
                    lastGetUpTime = os.clock()
                    hum.PlatformStand = false
                    pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
                end
            end
        end
        if not controller.BabyTrippingStunned and hum.PlatformStand then
            hum.PlatformStand = false
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        end
    end)
    table.insert(controller.BabyTrippingConnections, hbConn)
end
controller.StopBabyTripping = function()
    if controller.BabyTrippingConnections then
        for _, c in ipairs(controller.BabyTrippingConnections) do
            pcall(function() c:Disconnect() end)
        end
        table.clear(controller.BabyTrippingConnections)
    else
        controller.BabyTrippingConnections = {}
    end
    controller.BabyTrippingStunned = false
    controller.BabyTrippingUnstepStartTime = 0
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.PlatformStand = false
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        end
    end
end
