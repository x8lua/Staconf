        end
        local animator = (humanoid and humanoid:IsA("Humanoid")) and (humanoid:FindFirstChildOfClass("Animator") or humanoid:WaitForChild("Animator", 4))
        if not animator or _G.LarpkuranRageGeneration ~= larpkuranRageGeneration then return end
