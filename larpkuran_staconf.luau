    controller.SetKeybind = function(bindKey, newKey)
        if not controller.Keybinds then controller.Keybinds = {} end
        controller.Keybinds[bindKey] = newKey
        if not config.Keybinds then config.Keybinds = {} end
        config.Keybinds[bindKey] = newKey
