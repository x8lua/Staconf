        elseif bindKey == "Interact" then
            applyInteractKey(newKey)
        elseif bindKey == "Phone" then
            updatePhoneKeybindBlocker()
        elseif bindKey == "Carry" or bindKey == "Grip" then
            syncKnockedConstants()
            if cachedDesktopInputsTable and cachedDesktopInputsTable._bindDesktopInputs then
                pcall(function() cachedDesktopInputsTable:_bindDesktopInputs() end)
