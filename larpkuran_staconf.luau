        local target = combat and (combat:FindFirstChild(localStyle .. "Anims") or combat:FindFirstChild(localStyle))
        if target then table.insert(targets, target) end
    end
    if #targets == 0 then controller.FakeStyleStatus = "Local combat style folder not found"; return end
    for _, target in ipairs(targets) do
        for _, animation in ipairs(target:GetDescendants()) do
            if animation:IsA("Animation") then
