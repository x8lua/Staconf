local function onB2BComboChanged(value, reason)
    if _G.LarpkuranRageGeneration ~= larpkuranRageGeneration then return end
    local numeric = math.clamp(math.floor(tonumber(value) or 0), 0, 999)
    controller.ComboCount = numeric
    if numeric <= 0 or reason == "expired" or reason == "reset" or reason == "destroyed" then
        controller.ComboLastHitAt = 0
