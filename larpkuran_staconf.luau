local function restoreDefaultMovementTracks(animator)
    if not animator then return end
    local movementTracks = 0
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        if fakeStyleTrackGroup(track) == "movement"
            or track.Priority == Enum.AnimationPriority.Core
            or track.Priority == Enum.AnimationPriority.Movement then
            movementTracks += 1
            if (track.WeightCurrent or 0) <= 0.01 then pcall(function() track:AdjustWeight(1, 0.05) end) end
        end
    end
    if movementTracks == 0 then restartDefaultAnimate(animator.Parent and animator.Parent.Parent) end
end
