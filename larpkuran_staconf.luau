    local function applyCasAction(actionName)
        local def = CAS_ACTIONS[actionName]
        local cb = actionCallbacks[actionName]
        if not def then return end
        local unbind = ContextActionService.UnbindAction
        local bind = ContextActionService.BindAction
        local bindPriority = ContextActionService.BindActionAtPriority
        local customKeyStr = (controller.Keybinds and controller.Keybinds[def.configKey]) or def.defaultKey
        local isDefault = (customKeyStr == def.defaultKey)
        if isDefault then
            if (actionName == "Carry" or actionName == "Grip") and cachedDesktopInputsTable and cachedDesktopInputsTable._bindDesktopInputs then
                pcall(function() cachedDesktopInputsTable:_bindDesktopInputs() end)
            end
            return
        end
        if not cb then return end
        unbind(ContextActionService, actionName)
        if actionName == "M1Input" then
            bind(ContextActionService, actionName, cb, false, Enum.UserInputType.MouseButton1, def.gamepad)
            return
        end
        local resolved = resolveInput(customKeyStr)
        if not resolved then return end
        if def.priority and def.priority > 2000 then
            if def.gamepad then
                bindPriority(ContextActionService, actionName, cb, false, def.priority, resolved, def.gamepad)
            else
                bindPriority(ContextActionService, actionName, cb, false, def.priority, resolved)
            end
        else
            if def.gamepad then
                bind(ContextActionService, actionName, cb, false, resolved, def.gamepad)
            else
                bind(ContextActionService, actionName, cb, false, resolved)
            end
        end
    end
