controller.TriggerGripDeathCamera = function(character)
    if not character then return end
    local root = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart or rootOf(character)
    local camera = workspace.CurrentCamera
    if not root or not camera then return end
    controller.RestoreCamera(character)
    local lighting = game:GetService("Lighting")
    local effect = Instance.new("ColorCorrectionEffect")
    effect.Name = "LocalDeathCameraEffect"
    effect.Saturation = -1
    effect.Parent = lighting
    controller.DeathCameraEffect = effect
    task.spawn(function()
        local asset = safeGetCustomAsset("larp/death.mp3")
        if asset then
            pcall(function()
                local sound = Instance.new("Sound")
                sound.Name = "ReviverDeath"
                sound.SoundId = asset
                sound.Volume = 1
                sound.Parent = game:GetService("SoundService")
                sound:Play()
                game:GetService("Debris"):AddItem(sound, 10)
            end)
        end
    end)
    local startCFrame = camera.CFrame
    local startedAt = os.clock()
    local direction = startCFrame.LookVector
    local bodyPosition = root.Position
    camera.CameraType = Enum.CameraType.Scriptable
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {character}
    rayParams.IgnoreWater = true
    local maxUpHeight = 28
    local roofHit = workspace:Raycast(bodyPosition + Vector3.new(0, 3, 0), Vector3.new(0, 30, 0), rayParams)
    if roofHit and roofHit.Instance and roofHit.Instance.CanCollide then
        maxUpHeight = math.clamp(roofHit.Distance + 3 - 1.5, 4, 28)
    end
    local backward = Vector3.new(-direction.X, 0, -direction.Z)
    backward = backward.Magnitude < 0.001 and Vector3.new(0, 0, 1) or backward.Unit
    local targetPos = bodyPosition + backward * 12 + Vector3.new(0, maxUpHeight, 0)
    if controller.DeathCameraConnection then pcall(function() controller.DeathCameraConnection:Disconnect() end) end
    controller.DeathCameraConnection = RunService.RenderStepped:Connect(function()
        local currentChar = LocalPlayer.Character
        if currentChar and currentChar ~= character and currentChar:FindFirstChild("HumanoidRootPart") then
            controller.RestoreCamera(currentChar)
            return
        end
        local elapsed = os.clock() - startedAt
        if elapsed > 8 then
            controller.RestoreCamera(currentChar)
            return
        end
        local alpha = math.clamp(elapsed / 1.4, 0, 1)
        local current = startCFrame.Position:Lerp(targetPos, alpha)
        local look = bodyPosition - current
        look = look.Magnitude < 0.001 and Vector3.new(0, -1, 0) or look.Unit
        camera.CFrame = CFrame.lookAt(current, current + look)
    end)
end
