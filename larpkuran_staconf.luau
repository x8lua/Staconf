controller.SetBabySpeedModifier = function(enable)
    controller.BabySpeedModifierActive = enable
    if controller.BabySpeedModifierState and controller.BabySpeedModifierState:get() ~= enable then
        controller.BabySpeedModifierState:set(enable)
    end
    local ms = controller.GetMovementService()
    if enable then
        controller.HookBabyMovement()
        local customSprintSpeed = controller.BabySprintSpeedState and tonumber(controller.BabySprintSpeedState:get()) or 24
        local customWalkSpeed = controller.BabyWalkSpeedState and tonumber(controller.BabyWalkSpeedState:get()) or 12
        local ch = LocalPlayer.Character
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        local isRun = controller.IsPlayerRunning(ch, hum)
        local targetSpeed = isRun and customSprintSpeed or customWalkSpeed
        if ms then
            ms._sprintSpeed = customSprintSpeed
            ms._targetSpeed = targetSpeed
            ms._currentSpeed = targetSpeed
        end
        if hum then
            controller.ApplyBabyMovementSpeed(ch, hum, isRun)
        end
        if not controller.SpeedModifierHeartbeatConn then
            controller.SpeedModifierHeartbeatConn = RunService.Heartbeat:Connect(function()
                if not controller.BabySpeedModifierActive then return end
                local liveChar = LocalPlayer.Character
                local liveHum = liveChar and liveChar:FindFirstChildOfClass("Humanoid")
                if not liveChar or not liveHum or liveHum.Health <= 0 then return end
                local isStunned = liveChar:GetAttribute("Stunned") == true or liveChar:GetAttribute("CantAnything") == true or liveChar:GetAttribute("CombatRecovery") == true
                if isStunned and (not speedOfHit or speedOfHit.enabledState:get() ~= true) then return end
                local liveRun = controller.IsPlayerRunning(liveChar, liveHum)
                controller.ApplyBabyMovementSpeed(liveChar, liveHum, liveRun)
                if not controller.BabyActive then
                    local runSpeedMult = controller.BabyRunSpeedState and tonumber(controller.BabyRunSpeedState:get()) or 1.6
                    if liveRun then
                        controller.SyncRunAnimSpeed(runSpeedMult)
                    else
                        controller.SyncRunAnimSpeed(1.0)
                    end
                end
            end)
        end
        if not controller.SpeedModifierCharConn then
            controller.SpeedModifierCharConn = LocalPlayer.CharacterAdded:Connect(function(newChar)
                if controller.BabySpeedModifierActive then
                    task.wait(0.3)
                    local newHum = newChar:WaitForChild("Humanoid", 5)
                    if newHum and controller.BabySpeedModifierActive then
                        controller.HookBabyMovement()
                        local newRun = controller.IsPlayerRunning(newChar, newHum)
                        controller.ApplyBabyMovementSpeed(newChar, newHum, newRun)
                    end
                end
            end)
        end
    else
        if controller.SpeedModifierHeartbeatConn then
            pcall(function() controller.SpeedModifierHeartbeatConn:Disconnect() end)
            controller.SpeedModifierHeartbeatConn = nil
        end
        if ms then
            controller.RestoreBabyHumanoidSpeed()
            if controller.BabyOriginalSprintSpeed then
                ms._sprintSpeed = controller.BabyOriginalSprintSpeed
                if ms._running then
                    ms._targetSpeed = controller.BabyOriginalSprintSpeed
                end
            end
            if not ms._running and ms._restoreLocomotionSpeed then
                pcall(function() ms:_restoreLocomotionSpeed() end)
            end
        end
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            for _, t in ipairs(humanoid:GetPlayingAnimationTracks()) do
                if not t.Name:find("Short") and not t.Name:find("Tall") then
                    pcall(function() t:AdjustSpeed(1) end)
                end
            end
        end
        if ms and ms._runTrack then
            pcall(function() ms._runTrack:AdjustSpeed(1) end)
        end
        controller.SyncRunAnimSpeed(1.0)
        if not controller.BabyActive then
            controller.UnhookBabyMovement()
        end
    end
end
controller.StopBaby = function()
    if controller.BabyEmoteBlendCleanup then controller.BabyEmoteBlendCleanup(); controller.BabyEmoteBlendCleanup = nil end
    if controller.BabyDuoCleanup then controller.BabyDuoCleanup() end
    pcall(function()
        if getgenv().GakuranShortConn then
            getgenv().GakuranShortConn:Disconnect()
            getgenv().GakuranShortConn = nil
        end
    end)
    pcall(function()
        if getgenv().GakuranWaistConn then
            getgenv().GakuranWaistConn:Disconnect()
            getgenv().GakuranWaistConn = nil
        end
    end)
    if controller.BabyConnections then
        for _, c in ipairs(controller.BabyConnections) do
            pcall(function() c:Disconnect() end)
        end
        table.clear(controller.BabyConnections)
    else
        controller.BabyConnections = {}
    end
    if not controller.BabySpeedModifierActive then
        controller.UnhookBabyMovement()
    end
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if hrp and controller.BabyCurrentPhysicalY and controller.BabyCurrentPhysicalY ~= 0 then
        pcall(function()
            hrp.CFrame = hrp.CFrame * CFrame.new(0, -controller.BabyCurrentPhysicalY, 0)
        end)
        controller.BabyCurrentPhysicalY = 0
    end
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local AH = controller.GetAnimationHandler()
    if AH and typeof(AH.StopAnim) == "function" then
        pcall(function()
            AH.StopAnim(character, "AlwaysShortIdle")
            AH.StopAnim(character, "AlwaysShortWalk")
            AH.StopAnim(character, "AlwaysShortRunBlend")
            AH.StopAnim(character, "AlwaysShortDance")
        end)
    end
    if humanoid then
        for _, t in ipairs(humanoid:GetPlayingAnimationTracks()) do
            if t.Name:find("Short") or t.Name:find("Tall") then
                pcall(function() t:Stop(0.15) end)
            elseif t.Speed ~= 1 then
                pcall(function() t:AdjustSpeed(1) end)
            end
        end
    end
    controller.SyncRunAnimSpeed(1.0)
end
controller.GetActiveDanceTrack = function(character, humanoid)
    local duoTrack = controller.BabyDuoTrack
    if duoTrack and (duoTrack.IsPlaying or controller.BabyDuoPoseHeld) and controller.IsBabyEmoteActive(character) then return duoTrack end
    for _, t in ipairs(humanoid:GetPlayingAnimationTracks()) do
        if not t.Name:find("Short") and not t.Name:find("Tall") and t.IsPlaying then
            local animId = t.Animation and t.Animation.AnimationId or ""
            for dId in pairs(controller.BabyConfig.DANCE_IDS) do
                if animId:find(dId) then
                    return t
                end
            end
            local lowerName = t.Name:lower()
            if lowerName:find("apt") or lowerName:find("dance") or lowerName:find("emote") then
                return t
            end
        end
    end
    local handler = controller.GetAnimationHandler()
    if handler and handler.Anims and handler.Anims[character] then
        for catName, catAnims in pairs(handler.Anims[character]) do
            local catLower = tostring(catName):lower()
            if catLower:find("emote") or catLower:find("dance") or catLower:find("apt") then
                for _, entry in pairs(catAnims) do
                    if entry.Track and entry.Track.IsPlaying then
                        return entry.Track
                    end
                end
            end
        end
    end
    return nil
end
controller.IsBabyEmoteActive = function(character)
