controller.BindBabyDuoHold = function(character, humanoid)
    if controller.BabyDuoCleanup then controller.BabyDuoCleanup() end
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then return end
    local animations = ReplicatedStorage:FindFirstChild("Animations")
    local emotes = animations and animations:FindFirstChild("Emotes")
    local ids = {}
    if emotes then
        for _, folder in ipairs(emotes:GetChildren()) do
            local initiator, acceptor = folder:FindFirstChild("initiatoraction"), folder:FindFirstChild("acceptorstart")
            if initiator and acceptor then
                for _, animation in ipairs({initiator, acceptor}) do
                    if animation:IsA("Animation") then
                        local id = animation.AnimationId:match("%d+")
                        if id then ids[id] = true end
                    end
                end
            end
        end
    end
    local alive, current = true, nil
    local connections, motors = {}, {}
    for _, object in ipairs(character:GetDescendants()) do
        if object:IsA("Motor6D") then table.insert(motors, object) end
    end
    local function active()
        return alive and controller.BabyActive and character.Parent and humanoid.Health > 0
            and controller.IsBabyEmoteActive(character)
    end
    local function release()
        local entry = current
        current = nil
        controller.BabyDuoTrack = nil
        controller.BabyDuoPoseHeld = false
        if not entry then return end
        if entry.stopped then entry.stopped:Disconnect() end
        for motor, transform in pairs(entry.restore) do
            if motor.Parent then motor.Transform = transform end
        end
    end
    local function observe(track)
        if not active() or (current and current.track == track) then return end
        local id = track.Animation and track.Animation.AnimationId:match("%d+")
        if not id or not ids[id] or track.Looped then return end
        release()
        local entry = {track = track, position = track.TimePosition, pose = {}, restore = {}}
        current = entry
        controller.BabyDuoTrack = track
        entry.stopped = track.Stopped:Connect(function()
            if current ~= entry or not active() then return end
            if track.Length > 0 and entry.position >= track.Length - 0.1 and next(entry.pose) then
                entry.held = true
                controller.BabyDuoPoseHeld = true
            else
                release()
            end
        end)
    end
    table.insert(connections, animator.AnimationPlayed:Connect(observe))
    table.insert(connections, RunService.PreSimulation:Connect(function()
        if not active() then release(); return end
        if not current then
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do observe(track) end
        end
        local entry = current
        if not entry then return end
        if entry.held then
            for motor, transform in pairs(entry.pose) do
                if motor.Parent then
                    entry.restore[motor] = motor.Transform
                    motor.Transform = transform
                end
            end
        elseif entry.track.IsPlaying then
            entry.position = entry.track.TimePosition
            if entry.track.Length > 0 and entry.position >= entry.track.Length - 0.1 then
                for _, motor in ipairs(motors) do
                    if motor.Parent then entry.pose[motor] = motor.Transform end
                end
            end
        end
    end))
    for _, attribute in ipairs({"Emoting", "EmotePhase", "EmoteTraversalRole"}) do
        table.insert(connections, character:GetAttributeChangedSignal(attribute):Connect(function()
            if not active() then release() end
        end))
    end
    local cleanup
    cleanup = function()
        alive = false
        for _, connection in ipairs(connections) do connection:Disconnect() end
        release()
        if controller.BabyDuoCleanup == cleanup then controller.BabyDuoCleanup = nil end
    end
    controller.BabyDuoCleanup = cleanup
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do observe(track) end
end
controller.ApplyBaby = function(character)
    controller.FeatureDebugPush("Baby Apply started; active=" .. tostring(controller.BabyActive))
    if not controller.BabyActive or not character then controller.FeatureDebugPush("Baby Apply stopped: inactive/no character"); return end
    if controller.BabySpeedModifierActive then
