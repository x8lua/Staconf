                    elseif not emoteWheelClient and (name == "EmoteWheelServiceClient" or name:find("EmoteWheel")) then
                        local ok, client = pcall(require, m)
                        if ok and type(client) == "table" and rawget(client, "Toggle") and rawget(client, "Open") then
                            emoteWheelClient = client
                        end
                    end
                end
            end)
        end
        if filtergc then
            pcall(function()
                local cirFns = filtergc("function", { Constants = { "M1Input", "BlockInput" } }, false)
                for _, fn in ipairs(cirFns or {}) do
                    if debug.info(fn, "n") == "onInput" then
                        if not anyOnInput then anyOnInput = fn end
                        local uvs = debug.getupvalues(fn)
                        if uvs and (uvs[1] == char or (char and typeof(uvs[1]) == "Instance" and uvs[1].Name == charName and uvs[1].Parent)) then
                            liveOnInput = fn
                            break
                        end
                    end
                end
                if not phoneToggleFunction then
                    local phoneFns = filtergc("function", { Constants = { "FlipPhone" } }, false)
                    for _, fn in ipairs(phoneFns or {}) do
                        local src = debug.info(fn, "s") or ""
                        if src:find("ItemServiceClient") and debug.info(fn, "l") == 825 then
                            phoneToggleFunction = fn
                            break
                        end
                    end
                end
                if not mobileClient then
                    local fn = filtergc("function", { Constants = { "_bindDesktopInputs" } }, true)
                    if fn then
                        local uvs = debug.getupvalues(fn)
                        for _, u in ipairs(uvs) do
                            if type(u) == "table" and rawget(u, "_onCarryActivated") then
                                mobileClient = u
                                cachedMobileService = u
                                cachedDesktopInputsTable = u
                                break
                            end
                        end
                    end
                end
            end)
        end
        local chosenOnInput = liveOnInput or anyOnInput
        if chosenOnInput then
            actionCallbacks.M1Input = chosenOnInput
            actionCallbacks.M2Input = chosenOnInput
            actionCallbacks.BlockInput = chosenOnInput
            actionCallbacks.Evasive = chosenOnInput
            actionCallbacks.Equip = chosenOnInput
        end
        local ms = mobileClient or cachedMobileService or (KnockedHelper and KnockedHelper.getMobileService and KnockedHelper.getMobileService())
