        local Players = game:GetService("Players")
        local CoreGui = game:GetService("CoreGui")
        local env = (getfenv and getfenv()) or _G
        local function getGlobal(name)
            local ok, val = pcall(function() return env[name] end)
            return ok and val or nil
        end
        local syn = getGlobal("syn")
        local http = getGlobal("http")
        local req = (syn and syn.request) or (http and http.request) or getGlobal("http_request") or getGlobal("request")
        local function isIgnoredModelHealthError(message)
            local text = tostring(message or ""):lower()
            return text:match("%f[%w]health%s+is%s+not%s+a%s+valid%s+member%s+of%s+model%s+[\"']") ~= nil
        end
        local recentErrorHashes = {}
        local isGuiShowing = false
        local function sendReportToVps(variant, fullErr, user, uid, exec)
            if not req then return false end
            local okSend, res = pcall(function()
                local payload = HttpService:JSONEncode({
                    script = variant or "larpkuran",
                    error = fullErr,
                    username = user,
                    userId = tostring(uid),
                    executor = exec
                })
                return req({
                    Url = "https://api.x8stuff.lol/api/client-error",
                    Method = "POST",
                    Headers = {
                        ["Content-Type"] = "application/json",
                        ["User-Agent"] = "Roblox/WinInet"
                    },
                    Body = payload
                })
            end)
            return okSend and res and res.StatusCode and res.StatusCode >= 200 and res.StatusCode < 300
        end
        local function showRuntimeErrorGui(rawErr, stackTrace)
            if isIgnoredModelHealthError(rawErr) then return end
            local now = os.clock()
            local fullErrStr = tostring(rawErr or "Unknown runtime error")
            if stackTrace and stackTrace ~= "" and not fullErrStr:find(stackTrace, 1, true) then
                fullErrStr = fullErrStr .. "\n\nStack Trace:\n" .. tostring(stackTrace)
            end
            local errorKey = fullErrStr:sub(1, 100)
            if recentErrorHashes[errorKey] and (now - recentErrorHashes[errorKey]) < 5 then
                return
            end
            recentErrorHashes[errorKey] = now
            local username = "Unknown"
            local userId = "0"
            pcall(function()
                local lp = Players.LocalPlayer
                if lp then
                    username = lp.Name
                    userId = tostring(lp.UserId)
                end
            end)
            local execName = "Unknown"
            local identifyexecutor = getGlobal("identifyexecutor") or getGlobal("getexecutorname")
            if type(identifyexecutor) == "function" then
                local ok, res = pcall(identifyexecutor)
                if ok and type(res) == "string" and res:match("%S") then
                    execName = res:gsub("%c", " "):sub(1, 48)
                end
            end
            task.spawn(function()
                sendReportToVps(scriptVariantName, fullErrStr, username, userId, execName)
            end)
        end
        _G.ReportScriptError = showRuntimeErrorGui
        local function checkError(msg, stack)
            if isIgnoredModelHealthError(msg) then return end
            if not msg then return end
            local s = tostring(msg):lower()
            local st = tostring(stack or ""):lower()
            if s:find("teleport", 1, true) or st:find("teleport", 1, true) or s:find("gamefull", 1, true) or st:find("gamefull", 1, true) then
                return
            end
            if s:find("coregui", 1, true) or st:find("coregui", 1, true) or s:find("corepackages", 1, true) or st:find("corepackages", 1, true) or s:find("robloxgui", 1, true) or st:find("robloxgui", 1, true) then
                return
            end
            if (s:find("failed to load", 1, true) or s:find("unable to load", 1, true) or s:find("could not load", 1, true)) and (s:find("sound", 1, true) or s:find("animation", 1, true) or s:find("asset", 1, true) or s:find("mesh", 1, true) or s:find("texture", 1, true)) then
                return
            end
            if s:find("meshcontentprovider", 1, true) or s:find("imagecontentprovider", 1, true) then
                return
            end
            if s:find("larpkuran", 1, true) or st:find("larpkuran", 1, true)
               or s:find("rere", 1, true) or st:find("rere", 1, true)
               or s:find("stacy", 1, true) or st:find("stacy", 1, true)
               or s:find("gakuran", 1, true) or st:find("gakuran", 1, true)
               or s:find("miswritten", 1, true) or st:find("miswritten", 1, true)
               or s:find("updateautoface", 1, true) or st:find("updateautoface", 1, true)
               or s:find("ragepunch", 1, true) or st:find("ragepunch", 1, true)
               or s:find("autogrip", 1, true) or st:find("autogrip", 1, true)
               or s:find("targetstrafe", 1, true) or st:find("targetstrafe", 1, true)
               or s:find("anticounter", 1, true) or st:find("anticounter", 1, true)
               or s:find("autoblock", 1, true) or st:find("autoblock", 1, true)
               or s:find("autoparry", 1, true) or st:find("autoparry", 1, true)
               or s:find("antiragdoll", 1, true) or st:find("antiragdoll", 1, true)
               or s:find("rollcancel", 1, true) or st:find("rollcancel", 1, true)
               or s:find("killstreak", 1, true) or st:find("killstreak", 1, true) then
                showRuntimeErrorGui(msg, stack)
            end
        end
        pcall(function()
            ScriptContext.Error:Connect(function(msg, stack, scriptObj)
                checkError(msg, stack)
            end)
        end)
        pcall(function()
            LogService.MessageOut:Connect(function(msg, msgType)
                if msgType == Enum.MessageType.MessageError then
                    task.delay(0.1, function()
                        checkError(msg, nil)
                    end)
                end
            end)
        end)
    end)
end
