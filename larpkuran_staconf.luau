function controller.ParseStandAlts(value)
    local names, seen = {}, {}
    local items = type(value) == "table" and value or {tostring(value or "")}
    for _, item in ipairs(items) do
        if type(item) ~= "string" then return nil, "Use exact Roblox usernames." end
        for name in item:gmatch("[^,%s;]+") do
            local key = name:lower()
            if not name:match("^[%w_]+$") or #name < 3 or #name > 20 or key == LocalPlayer.Name:lower() then
                return nil, "Invalid alt username: " .. name
            end
            if not seen[key] then seen[key] = true; table.insert(names, name) end
        end
    end
    return names
end
function controller.SetStandAlts(value)
    local names, err = controller.ParseStandAlts(value)
    if not names then return false, err end
    controller.AltUsernames = names
    config.AltUsernames = table.clone(names)
    controller.AltUsername = names[1] or ""
    config.AltUsername = controller.AltUsername
    table.clear(controller.DetectedAlts)
    for _, name in ipairs(names) do controller.DetectedAlts[name:lower()] = true end
    if controller.StandAltState then controller.StandAltState:set(table.concat(names, ", ")) end
    return true
end
