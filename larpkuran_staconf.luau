    	if destroyed then
    		return
    	end
    	local previous = comboNumber
    	destroyed = true
    	comboNumber = 0
    	animationId += 1
    	stopVisualLoop()
    	cancelTweens()
    	for _, connection in ipairs(runtimeConnections) do
    		pcall(function() connection:Disconnect() end)
    	end
    	table.clear(runtimeConnections)
    	for sound in pairs(activeSounds) do
    		pcall(function() sound:Destroy() end)
    	end
    	if screenGui and screenGui.Parent then
    		screenGui:Destroy()
    	end
    	if type(shared) == "table" and shared.B2BCombo == api then
    		shared.B2BCombo = nil
    	end
    	if type(_G) == "table" and _G.B2BCombo == api then
    		_G.B2BCombo = nil
    	end
    	if previous ~= 0 and type(onComboChanged) == "function" then
    		pcall(onComboChanged, 0, "destroyed")
    	end
    end
    return api
end
local function currentComboApi()
