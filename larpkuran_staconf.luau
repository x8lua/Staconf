controller.createReviverRuntime = function()
    local state = {
        Enabled = false,
        Cleaned = true,
        Character = nil,
        GripToken = 0,
        CharacterToken = 0,
        PreviousCharacter = nil,
        Started = false,
        Bound = false,
        Effect = nil,
        Sound = nil,
        CameraCFrame = nil,
        CameraSubject = nil,
        CameraType = nil,
        Connections = {},
        CharacterConnections = {},
        Asset = nil,
        AssetTried = false,
        Effects = {Gui = nil, HealthUi = nil, Camera = nil, Dirty = true, NextRefresh = 0,
            GuiObjects = {}, PostEffects = {}, Connections = {}},
    }
    local runtime = {}
    local function disconnect(connection)
        if connection then pcall(function() connection:Disconnect() end) end
    end
    local function disconnectAll()
        for _, connection in ipairs(state.Connections) do disconnect(connection) end
        table.clear(state.Connections)
    end
    local function disconnectCharacter()
        for _, connection in ipairs(state.CharacterConnections) do disconnect(connection) end
        table.clear(state.CharacterConnections)
    end
    local function releaseEffectCache()
        local cache = state.Effects
        for _, connection in ipairs(cache.Connections) do disconnect(connection) end
        table.clear(cache.Connections)
        table.clear(cache.GuiObjects)
        table.clear(cache.PostEffects)
        cache.Gui, cache.HealthUi, cache.Camera = nil, nil, nil
        cache.Dirty, cache.NextRefresh = true, 0
    end
    local function clearEffects()
        local cache = state.Effects
        local gui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        local healthUi = gui and gui:FindFirstChild("HealthServiceUI")
        local camera = workspace.CurrentCamera
        local lighting = game:GetService("Lighting")
        if cache.Gui ~= gui or cache.HealthUi ~= healthUi or cache.Camera ~= camera then
            releaseEffectCache()
            cache.Gui, cache.HealthUi, cache.Camera = gui, healthUi, camera
            local function invalidate() cache.Dirty = true end
            local function watch(container, descendants)
                if not container then return end
                table.insert(cache.Connections, (descendants and container.DescendantAdded or container.ChildAdded):Connect(invalidate))
                table.insert(cache.Connections, (descendants and container.DescendantRemoving or container.ChildRemoved):Connect(invalidate))
            end
            watch(gui, false)
            watch(healthUi, true)
            watch(lighting, false)
            watch(camera, false)
        end
        local now = os.clock()
        if cache.Dirty or now >= cache.NextRefresh then
            cache.Dirty, cache.NextRefresh = false, now + 0.5
            table.clear(cache.GuiObjects)
            table.clear(cache.PostEffects)
            if healthUi then
                for _, name in ipairs({"VignetteContainer", "GrippedDarkOverlay", "GrippedImpactFlash", "M2RagdollImpactFlash", "M2RagdollDarkOverlay"}) do
                    local object = healthUi:FindFirstChild(name, true)
                    if object and object:IsA("GuiObject") then table.insert(cache.GuiObjects, object) end
                end
            end
            for _, container in ipairs({lighting, camera}) do
                if container then
                    for _, object in ipairs(container:GetChildren()) do
                        table.insert(cache.PostEffects, object)
                    end
                end
            end
        end
        local deathUi = gui and gui:FindFirstChild("DeathUI")
        if deathUi then
            if deathUi:IsA("ScreenGui") then deathUi.Enabled = false
            elseif deathUi:IsA("GuiObject") then deathUi.Visible = false end
        end
        for _, object in ipairs(cache.GuiObjects) do
            if object.Parent and object.Visible then object.Visible = false end
        end
        for _, object in ipairs(cache.PostEffects) do
            if object.Parent then
                if object.Name == "LocalDeathCameraEffect" then
                    pcall(function() object:Destroy() end)
                elseif object.Name == "DeathEffect" and object:IsA("PostEffect") then
                    if object.Enabled then object.Enabled = false end
                elseif object:IsA("BlurEffect") then
                    if object.Enabled then object.Enabled = false end
                    if object.Size > 0 then object.Size = 0 end
                elseif object:IsA("DepthOfFieldEffect") then
                    if object.Enabled then object.Enabled = false end
                elseif object:IsA("ColorCorrectionEffect") then
                    if object.Saturation <= 0 and object.Enabled then object.Enabled = false end
                end
            end
        end
    end
    local function removeEffect()
        if state.Effect then pcall(function() state.Effect:Destroy() end); state.Effect = nil end
    end
    local function restoreCamera()
        if state.Bound then
            pcall(function() RunService:UnbindFromRenderStep("LarpkuranReviverCamera") end)
            state.Bound = false
        end
        local camera = workspace.CurrentCamera
        if camera and state.CameraType then
            local character = LocalPlayer.Character
            if character and character ~= state.Character then
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                camera.CameraType = Enum.CameraType.Custom
                camera.CameraSubject = humanoid
            else
                camera.CameraType = state.CameraType
                if state.CameraSubject and state.CameraSubject.Parent then camera.CameraSubject = state.CameraSubject end
                if state.CameraCFrame then camera.CFrame = state.CameraCFrame end
            end
        end
        state.CameraCFrame, state.CameraSubject, state.CameraType = nil, nil, nil
    end
    local function stopCamera()
        restoreCamera()
        removeEffect()
    end
    local function playSound()
        if state.Sound then pcall(function() state.Sound:Destroy() end); state.Sound = nil end
        if not isCustomAssetSupported() then return end
        if not state.AssetTried then
            state.AssetTried = true
            local asset = safeGetCustomAsset("larp/death.mp3")
            if asset then state.Asset = asset end
        end
        if not state.Asset then return end
        pcall(function()
            local sound = Instance.new("Sound")
            sound.Name = "ReviverDeath"
            sound.SoundId = state.Asset
            sound.Volume = 1
            sound.Parent = game:GetService("SoundService")
            state.Sound = sound
            sound.Ended:Connect(function()
                if state.Sound == sound then state.Sound = nil end
                pcall(function() sound:Destroy() end)
            end)
            sound:Play()
            game:GetService("Debris"):AddItem(sound, 10)
        end)
    end
    local function revive(humanoid)
        if not state.Enabled or state.Cleaned or not humanoid or not humanoid.Parent
            or humanoid.Parent ~= state.Character or humanoid.Parent ~= LocalPlayer.Character
            or humanoid.Health > 0 then return end
        local char = humanoid.Parent
        if char and (char:GetAttribute("Downed") == true or char:GetAttribute("Ragdoll") == true) then
            return
        end
        humanoid.Health = humanoid.MaxHealth
        humanoid.PlatformStand = false
        humanoid.AutoRotate = true
        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
    local function startCamera(character)
        if state.Started or not state.Enabled or state.Cleaned or not character
            or character ~= state.Character or character ~= LocalPlayer.Character then return end
        local root = character:FindFirstChild("HumanoidRootPart")
        local camera = workspace.CurrentCamera
        if not root or not camera then return end
        state.Started = true
        state.CameraCFrame, state.CameraSubject, state.CameraType = camera.CFrame, camera.CameraSubject, camera.CameraType
        removeEffect()
        local effect = Instance.new("ColorCorrectionEffect")
        effect.Name = "LocalDeathCameraEffect"
        effect.Saturation = -1
        effect.Parent = game:GetService("Lighting")
        state.Effect = effect
        playSound()
        if not state.Enabled or state.Cleaned or character ~= state.Character
            or character ~= LocalPlayer.Character or workspace.CurrentCamera ~= camera then
            if state.Effect == effect then stopCamera() end
            return
        end
        local startCFrame, startedAt = camera.CFrame, os.clock()
        local direction = startCFrame.LookVector
        local bodyPosition = root.Position
        camera.CameraType, camera.CameraSubject = Enum.CameraType.Scriptable, nil
        state.Bound = true
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = {character}
        rayParams.IgnoreWater = true
        local maxUpHeight = 28
        local roofHit = workspace:Raycast(bodyPosition + Vector3.new(0, 3, 0), Vector3.new(0, 30, 0), rayParams)
        if roofHit and roofHit.Instance and roofHit.Instance.CanCollide then
            maxUpHeight = math.clamp(roofHit.Distance + 3 - 1.5, 4, 28)
        end
        local backward = Vector3.new(-direction.X, 0, -direction.Z)
        backward = backward.Magnitude < 0.001 and Vector3.new(0, 0, 1) or backward.Unit
        local targetPos = bodyPosition + backward * 12 + Vector3.new(0, maxUpHeight, 0)
        RunService:BindToRenderStep("LarpkuranReviverCamera", Enum.RenderPriority.Last.Value + 1, function()
            local elapsed = os.clock() - startedAt
            if elapsed > 8 or not state.Enabled or state.Cleaned or not camera.Parent or not root.Parent
                or LocalPlayer.Character ~= character or state.Character ~= character
                or workspace.CurrentCamera ~= camera then stopCamera(); return end
            local alpha = math.clamp(elapsed / 1.4, 0, 1)
            local current = startCFrame.Position:Lerp(targetPos, alpha)
            local look = bodyPosition - current
            look = look.Magnitude < 0.001 and Vector3.new(0, -1, 0) or look.Unit
            camera.CFrame = CFrame.lookAt(current, current + look)
        end)
    end
    local function onGrip(child)
        if not state.Enabled or child.Name ~= "Gripped" then return end
        state.GripToken += 1
        local token, character = state.GripToken, state.Character
        task.delay(0.5, function()
            if token == state.GripToken and state.Enabled and not state.Cleaned
                and character and state.Character == character and LocalPlayer.Character == character
                and child.Parent and child:IsDescendantOf(character) then
                startCamera(character)
            end
        end)
    end
    local function watchCharacter(character)
        state.CharacterToken += 1
        local token = state.CharacterToken
        disconnectCharacter()
        stopCamera()
        state.PreviousCharacter = state.Character or state.PreviousCharacter
        state.Character, state.Started, state.GripToken = character, false, state.GripToken + 1
        releaseEffectCache()
        if not character or not state.Enabled or state.Cleaned or LocalPlayer.Character ~= character then return end
        local function current()
            return token == state.CharacterToken and state.Enabled and not state.Cleaned
                and state.Character == character and LocalPlayer.Character == character
        end
        local watchedHumanoid, watchedHead
        local function bindParts()
            if not current() then return end
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid ~= watchedHumanoid then
                watchedHumanoid = humanoid
                table.insert(state.CharacterConnections, humanoid.HealthChanged:Connect(function(health)
                    if current() and health <= 0 then task.defer(revive, humanoid) end
                end))
                local camera = workspace.CurrentCamera
                local subject = camera and camera.CameraSubject
                if camera and (not subject or (subject:IsA("Humanoid") and
                    (not subject.Parent or subject.Parent == state.PreviousCharacter))) then
                    camera.CameraType, camera.CameraSubject = Enum.CameraType.Custom, humanoid
                end
            end
            local head = character:FindFirstChild("Head")
            if head and head ~= watchedHead then
                watchedHead = head
                table.insert(state.CharacterConnections, head.ChildAdded:Connect(function(child)
                    if current() then onGrip(child) end
                end))
                local gripped = head:FindFirstChild("Gripped")
                if gripped then onGrip(gripped) end
            end
        end
        table.insert(state.CharacterConnections, character.ChildAdded:Connect(bindParts))
        bindParts()
        clearEffects()
    end
    function runtime.SetEnabled(enabled)
        local nextEnabled = enabled == true
        if state.Enabled == nextEnabled and state.Cleaned == not nextEnabled then return end
        state.Enabled = nextEnabled
        if state.Enabled then state.Cleaned = false end
        if state.Enabled then
            if type(getgenv().autoReviveCleanup) == "function" and getgenv().autoReviveCleanup ~= runtime.Cleanup then
                pcall(getgenv().autoReviveCleanup)
            end
            table.insert(state.Connections, LocalPlayer.CharacterAdded:Connect(watchCharacter))
            table.insert(state.Connections, LocalPlayer.CharacterRemoving:Connect(function(character)
                if state.Character ~= character then return end
                state.CharacterToken += 1
                state.GripToken += 1
                disconnectCharacter()
                stopCamera()
                state.PreviousCharacter = character
                state.Character, state.Started = nil, false
                releaseEffectCache()
            end))
            table.insert(state.Connections, game:GetService("RunService").Heartbeat:Connect(function()
                if not state.Enabled then return end
                clearEffects()
                local humanoid = state.Character and state.Character:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.Health <= 0 then revive(humanoid) end
            end))
            if LocalPlayer.Character then watchCharacter(LocalPlayer.Character) end
            getgenv().autoReviveCleanup = runtime.Cleanup
            getgenv().autoReviveEnabled = true
        else
            runtime.Cleanup()
        end
    end
    function runtime.Cleanup()
        if state.Cleaned then return end
        state.Cleaned, state.Enabled = true, false
        state.GripToken += 1
        state.CharacterToken += 1
        disconnectAll()
        disconnectCharacter()
        stopCamera()
        if state.Sound then pcall(function() state.Sound:Destroy() end); state.Sound = nil end
        clearEffects()
        releaseEffectCache()
        if getgenv().autoReviveCleanup == runtime.Cleanup then getgenv().autoReviveCleanup = nil end
        if getgenv().autoReviveEnabled then getgenv().autoReviveEnabled = nil end
    end
    runtime.Destroy = runtime.Cleanup
    runtime.Status = function() return state.Enabled and "Enabled" or "Disabled" end
    return runtime
end
