        config.AutoRollSkipCommon = arSave.SkipCommonState and arSave.SkipCommonState:get() == true
        config.AutoRollSkipUncommon = arSave.SkipUncommonState and arSave.SkipUncommonState:get() == true
        config.AutoRollSkipRare = arSave.SkipRareState and arSave.SkipRareState:get() == true
        config.AutoRollSkipEpic = arSave.SkipEpicState and arSave.SkipEpicState:get() == true
    end
