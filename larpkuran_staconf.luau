    local function setNumberMarkup(value, glyphSize)
    	currentNumberGlyphSize = math.max(1, math.floor(glyphSize + 0.5))
    	numberLabel.Text = string.format('<font size="%d">%d</font>', currentNumberGlyphSize, value)
    end
    local function stopRichNumberTween()
    	local oldAnimation = richNumberAnimation
    	local oldConnection = richNumberConnection
    	local oldDriver = richNumberDriver
    	richNumberAnimation = nil
    	richNumberConnection = nil
    	richNumberDriver = nil
    	if oldAnimation then
    		oldAnimation:Cancel()
    	end
    	if oldConnection then
    		oldConnection:Disconnect()
    	end
    	if oldDriver then
    		oldDriver:Destroy()
    	end
    end
    local function tweenRichNumber(value, targetGlyphSize, duration, easingStyle, easingDirection)
    	stopRichNumberTween()
    	local driver = Instance.new("NumberValue")
    	driver.Value = currentNumberGlyphSize
    	richNumberDriver = driver
    	richNumberConnection = driver.Changed:Connect(function(nextGlyphSize)
    		if richNumberDriver == driver then
    			setNumberMarkup(value, nextGlyphSize)
    		end
    	end)
    	local animation = TweenService:Create(driver, TweenInfo.new(duration, easingStyle, easingDirection), {
    		Value = targetGlyphSize,
    	})
    	richNumberAnimation = animation
    	activeTweens[animation] = true
    	animation.Completed:Connect(function()
    		activeTweens[animation] = nil
    		if richNumberAnimation == animation then
    			richNumberAnimation = nil
    		end
    		if richNumberDriver == driver then
    			setNumberMarkup(value, targetGlyphSize)
    			stopRichNumberTween()
    		end
    	end)
    	animation:Play()
    	return animation
    end
    local function tween(instance, duration, easingStyle, easingDirection, properties)
    	local animation = TweenService:Create(instance, TweenInfo.new(duration, easingStyle, easingDirection), properties)
    	activeTweens[animation] = true
    	animation.Completed:Connect(function()
    		activeTweens[animation] = nil
    	end)
    	animation:Play()
    	return animation
    end
    local function cancelTweens()
    	stopRichNumberTween()
    	local tweensToCancel = activeTweens
    	activeTweens = {}
    	for animation in pairs(tweensToCancel) do
    		animation:Cancel()
    	end
    end
    local function stopVisualLoop()
    	if visualConnection then
    		visualConnection:Disconnect()
    		visualConnection = nil
    	end
    end
    local capColors = {
    	Color3.fromRGB(255, 65, 85),
    	Color3.fromRGB(180, 70, 255),
    	Color3.fromRGB(125, 55, 245),
    	Color3.fromRGB(170, 220, 255),
    	Color3.fromRGB(70, 120, 255),
    	Color3.fromRGB(85, 190, 255),
    	Color3.fromRGB(50, 235, 255),
    	Color3.fromRGB(35, 135, 255),
    	Color3.fromRGB(210, 255, 210),
    	Color3.fromRGB(255, 245, 150),
    }
    local function getCapColor(value)
    	local comboProgress = math.max(value - 16, 0)
    	local transitionIndex = math.floor(comboProgress / 5) + 1
    	local transitionProgress = (comboProgress % 5) / 5
    	local index = math.min(transitionIndex, #capColors)
    	if index >= #capColors then
    		return capColors[#capColors]
    	end
    	return capColors[index]:Lerp(capColors[index + 1], transitionProgress)
    end
    local function getVisualStyle(value)
    	if value < 3 then
    		return {
    			tier = 1,
    			color = Color3.fromRGB(255, 255, 255),
    			secondary = Color3.fromRGB(255, 255, 255),
    			spikeTransparency = 1,
    			spikeScale = 0,
    			spinSpeed = 0,
    			cap = false,
    		}
    	elseif value < 6 then
    		return {
    			tier = 2,
    			color = Color3.fromRGB(50, 235, 220),
    			secondary = Color3.fromRGB(45, 155, 210),
    			spikeTransparency = 0.8,
    			spikeScale = 1,
    			spinSpeed = 0.55,
    			cap = false,
    		}
    	else
    		local growth = math.clamp((value - 6) / 10, 0, 1)
    		local isCap = value >= 16
    		local greenColor = Color3.fromRGB(80, 245, 105):Lerp(Color3.fromRGB(120, 255, 40), growth)
    		local greenSecondary = Color3.fromRGB(25, 155, 70):Lerp(Color3.fromRGB(70, 220, 45), growth)
    		return {
    			tier = isCap and 4 or 3,
    			color = isCap and getCapColor(value) or greenColor,
    			secondary = isCap and getCapColor(value) or greenSecondary,
    			spikeTransparency = isCap and 0.06 or 0.42 - growth * 0.18,
    			spikeScale = 1.35 + growth * 2.05,
    			spinSpeed = 0.78 + growth * 0.28,
    			cap = isCap,
    		}
    	end
    end
    local function setSpikeColor(color, secondary)
    	spikeImage.ImageColor3 = color
    	for _, piece in ipairs(lightningPieces) do
    		piece.BackgroundColor3 = color
    	end
    end
    local function setSpikeTransparency(transparency)
    	spikeImage.ImageTransparency = transparency
    end
    local function setLightningTransparency(transparency)
    	for lightningIndex, piece in ipairs(lightningPieces) do
    		lightningPulseIds[lightningIndex] = (lightningPulseIds[lightningIndex] or 0) + 1
    		piece.BackgroundTransparency = transparency
    		lightningStrokes[lightningIndex].Transparency = transparency
    	end
    end
    local function getSpikeSize(style)
    	local size = SPIKE_BASE_SIZE * style.spikeScale
    	return UDim2.fromScale(size, size)
    end
    local getNumberSize
    local function setLightningPieceTransparency(lightningIndex, transparency)
    	local piece = lightningPieces[lightningIndex]
    	local stroke = lightningStrokes[lightningIndex]
    	if not piece or not stroke then
    		return
    	end
    	piece.BackgroundTransparency = transparency
    	stroke.Transparency = math.clamp(transparency + 0.12, 0, 1)
    end
    local function flashLightning(thisAnimation, style)
        if lightningSuppressed then
            return
        end
        local flashCount = math.clamp(2 + math.floor(style.spikeScale * 0.55), 2, 4)
    	local selected = {}
    	for _ = 1, flashCount do
    		local lightningIndex
    		repeat
    			lightningIndex = lightningRandom:NextInteger(1, #lightningPieces)
    		until not selected[lightningIndex]
    		selected[lightningIndex] = true
    		local piece = lightningPieces[lightningIndex]
    		local layout = lightningLayouts[lightningIndex]
    		local pulseId = (lightningPulseIds[lightningIndex] or 0) + 1
    		lightningPulseIds[lightningIndex] = pulseId
    		local brightTransparency = math.clamp(style.spikeTransparency - lightningRandom:NextNumber(0.3, 0.52), 0.02, 0.82)
    		piece.Position = UDim2.fromScale(
    			layout[1] + lightningRandom:NextNumber(-0.028, 0.028),
    			layout[2] + lightningRandom:NextNumber(-0.028, 0.028)
    		)
    		piece.Size = UDim2.fromScale(
    			layout[3] * lightningRandom:NextNumber(0.72, 1.3),
    			layout[4] * lightningRandom:NextNumber(0.85, 1.35)
    		)
    		piece.Rotation = layout[5] + lightningRandom:NextNumber(-26, 26)
    		setLightningPieceTransparency(lightningIndex, brightTransparency)
    		task.delay(lightningRandom:NextNumber(0.018, 0.045), function()
    			if thisAnimation ~= animationId or lightningPulseIds[lightningIndex] ~= pulseId then
    				return
    			end
    			setLightningPieceTransparency(lightningIndex, math.clamp(brightTransparency + 0.42, 0.18, 0.98))
    			task.delay(lightningRandom:NextNumber(0.018, 0.045), function()
    				if thisAnimation ~= animationId or lightningPulseIds[lightningIndex] ~= pulseId then
    					return
    				end
    				setLightningPieceTransparency(lightningIndex, math.clamp(brightTransparency - 0.08, 0.01, 0.9))
    				task.delay(lightningRandom:NextNumber(0.035, 0.095), function()
    					if thisAnimation == animationId and lightningPulseIds[lightningIndex] == pulseId then
    						setLightningPieceTransparency(lightningIndex, 1)
    					end
    				end)
    			end)
    		end)
    	end
    end
    local function heartbeatSpike(thisAnimation, style)
    	if style.tier < 2 then
    		return
    	end
    	local targetSize = getSpikeSize(style)
    	local pulseScale = 1.08 + math.min(style.spikeScale * 0.01, 0.08)
    	local targetNumberSize = getNumberSize(style)
    	local numberPulseScale = 1.1 + math.min(style.spikeScale * 0.012, 0.08)
    	local targetGlyphSize = currentNumberGlyphSize
    	tween(spikeGroup, 0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {
    		Size = UDim2.fromScale(targetSize.X.Scale * pulseScale, targetSize.Y.Scale * pulseScale),
    	})
    	tween(numberLabel, 0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {
    		Size = UDim2.fromScale(targetNumberSize.X.Scale * numberPulseScale, targetNumberSize.Y.Scale * numberPulseScale),
    	})
    	tweenRichNumber(comboNumber, targetGlyphSize * numberPulseScale, 0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    	task.delay(0.07, function()
    		if thisAnimation ~= animationId or comboNumber <= 0 then
    			return
    		end
    		tween(spikeGroup, 0.13, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, {
    			Size = targetSize,
    		})
    		tween(numberLabel, 0.13, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, {
    			Size = targetNumberSize,
    		})
    		tweenRichNumber(comboNumber, targetGlyphSize, 0.13, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)
    	end)
    end
    getNumberSize = function(style)
    	local spikeTarget = SPIKE_BASE_SIZE * style.spikeScale
    	if style.tier < 2 then
    		return UDim2.fromScale(0.68, 0.5)
    	end
    	return UDim2.fromScale(
    		math.max(spikeTarget * NUMBER_SIZE_MULTIPLIER, 0.68),
    		math.max(spikeTarget * NUMBER_SIZE_MULTIPLIER * 0.75, 0.5)
    	)
    end
    local function getNumberTextSize(style)
    	local spikeScale = math.max(style.spikeScale, 0.8)
    	return math.max(math.floor(NUMBER_BASE_SIZE * spikeScale * NUMBER_SIZE_MULTIPLIER), 18)
    end
    local function applyStyle(style)
    	setSpikeColor(style.color, style.secondary)
    	comboWord.TextColor3 = style.tier == 1 and Color3.fromRGB(255, 255, 255) or style.color
    	xLabel.TextColor3 = style.tier == 1 and Color3.fromRGB(255, 255, 255) or style.color
    	comboWordOutline.Color = style.tier == 1 and Color3.fromRGB(255, 255, 255) or style.secondary
    	comboWordOutline.Thickness = style.tier >= 3 and 2.2 or 1.5
    	comboWordOutline.Transparency = style.tier == 1 and 1 or 0.18
    	comboWordGlow.Color = style.color
    	comboWordGlow.Thickness = style.tier >= 3 and 5.5 or 4
    	comboWordGlow.Transparency = style.tier >= 3 and 0.72 or 1
    	numberLabel.TextColor3 = Color3.fromRGB(8, 10, 16)
    	numberLabel.TextStrokeColor3 = Color3.fromRGB(255, 255, 255)
    	numberLabel.TextStrokeTransparency = 1
    	numberOutline.Color = Color3.fromRGB(255, 255, 255)
    	numberOutline.Thickness = 1
    	numberOutline.Transparency = 0
    	badgeStroke.Color = style.tier == 1 and Color3.fromRGB(45, 55, 70) or style.secondary
    end
    local function hideImmediately()
    	stopVisualLoop()
    	cancelTweens()
    	comboBadge.BackgroundTransparency = 1
    	badgeStroke.Transparency = 1
    	comboWord.TextTransparency = 1
    	comboWordOutline.Transparency = 1
    	comboWordGlow.Transparency = 1
    	xLabel.TextTransparency = 1
    	numberLabel.TextTransparency = 1
    	numberLabel.TextStrokeTransparency = 1
    	numberOutline.Transparency = 1
    	spikeGroup.Size = UDim2.fromScale(0, 0)
    	lightningGroup.Size = UDim2.fromScale(0, 0)
    	setSpikeTransparency(1)
    	setLightningTransparency(1)
    end
    local function prepareCombo(value, style)
    	comboWord.Text = "COMBO"
    	xLabel.Text = "X"
    	applyStyle(style)
    	setNumberMarkup(value, getNumberTextSize(style))
    	comboBadge.BackgroundTransparency = 1
    	badgeStroke.Transparency = 1
    	comboWord.TextTransparency = 0
    	comboWord.Size = UDim2.fromScale(1.12, 1.03)
    	comboWord.Rotation = style.tier >= 3 and -4 or -2
    	xLabel.Size = UDim2.fromScale(0.0175, 0.12)
    	xLabel.TextTransparency = 0
    	local numberSize = getNumberSize(style)
    	numberLabel.Size = UDim2.fromScale(numberSize.X.Scale * 0.68, numberSize.Y.Scale * 0.68)
    	numberLabel.TextTransparency = 0
    	xLabel.Position = UDim2.fromScale(0.485, 0.5)
    	spikeGroup.Rotation = 0
    	numberStage.Position = UDim2.fromScale(0.67, 0.5)
    	spikeGroup.Size = style.tier >= 2 and getSpikeSize(style) or UDim2.fromScale(0, 0)
    	lightningGroup.Size = style.tier >= 2 and UDim2.fromScale(1, 1) or UDim2.fromScale(0, 0)
    	setSpikeTransparency(style.tier >= 2 and style.spikeTransparency or 1)
    	setLightningTransparency(1)
    end
    local function startVisualLoop(thisAnimation, style)
    	stopVisualLoop()
    	if style.tier < 2 then
    		return
    	end
    	local lightningTimer = 0
    	local nextLightningTime = lightningRandom:NextNumber(0.12, 0.28)
    	visualConnection = RunService.RenderStepped:Connect(function(deltaTime)
    		if thisAnimation ~= animationId or comboNumber <= 0 then
    			stopVisualLoop()
    			return
    		end
    		spikeGroup.Rotation = (spikeGroup.Rotation + style.spinSpeed * 360 * deltaTime) % 360
    		lightningTimer += deltaTime
    		if lightningTimer >= nextLightningTime then
    			lightningTimer = 0
    			nextLightningTime = lightningRandom:NextNumber(0.12, 0.3)
    			flashLightning(thisAnimation, style)
    		end
    	end)
    end
    local function playHighTierBreak(value)
    	local style = getVisualStyle(value)
    	if style.tier < 3 then
    		animationId += 1
    		hideImmediately()
    		return
    	end
    	animationId += 1
    	local thisAnimation = animationId
    	stopVisualLoop()
    	cancelTweens()
    	comboWord.TextTransparency = 1
    	comboWordOutline.Transparency = 1
    	comboWordGlow.Transparency = 1
    	xLabel.TextTransparency = 1
    	setLightningTransparency(1)
    	local currentNumberSize = numberLabel.Size
    	local baseGlyphSize = currentNumberGlyphSize
    	local expandedNumberSize = UDim2.fromScale(
    		currentNumberSize.X.Scale * 2,
    		currentNumberSize.Y.Scale * 2
    	)
    	tween(spikeGroup, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {
    		Size = UDim2.fromScale(0, 0),
    	})
    	tween(numberLabel, 0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {
    		Size = expandedNumberSize,
    	})
    	tweenRichNumber(value, baseGlyphSize * 2, 0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    	task.delay(0.3, function()
    		if thisAnimation ~= animationId then
    			return
    		end
    		spikeImage.ImageTransparency = 1
    		setLightningTransparency(1)
    		tween(numberLabel, 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {
    			Size = UDim2.fromScale(0, 0),
    			TextTransparency = 1,
    			TextStrokeTransparency = 1,
    		})
    		tweenRichNumber(value, math.max(1, baseGlyphSize * 0.2), 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    		tween(numberOutline, 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {
    			Transparency = 1,
    		})
    		task.delay(0.32, function()
    			if thisAnimation == animationId then
    				hideImmediately()
    			end
    		end)
    	end)
    end
    local function animateCombo(value, playAudio)
        animationId += 1
        local thisAnimation = animationId
        lightningSuppressed = false
        local style = getVisualStyle(value)
    	local numberSize = getNumberSize(style)
    	local previousBurstColor = spikeImage.ImageColor3
    	local previousComboColor = comboWord.TextColor3
    	local previousXColor = xLabel.TextColor3
    	local previousComboOutlineColor = comboWordOutline.Color
    	local previousComboGlowColor = comboWordGlow.Color
    	stopVisualLoop()
    	cancelTweens()
    	prepareCombo(value, style)
    	if playAudio ~= false then
    		playSound(SFX_ROOT .. "/clearline.ogg", 0.65)
    		playChargeSound(value)
    	end
    	tween(xLabel, 0.26, Enum.EasingStyle.Back, Enum.EasingDirection.Out, {
    		Size = UDim2.fromScale(0.035, 0.22),
    	})
    	tween(numberLabel, 0.26, Enum.EasingStyle.Back, Enum.EasingDirection.Out, {
    		Size = numberSize,
    	})
    	local comboOutlineTransparency = comboWordOutline.Transparency
    	local comboGlowTransparency = comboWordGlow.Transparency
    	comboWordOutline.Transparency = 1
    	comboWordGlow.Transparency = 1
    	tween(comboWord, 0.34, Enum.EasingStyle.Back, Enum.EasingDirection.Out, {
    		Size = UDim2.fromScale(1.35, 1.23),
    		Rotation = 0,
    	})
    	tween(comboWordOutline, 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {
    		Transparency = comboOutlineTransparency,
    	})
    	tween(comboWordGlow, 0.38, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {
    		Transparency = comboGlowTransparency,
    	})
    	if style.tier >= 2 then
    		if style.cap then
    			spikeImage.ImageColor3 = previousBurstColor
    			comboWord.TextColor3 = previousComboColor
    			xLabel.TextColor3 = previousXColor
    			comboWordOutline.Color = previousComboOutlineColor
    			comboWordGlow.Color = previousComboGlowColor
    			tween(spikeImage, 0.5, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, {
    				ImageColor3 = style.color,
    			})
    			tween(comboWord, 0.5, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, {
    				TextColor3 = style.color,
    			})
    			tween(xLabel, 0.5, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, {
    				TextColor3 = style.color,
    			})
    			tween(comboWordOutline, 0.5, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, {
    				Color = style.secondary,
    			})
    			tween(comboWordGlow, 0.5, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, {
    				Color = style.color,
    			})
    			for _, piece in ipairs(lightningPieces) do
    				tween(piece, 0.5, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, {
    					BackgroundColor3 = style.color,
    				})
    			end
    		end
    		spikeImage.ImageTransparency = style.spikeTransparency
    		setLightningTransparency(1)
    		heartbeatSpike(thisAnimation, style)
    		startVisualLoop(thisAnimation, style)
    	end
    	task.delay(COMBO_DISPLAY_TIME, function()
    		if thisAnimation ~= animationId or comboNumber ~= value then
    			return
    		end
		lightningSuppressed = true
		cancelTweens()
		comboWord.TextTransparency = 0.65
		comboWordOutline.Transparency = 0.65
		comboWordGlow.Transparency = 0.65
		xLabel.TextTransparency = 0.65
		numberLabel.TextTransparency = 0.65
		numberLabel.TextStrokeTransparency = 0.65
		numberOutline.Transparency = 0.65
		setSpikeTransparency(0.65)
		setLightningTransparency(1)
    	end)
    end
    local function clampCombo(value)
    	local numericValue = tonumber(value) or 0
    	if numericValue ~= numericValue then
    		numericValue = 0
    	end
    	return math.clamp(math.floor(numericValue), 0, MAX_COMBO)
    end
    local api = {}
    function api.PlayM2Sound()
        if destroyed or not runtimeEnabled then
            return
        end
        playSound(SFX_ROOT .. "/clearquad.ogg", 0.65)
    end
    function api.SetCombo(first, second, third)
    	if destroyed or not runtimeEnabled then
    		return comboNumber
    	end
    	local value
    	local animate
    	if type(first) == "table" then
    		value = second
    		animate = third
    	else
    		value = first
    		animate = second
    	end
    	if animate == nil then
    		animate = true
    	end
    	local previous = comboNumber
    	local nextValue = clampCombo(value)
    	if nextValue < previous then
    		playBlastSound(previous)
    		comboNumber = nextValue
    		if animate and nextValue > 0 then
    			animateCombo(nextValue, false)
    		elseif animate and getVisualStyle(previous).tier >= 3 then
    			playHighTierBreak(previous)
    		else
    			animationId += 1
    			hideImmediately()
    		end
    	elseif nextValue > previous then
    		comboNumber = nextValue
    		if animate then
    			animateCombo(nextValue, true)
    		else
    			animationId += 1
    			hideImmediately()
    		end
    	elseif nextValue > 0 and animate then
    		comboNumber = nextValue
    		animateCombo(nextValue, true)
    	elseif nextValue == 0 then
    		if previous > 0 then
    			playBlastSound(previous)
