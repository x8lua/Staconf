    local blendedTrack, originalPriority, originalWeight
    local function restoreEmoteBlend()
        local track = blendedTrack
        blendedTrack = nil
        if track then
            pcall(function()
                track.Priority = originalPriority
                if track.IsPlaying then track:AdjustWeight(originalWeight, 0.1) end
            end)
        end
    end
    if controller.BabyEmoteBlendCleanup then controller.BabyEmoteBlendCleanup() end
    controller.BabyEmoteBlendCleanup = restoreEmoteBlend
    local currentAnimType = "Idle"
    local currentTrack = getActiveTrack(idleId) or playTrack("AlwaysShortIdle", idleId, bCfg.IDLE_WEIGHT)
    controller.FeatureDebugPush("Baby initial track=" .. tostring(currentTrack and currentTrack.IsPlaying or false))
    local heartbeatConn = RunService.Heartbeat:Connect(function()
        if not controller.BabyActive or not character.Parent or not humanoid.Parent then return end
        local moveMag = humanoid.MoveDirection.Magnitude
        local targetType = "Idle"
        local targetId = idleId
        local targetWeight = bCfg.IDLE_WEIGHT
        local isSprinting = false
        local targetPhysicalY = 0
        local danceTrack = controller.GetActiveDanceTrack(character, humanoid)
        if danceTrack ~= blendedTrack then
            restoreEmoteBlend()
            if danceTrack and danceTrack.IsPlaying then
                blendedTrack = danceTrack
                originalPriority = danceTrack.Priority
                originalWeight = danceTrack.WeightTarget or danceTrack.WeightCurrent
            end
        end
        if danceTrack then
            if danceTrack.IsPlaying and danceTrack.Priority ~= Enum.AnimationPriority.Action4 then
                danceTrack.Priority = Enum.AnimationPriority.Action4
            end
            local currentOffset = lt.Position.Y - hrp.Position.Y
            if currentOffset > 0.55 then
                targetWeight = bCfg.DANCE_BOOST_SHORT
                if danceTrack.IsPlaying and danceTrack.WeightCurrent > 1.15 then
                    danceTrack:AdjustWeight(1.15, 0.05)
                end
            else
                targetWeight = bCfg.DANCE_BASE_SHORT
                if danceTrack.IsPlaying and danceTrack.WeightCurrent < (bCfg.DANCE_TARGET_WEIGHT - 0.1) then
                    danceTrack:AdjustWeight(bCfg.DANCE_TARGET_WEIGHT, 0.05)
                end
            end
            targetType = "Dance"
            targetId = idleId
            targetPhysicalY = bCfg.DANCE_PHYSICAL_Y
        elseif moveMag > 0.05 then
            if isPlayerRunning() then
                targetType = "RunBlend"
                targetId = idleId
                targetWeight = bCfg.RUN_WEIGHT
                isSprinting = true
                targetPhysicalY = bCfg.RUN_PHYSICAL_Y
            else
                targetType = "Walk"
                targetId = walkId
                targetWeight = bCfg.WALK_WEIGHT
                targetPhysicalY = 0
            end
        else
            targetType = "Idle"
            targetId = idleId
            targetWeight = bCfg.IDLE_WEIGHT
            targetPhysicalY = 0
        end
        local deltaY = targetPhysicalY - controller.BabyCurrentPhysicalY
        if math.abs(deltaY) > 0.001 then
            controller.BabyCurrentPhysicalY = targetPhysicalY
            hrp.CFrame = hrp.CFrame * CFrame.new(0, deltaY, 0)
        end
        local runSpeedMult = controller.BabyRunSpeedState and tonumber(controller.BabyRunSpeedState:get()) or bCfg.RUN_SPEED_MULT
        if isSprinting then
            syncRunAnimSpeed(runSpeedMult)
        else
            syncRunAnimSpeed(1.0)
        end
        local customSprintSpeed = controller.BabySprintSpeedState and tonumber(controller.BabySprintSpeedState:get()) or 24
        local customWalkSpeed = controller.BabyWalkSpeedState and tonumber(controller.BabyWalkSpeedState:get()) or 12
        if controller.BabySpeedModifierActive then
            controller.ApplyBabyMovementSpeed(character, humanoid, isSprinting)
            local ms = controller.GetMovementService()
            if ms then
                ms._sprintSpeed = customSprintSpeed
                if ms._running then
                    ms._targetSpeed = customSprintSpeed
                else
                    ms._targetSpeed = customWalkSpeed
                end
            end
        else
            local ms = controller.GetMovementService()
            if ms then
                if controller.BabyOriginalSprintSpeed and ms._sprintSpeed ~= controller.BabyOriginalSprintSpeed then
                    ms._sprintSpeed = controller.BabyOriginalSprintSpeed
                    if ms._running then
                        ms._targetSpeed = controller.BabyOriginalSprintSpeed
                    end
                end
            end
        end
        if currentAnimType ~= targetType then
            if targetId ~= (currentTrack and currentTrack.Animation and currentTrack.Animation.AnimationId) then
                if currentTrack and currentTrack.IsPlaying then
                    currentTrack:Stop(0.15)
                end
                currentTrack = playTrack("AlwaysShort" .. targetType, targetId, targetWeight)
            else
                if currentTrack and currentTrack.IsPlaying then
                    currentTrack:AdjustWeight(targetWeight, 0.1)
                end
            end
            currentAnimType = targetType
        else
            local t = getActiveTrack(targetId)
            if not t or not t.IsPlaying then
                currentTrack = playTrack("AlwaysShort" .. targetType, targetId, targetWeight)
            elseif math.abs(t.WeightCurrent - targetWeight) > 0.08 then
                t:AdjustWeight(targetWeight, 0.08)
            end
        end
    end)
    getgenv().GakuranShortConn = heartbeatConn
    table.insert(controller.BabyConnections, heartbeatConn)
    local stateConn = humanoid.StateChanged:Connect(function(old, new)
        if not controller.BabyActive or not character.Parent then return end
        if new == Enum.HumanoidStateType.GettingUp or new == Enum.HumanoidStateType.Landed then
            task.delay(0.1, function()
                if controller.BabyActive and character.Parent and not (controller.BabyDuoTrack and (controller.BabyDuoTrack.IsPlaying or controller.BabyDuoPoseHeld)) then
                    currentAnimType = "Idle"
                    currentTrack = playTrack("AlwaysShortIdle", idleId, bCfg.IDLE_WEIGHT)
                end
            end)
        end
    end)
    table.insert(controller.BabyConnections, stateConn)
    local function setupWatch(name)
        local val = character:FindFirstChild(name)
        if val and typeof(val.Changed) == "RBXScriptSignal" then
            local valConn = val.Changed:Connect(function(v)
                if not controller.BabyActive or not character.Parent then return end
                if v == false then
                    task.delay(0.2, function()
                        if controller.BabyActive and character.Parent and not (controller.BabyDuoTrack and (controller.BabyDuoTrack.IsPlaying or controller.BabyDuoPoseHeld)) then
                            currentAnimType = "Idle"
                            currentTrack = playTrack("AlwaysShortIdle", idleId, bCfg.IDLE_WEIGHT)
                        end
                    end)
                end
            end)
            table.insert(controller.BabyConnections, valConn)
        end
        local attrConn = character:GetAttributeChangedSignal(name):Connect(function()
            if not controller.BabyActive or not character.Parent then return end
            if character:GetAttribute(name) == false then
                task.delay(0.2, function()
                    if controller.BabyActive and character.Parent and not (controller.BabyDuoTrack and (controller.BabyDuoTrack.IsPlaying or controller.BabyDuoPoseHeld)) then
                        currentAnimType = "Idle"
                        currentTrack = playTrack("AlwaysShortIdle", idleId, bCfg.IDLE_WEIGHT)
                    end
                end)
            end
        end)
        table.insert(controller.BabyConnections, attrConn)
    end
    setupWatch("Downed")
    setupWatch("Ragdoll")
end
