local function installCompatibleMetamethodHook(object, method, callback, filter)
    if larpStartup.nexomia then return nil end
    if type(hookmetamethod) ~= "function" or type(callback) ~= "function" then return nil end
    local isMadium = false
    local detect = identifyexecutor or getexecutorname
    if type(detect) == "function" then
        local ok, name = pcall(detect)
        isMadium = ok and type(name) == "string" and name:lower():find("madium", 1, true) ~= nil
    end
    local ok, original
    if isMadium and filter ~= nil then
        ok, original = pcall(hookmetamethod, object, method, callback, true, filter)
    else
        ok, original = pcall(hookmetamethod, object, method, callback)
    end
    if ok and type(original) == "function" then return original end
    return nil
end
local function purgeBlurEffect(obj)
    if not obj then return end
    if obj:IsA("BlurEffect") then
        pcall(function()
            obj.Enabled = false
            obj.Size = 0
        end)
        pcall(function()
            obj:GetPropertyChangedSignal("Enabled"):Connect(function()
                if obj.Enabled then obj.Enabled = false end
            end)
            obj:GetPropertyChangedSignal("Size"):Connect(function()
                if obj.Size > 0 then obj.Size = 0 end
            end)
        end)
    elseif obj:IsA("DepthOfFieldEffect") then
        pcall(function()
            obj.Enabled = false
        end)
        pcall(function()
            obj:GetPropertyChangedSignal("Enabled"):Connect(function()
                if obj.Enabled then obj.Enabled = false end
            end)
        end)
    end
end
pcall(function()
    local Lighting = game:GetService("Lighting")
    for _, v in ipairs(Lighting:GetChildren()) do purgeBlurEffect(v) end
    Lighting.ChildAdded:Connect(purgeBlurEffect)
    local cam = workspace.CurrentCamera
    if cam then
        for _, v in ipairs(cam:GetChildren()) do purgeBlurEffect(v) end
        cam.ChildAdded:Connect(purgeBlurEffect)
    end
    workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        local newCam = workspace.CurrentCamera
        if newCam then
            for _, v in ipairs(newCam:GetChildren()) do purgeBlurEffect(v) end
            newCam.ChildAdded:Connect(purgeBlurEffect)
        end
    end)
end)
