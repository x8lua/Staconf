controller.HookLocalM1 = function()
    local m1 = getCombatModule("M1")
    local hook = controller.ParryHoldHook
    if m1 and type(m1.Hold) == "function" and (not hook or hook.module ~= m1) then
        controller.ReleaseParryHoldHook()
        local original = m1.Hold
        local wrapper = function(action, ...)
            if action == "Start" and controller.ParryTiming.AttackBlocked() then return end
            return original(action, ...)
        end
        controller.ParryHoldHook = {module = m1, original = original, wrapper = wrapper}
        m1.Hold = wrapper
    end
    if m1 and type(m1.OnM1Activated) == "function" and not controller.M1Hooked then
        controller.M1Hooked = true
        local oldOnM1 = m1.OnM1Activated
        m1.OnM1Activated = function(...)
            if controller.ParryTiming and controller.ParryTiming.AttackBlocked() then return end
            local ads = controller.AttackDesyncStates
            local desyncM1 = ads and ads.Enabled:get() == true and ads.ApplyM1:get() == true
            if desyncM1 then
                controller.LastDesyncM1Time = os.clock()
            end
            controller.OnLocalM1Began(0.55)
            local result = table.pack(oldOnM1(...))
            if desyncM1 and controller.DesyncPlayingAttackTracks then
                controller.DesyncPlayingAttackTracks("M1")
            end
            return table.unpack(result, 1, result.n)
        end
    end
    local m2 = getCombatModule("M2")
    if m2 and type(m2.OnServerSwing) == "function" and not controller.WrestlingServerSwingHook then
        local original = m2.OnServerSwing
        local wrapper = function(...)
            local result = table.pack(original(...))
            if _G.LarpkuranRageGeneration == larpkuranRageGeneration then controller.ExecuteWrestlingM2Boost(true) end
            return table.unpack(result, 1, result.n)
        end
        controller.WrestlingServerSwingHook = {module = m2, original = original, wrapper = wrapper}
        m2.OnServerSwing = wrapper
    end
    if m2 and type(m2.OnM2Activated) == "function" and not controller.M2Hooked then
        controller.M2Hooked = true
        local oldOnM2 = m2.OnM2Activated
        m2.OnM2Activated = function(...)
            controller.LocalM2Active = true
            task.delay(0.5, function() controller.LocalM2Active = false end)
            local ads = controller.AttackDesyncStates
            local desyncM2 = ads and ads.Enabled:get() == true and ads.ApplyM2:get() == true
            if desyncM2 then
                controller.LastDesyncM2Time = os.clock()
            end
            if controller.ExecuteWrestlingM2Boost then pcall(controller.ExecuteWrestlingM2Boost) end
            local result = table.pack(oldOnM2(...))
            if desyncM2 and controller.DesyncPlayingAttackTracks then
                controller.DesyncPlayingAttackTracks("M2")
            end
            return table.unpack(result, 1, result.n)
        end
    end
end
