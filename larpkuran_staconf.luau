local function isPlayerDowned(char)
    if not char then return false end
    if char:GetAttribute("Downed") == true then return true end
    if workspace:FindFirstChild("Downed") and workspace.Downed:FindFirstChild(char.Name) then return true end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return true end
    if char:FindFirstChild("Head") and char.Head:FindFirstChild("Downed") then return true end
    return false
end
local function updatePlayerVisuals()
    if _G.LarpkuranRageGeneration ~= larpkuranRageGeneration then return end
    local now = os.clock()
    if not controller.LastVisualUpdate then controller.LastVisualUpdate = 0 end
    if (now - controller.LastVisualUpdate) < 0.033 then return end
    controller.LastVisualUpdate = now
    updatePassiveHud()
    local isRagepunching = (_G.RagepunchState and (_G.RagepunchState.Running == true or _G.RagepunchState.Enabled == true))
    local selfHighlight = visualState.SelfHighlight
    if not selfHighlight or not selfHighlight.Parent then
        selfHighlight = Instance.new("Highlight")
        selfHighlight.Name = "LarpkuranSelfHighlight"
        selfHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        selfHighlight.FillTransparency = 0.35
        selfHighlight.OutlineTransparency = 0.6
        selfHighlight.FillColor = Color3.fromRGB(255, 235, 30)
        selfHighlight.OutlineColor = Color3.fromRGB(255, 255, 120)
        selfHighlight.Enabled = false
        selfHighlight.Parent = PlayerGui
        visualState.SelfHighlight = selfHighlight
    end
    if isRagepunching and LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        selfHighlight.Adornee = LocalPlayer.Character
        selfHighlight.FillColor = Color3.fromRGB(255, 235, 30)
        selfHighlight.Enabled = true
    else
        selfHighlight.Enabled = false
        selfHighlight.Adornee = nil
    end
local isSelfRage = isRagepunching and rageConfig and rageConfig.Target ~= nil and rageConfig.Target ~= LocalPlayer
    local standTarget = controller.ActiveStandTarget
    if standTarget then
        if not standTarget.Parent or not standTarget.Character or standTarget == LocalPlayer then
            controller.ActiveStandTarget = nil
            standTarget = nil
        else
            local sHum = standTarget.Character:FindFirstChildOfClass("Humanoid")
            if not sHum or sHum.Health <= 0 or isPlayerDowned(standTarget.Character) then
                controller.ActiveStandTarget = nil
                standTarget = nil
            end
        end
    end
    local flingTarget = controller.TargetPlayer
    if flingTarget then
        if not flingTarget.Parent or not flingTarget.Character or flingTarget == LocalPlayer then
            flingTarget = nil
        end
    end
    local combatTarget = nil
    if controller.CombatTargetPlayer and controller.LastCombatHitTime then
        if (now - controller.LastCombatHitTime) <= 6 then
            local cp = controller.CombatTargetPlayer
            if cp.Parent and cp.Character and cp ~= LocalPlayer then
                combatTarget = cp
            end
        else
            controller.CombatTargetPlayer = nil
        end
    end
    local attackerTarget = nil
    if controller.LastAttackerPlayer and controller.LastAttackerTime and (now - controller.LastAttackerTime) <= 6 then
        local ap = controller.LastAttackerPlayer
        if ap.Parent and ap.Character and ap ~= LocalPlayer then
            attackerTarget = ap
        end
    end
    local activeFaceTarget = controller.FaceAtEnabled and controller.FaceAtTarget or nil
    local displayTarget = activeFaceTarget or combatTarget or (isSelfRage and rageConfig.Target) or standTarget or flingTarget or attackerTarget
    local targetCharacter = displayTarget and displayTarget.Character
    local targetHumanoid = targetCharacter and targetCharacter:FindFirstChildOfClass("Humanoid")
    local isDown = targetCharacter and isPlayerDowned(targetCharacter)
    local targetDead = (not targetHumanoid) or (targetHumanoid.Health <= 0) or isDown
    local showTargetHealth = displayTarget ~= nil and displayTarget ~= LocalPlayer and targetCharacter and not targetDead
    local targetGui = visualState.EnsureRageTargetGui()
    local combatCard = visualState.EnsureStandCombatCard()
    local optTargetHud = (controller.EspTargetHUD == true)
    if displayTarget and displayTarget ~= LocalPlayer and targetCharacter and combatCard and optTargetHud then
        local curHp = targetHumanoid and math.max(0, targetHumanoid.Health) or 0
        local maxHp = targetHumanoid and math.max(1, targetHumanoid.MaxHealth) or 100
        if combatCard.LastTarget ~= displayTarget then
            combatCard.LastTarget = displayTarget
            combatCard.CurrentHp = curHp
            combatCard.MaxHp = maxHp
            combatCard.Reset()
            combatCard.LastHitTime = now
            combatCard.AvatarImg.Image = string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=150&h=150", displayTarget.UserId)
            combatCard.NameLabel.Text = string.format("%s (@%s)", displayTarget.DisplayName, displayTarget.Name)
            if standTarget and displayTarget == standTarget then
                combatCard.BadgeText.Text = "STAND"
            elseif controller.CombatTargetPlayer == displayTarget and controller.LastCombatRole == "ATTACKER" then
                combatCard.BadgeText.Text = "ATTACKER"
            elseif attackerTarget == displayTarget then
                combatCard.BadgeText.Text = "ATTACKER"
            elseif activeFaceTarget and activeFaceTarget == displayTarget then
                combatCard.BadgeText.Text = "LOCKED"
            else
                combatCard.BadgeText.Text = "TARGET"
            end
        end
        local lpChar = LocalPlayer.Character
        local lpHrp = lpChar and (lpChar:FindFirstChild("HumanoidRootPart") or lpChar.PrimaryPart)
        local tHrp = targetCharacter:FindFirstChild("HumanoidRootPart") or targetCharacter.PrimaryPart
        if lpHrp and tHrp then
            local distMeters = math.floor((lpHrp.Position - tHrp.Position).Magnitude * 0.28)
            combatCard.DistText.Text = string.format("Dist: %dm", distMeters)
        end
        if not combatCard.IsDefeated then
            if curHp < combatCard.CurrentHp - 0.5 then
                local dmg = combatCard.CurrentHp - curHp
                combatCard.TriggerShockingHit(dmg)
                combatCard.LastHitTime = now
                controller.LastCombatHitTime = now
            end
            combatCard.CurrentHp = curHp
            combatCard.MaxHp = maxHp
            local ratio = math.clamp(curHp / maxHp, 0, 1)
            combatCard.HpFill.Size = UDim2.new(ratio, 0, 1, 0)
            combatCard.HpText.Text = string.format("%d / %d HP", math.floor(curHp), math.floor(maxHp))
            if combatCard.GhostRatio ~= ratio then
                combatCard.GhostRatio = ratio
                if combatCard.GhostTween then combatCard.GhostTween:Cancel() end
                combatCard.GhostTween = TweenService:Create(combatCard.DamageGhost, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    Size = UDim2.new(ratio, 0, 1, 0)
                })
                combatCard.GhostTween:Play()
            end
            if targetDead then
                combatCard.TriggerDefeat()
                if controller.CombatTargetPlayer == displayTarget then
                    controller.CombatTargetPlayer = nil
                end
            else
