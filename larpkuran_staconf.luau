    local function locateJobArea(areaLabel)
        local query = tostring(areaLabel or ""):lower():gsub("^the%s+", ""):gsub("^a%s+", "")
        local mapped = AREA_LABEL_MAP[tostring(areaLabel or ""):lower()] or AREA_LABEL_MAP[query]
        local norm = string.gsub(mapped or query, "[^%w]", "")
        if norm == "" then return nil end
        local hitboxesFolders = {
            workspace:FindFirstChild("AreaHitboxes"),
            workspace:FindFirstChild("Areas"),
            workspace:FindFirstChild("Hitboxes"),
            workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("AreaHitboxes"),
            workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Areas"),
            workspace:FindFirstChild("World") and workspace.World:FindFirstChild("AreaHitboxes"),
            workspace:FindFirstChild("World") and workspace.World:FindFirstChild("Areas"),
        }
        for _, hitboxes in ipairs(hitboxesFolders) do
            if hitboxes then
                local minVol = (1 / 0)
                local best = nil
                for _, desc in ipairs(hitboxes:GetDescendants()) do
                    if desc:IsA("BasePart") then
                        local n = string.gsub(string.lower(desc.Name), "[^%w]", "")
                        if n == norm or n:find(norm, 1, true) or norm:find(n, 1, true) then
                            local sz = desc.Size
                            local vol = sz.X * sz.Y * sz.Z
                            if vol < minVol then
                                best = desc
                                minVol = vol
                            end
                        end
                    end
                end
                if best then return best.Position end
            end
        end
        local map = workspace:FindFirstChild("Map") or workspace:FindFirstChild("World")
        if map then
            for _, child in ipairs(map:GetChildren()) do
                local cn = string.gsub(string.lower(child.Name), "[^%w]", "")
                if cn == norm or cn:find(norm, 1, true) or norm:find(cn, 1, true) then
                    if child:IsA("BasePart") then return child.Position end
                    if child:IsA("Model") then
                        local p = child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart")
                        if p then return p.Position end
                    end
                end
            end
        end
        local lq = string.lower(mapped or query)
        for k, pos in pairs(AREA_FALLBACK_COORDS) do
            if lq:find(k, 1, true) or k:find(lq, 1, true) then
                return pos
            end
        end
        return nil
    end
    local function locateJobLandmark(landmarkLabel)
        local query = tostring(landmarkLabel or ""):lower():gsub("^the%s+", ""):gsub("^a%s+", "")
        local tagged = CollectionService:GetTagged("PhotoJobLandmark")
        for _, obj in ipairs(tagged) do
            local n = obj.Name:lower()
            if n:find(query, 1, true) or query:find(n, 1, true) then
                if obj:IsA("BasePart") then return obj.Position end
                if obj:IsA("Model") and obj.PrimaryPart then return obj.PrimaryPart.Position end
                local p = obj:FindFirstChildWhichIsA("BasePart")
                if p then return p.Position end
            end
        end
        return nil
    end
    local function checkCharacterModelMatch(model, q, words)
        if not model or not model:IsA("Model") then return nil end
        local mName = model.Name:lower()
        if mName == q or q:find(mName, 1, true) or mName:find(q, 1, true) then
            local r = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model:FindFirstChild("Head") or model.PrimaryPart
            if r then return r.Position + Vector3.new(0, 1.5, 0) end
        end
        local pd = model:FindFirstChild("PlayerData")
        if pd then
            local fn = tostring(pd:GetAttribute("FirstName") or ""):lower()
            local ln = tostring(pd:GetAttribute("LastName") or ""):lower()
            local full = (fn .. " " .. ln):gsub("^%s+", ""):gsub("%s+$", "")
            if full ~= "" then
                if full == q or q:find(full, 1, true) or full:find(q, 1, true) then
                    local r = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model:FindFirstChild("Head") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
                    if r then return r.Position + Vector3.new(0, 1.5, 0) end
                end
                if fn ~= "" and (fn == q or q:find(fn, 1, true)) and ln ~= "" and (ln == q or q:find(ln, 1, true)) then
                    local r = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model:FindFirstChild("Head") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
                    if r then return r.Position + Vector3.new(0, 1.5, 0) end
                end
            end
        end
        if words and #words > 0 then
            local allMatch = true
            for _, w in ipairs(words) do
                if not mName:find(w, 1, true) then
                    allMatch = false
                    break
                end
            end
            if allMatch then
                local r = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model:FindFirstChild("Head") or model.PrimaryPart
                if r then return r.Position + Vector3.new(0, 1.5, 0) end
            end
        end
        for _, attrName in ipairs({"Name", "CharacterName", "DisplayName", "NPCName", "FullName", "StudentName", "Id", "CharacterOwnerUserId"}) do
            local attr = model:GetAttribute(attrName)
            if typeof(attr) == "string" then
                local al = attr:lower()
                if al == q or q:find(al, 1, true) or al:find(q, 1, true) then
                    local r = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model:FindFirstChild("Head") or model.PrimaryPart
                    if r then return r.Position + Vector3.new(0, 1.5, 0) end
                end
            elseif typeof(attr) == "number" and attrName == "CharacterOwnerUserId" then
                local p = Players:GetPlayerByUserId(attr)
                if p then
                    local pName = p.Name:lower()
                    local pDisp = p.DisplayName:lower()
                    if pName == q or pDisp == q or q:find(pName, 1, true) or q:find(pDisp, 1, true) or pName:find(q, 1, true) or pDisp:find(q, 1, true) then
                        local r = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model:FindFirstChild("Head") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
                        if r then return r.Position + Vector3.new(0, 1.5, 0) end
                    end
                end
            end
        end
        local head = model:FindFirstChild("Head") or model
        for _, d in ipairs(head:GetChildren()) do
            if d:IsA("BillboardGui") then
                for _, lbl in ipairs(d:GetDescendants()) do
                    if lbl:IsA("TextLabel") and lbl.Text ~= "" then
                        local tl = lbl.Text:lower()
                        if tl == q or q:find(tl, 1, true) or tl:find(q, 1, true) then
                            local r = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model:FindFirstChild("Head") or model.PrimaryPart
                            if r then return r.Position + Vector3.new(0, 1.5, 0) end
                        end
                    end
                end
            end
        end
        return nil
    end
    local function locateJobCharacter(query)
        local q = tostring(query or ""):lower():gsub("^get a photo of ", ""):gsub("^photo of ", ""):gsub("^talk to ", ""):gsub("^find ", "")
        q = string.gsub(q, "^%s+", "")
        q = string.gsub(q, "%s+$", "")
        if q == "" then return nil end
        local words = {}
        for w in string.gmatch(q, "%w+") do
            if #w >= 3 then
                table.insert(words, w:lower())
            end
        end
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local pName = p.Name:lower()
                local pDisp = p.DisplayName:lower()
                if pName == q or pDisp == q or q:find(pName, 1, true) or q:find(pDisp, 1, true) or pName:find(q, 1, true) or pDisp:find(q, 1, true) then
                    local char = p.Character or (workspace:FindFirstChild("Players") and workspace.Players:FindFirstChild(p.Name))
                    local r = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("Head") or char.PrimaryPart)
                    if r then
                        return r.Position + Vector3.new(0, 1.5, 0)
                    end
                end
                local char = p.Character or (workspace:FindFirstChild("Players") and workspace.Players:FindFirstChild(p.Name))
                if char then
                    local pos = checkCharacterModelMatch(char, q, words)
                    if pos then return pos end
                end
            end
        end
        local searchFolders = {
            workspace:FindFirstChild("Players"),
            workspace:FindFirstChild("NPCs"),
            workspace:FindFirstChild("Characters"),
            workspace:FindFirstChild("Students"),
            workspace:FindFirstChild("Live"),
            workspace:FindFirstChild("Entities")
        }
        for _, folder in ipairs(searchFolders) do
            if folder then
                for _, child in ipairs(folder:GetChildren()) do
                    if child:IsA("Model") then
                        local pos = checkCharacterModelMatch(child, q, words)
                        if pos then return pos end
                    elseif child:IsA("Folder") or child:IsA("Configuration") then
                        for _, sub in ipairs(child:GetChildren()) do
                            if sub:IsA("Model") then
                                local pos = checkCharacterModelMatch(sub, q, words)
                                if pos then return pos end
                            end
                        end
                    end
                end
            end
        end
        for _, tag in ipairs({"Student", "Students", "NPC", "NPCs", "Character", "PhotoJobTarget"}) do
            local tagged = CollectionService:GetTagged(tag)
            for _, obj in ipairs(tagged) do
                if obj:IsA("Model") then
                    local pos = checkCharacterModelMatch(obj, q, words)
                    if pos then return pos end
                end
            end
        end
        for _, child in ipairs(workspace:GetChildren()) do
            if child:IsA("Model") and child ~= LocalPlayer.Character and child:FindFirstChildOfClass("Humanoid") then
                local pos = checkCharacterModelMatch(child, q, words)
                if pos then return pos end
            end
        end
        return nil
    end
    local function resolveJobTargetPosition()
        local cam = workspace.CurrentCamera
        local anchor = (cam and cam:FindFirstChild("PhotoJobMarkerAnchor")) or workspace:FindFirstChild("PhotoJobMarkerAnchor", true)
        if anchor and anchor:IsA("BasePart") then
            return anchor.Position
        end
        local marker = getMarkerMod()
        if marker and type(marker._resolvePosition) == "function" then
            local ok, pos = pcall(function() return marker:_resolvePosition() end)
            if ok and pos and typeof(pos) == "Vector3" then
                return pos
            end
        end
        if marker and marker._target then
            local t = marker._target
            if typeof(t) == "Instance" then
                if t:IsA("BasePart") then return t.Position + Vector3.new(0, 1.5, 0) end
                if t:IsA("Model") then
                    local r = t:FindFirstChild("HumanoidRootPart") or t:FindFirstChild("Torso") or t:FindFirstChild("Head") or t.PrimaryPart or t:FindFirstChildWhichIsA("BasePart")
                    if r then return r.Position + Vector3.new(0, 1.5, 0) end
                end
            elseif type(t) == "table" then
                if t.UserId then
                    local p = Players:GetPlayerByUserId(t.UserId)
                    local char = p and (p.Character or (workspace:FindFirstChild("Players") and workspace.Players:FindFirstChild(p.Name)))
                    local r = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("Head") or char.PrimaryPart)
                    if r then return r.Position + Vector3.new(0, 1.5, 0) end
                end
                if t.Area then
                    local pos = locateJobArea(t.Area)
                    if pos then return pos end
                end
                if t.Instance and t.Instance:IsDescendantOf(workspace) then
                    if t.Instance:IsA("BasePart") then return t.Instance.Position end
                    if t.Instance:IsA("Model") then return t.Instance:GetPivot().Position end
                end
            end
        end
        local svc = getServiceMod()
        if svc and (svc._currentTask or svc._task) then
            currentJobTask = svc._currentTask or svc._task
        end
        if currentJobTask then
            if currentJobTask.TargetUserId then
                local p = Players:GetPlayerByUserId(currentJobTask.TargetUserId)
                local char = p and (p.Character or (workspace:FindFirstChild("Players") and workspace.Players:FindFirstChild(p.Name)))
                local r = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("Head") or char.PrimaryPart)
                if r then return r.Position + Vector3.new(0, 1.5, 0) end
            end
            local kind = currentJobTask.TaskKind or currentJobTask.Kind or ""
            local label = currentJobTask.Label or currentJobTask.Target or currentJobTask.Player or currentJobTask.Area or currentJobTask.Landmark
            if kind == "Area" then
                local pos = locateJobArea(currentJobTask.Area or label)
                if pos then return pos end
            elseif kind == "Landmark" then
                local pos = locateJobLandmark(currentJobTask.Landmark or label)
                if pos then return pos end
            else
                local pos = locateJobCharacter(currentJobTask.Player or label)
                if pos then return pos end
            end
            local fallbackPos = locateJobArea(label) or locateJobCharacter(label) or locateJobLandmark(label)
            if fallbackPos then return fallbackPos end
        end
        if cam then
            for _, desc in ipairs(cam:GetDescendants()) do
                if desc:IsA("BillboardGui") and desc.Enabled ~= false then
                    local ad = desc.Adornee or desc.Parent
                    if ad and ad:IsA("BasePart") then
                        return ad.Position
                    end
                end
            end
        end
        for _, desc in ipairs(workspace:GetDescendants()) do
            if desc:IsA("BillboardGui") and desc.Name == "PhotoJobMarker" and desc.Enabled ~= false then
                local ad = desc.Adornee or desc.Parent
                if ad and ad:IsA("BasePart") then
                    return ad.Position
                end
            end
        end
        local photoGui = LocalPlayer:FindFirstChild("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("PhotoJobGui")
        local tLbl = photoGui and photoGui:FindFirstChild("Card") and photoGui.Card:FindFirstChild("Task")
        if tLbl and tLbl.Text ~= "" and not tLbl.Text:lower():find("waiting") and not tLbl.Text:lower():find("none") and not tLbl.Text:lower():find("no assignment") then
            local rawText = tLbl.Text
            local cleaned = rawText:lower():gsub("^get a photo of ", ""):gsub("^photo of ", ""):gsub("^the%s+", "")
            cleaned = string.gsub(cleaned, "^%s+", "")
            cleaned = string.gsub(cleaned, "%s+$", "")
            local pos = locateJobArea(cleaned) or locateJobCharacter(cleaned) or locateJobLandmark(cleaned) or locateJobArea(rawText) or locateJobCharacter(rawText)
            if pos then return pos end
        end
        return nil
    end
    local function shootJobTarget(targetPos)
        local char = LocalPlayer.Character
        local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
        if not root or not targetPos then return false end
        local submit = getJobRemotes()
        if not submit then return false end
        local angles = {0, 45, 90, 135, 180, 225, 270, 315}
        local distances = {6, 10, 14, 4}
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = {char}
        local candidateAngles = {}
        for _, d in ipairs(distances) do
            for _, a in ipairs(angles) do
                local rad = math.rad(a)
                local offset = Vector3.new(math.cos(rad) * d, 1.5, math.sin(rad) * d)
                local testPos = targetPos + offset
                local camPos = testPos + Vector3.new(0, 2, 0)
                local ray = workspace:Raycast(camPos, targetPos - camPos, rayParams)
                local clear = false
                if not ray then
                    clear = true
                else
                    local hitDist = (ray.Position - targetPos).Magnitude
                    if hitDist < 3 then
                        clear = true
                    end
                end
                if clear then
                    table.insert(candidateAngles, {pos = testPos, dist = d})
                end
            end
        end
        if #candidateAngles == 0 then
            table.insert(candidateAngles, {pos = targetPos + Vector3.new(0, 1.5, 6), dist = 6})
        end
        local lastResult = "TooFar"
        for _, cand in ipairs(candidateAngles) do
            root.CFrame = CFrame.lookAt(cand.pos, targetPos)
            setJobAction("Aiming at target...")
            task.wait(0.7)
            local actualCamPos = root.Position + Vector3.new(0, 2, 0)
            local camCF = CFrame.lookAt(actualCamPos, targetPos)
            setJobAction("Submitting photo...")
            lastJobSubmitTime = os.clock()
            local success, res = pcall(function()
                return submit:InvokeServer("Submit", camCF)
            end)
            if success then
                if res == "Accepted" then
                    return "Accepted"
                elseif res == "NotOnShift" or res == "Cooldown" or res == "Expired" or res == "TargetGone" or res == "NoTask" then
                    return res
                end
                lastResult = res
            end
        end
        return lastResult
    end
    local function executeAutoNewspaperStep()
        local submit, state = getJobRemotes()
        if not submit then
            setJobAction("Waiting for remotes...")
            return
        end
        local onShift = isCurrentlyOnShift()
        if not onShift then
            triggerJobShiftStart()
            setJobAction("Starting shift...")
            pcall(updateStatusGui)
            return
        end
        local photoGui = LocalPlayer:FindFirstChild("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("PhotoJobGui")
        local tLbl = photoGui and photoGui:FindFirstChild("Card") and photoGui.Card:FindFirstChild("Task")
        local taskText = tLbl and tLbl.Text:lower() or ""
        if taskText:find("waiting") or taskText:find("no assignment") or taskText:find("none") then
            setJobAction("Waiting for new assignment...")
            pcall(updateStatusGui)
            return
        end
        if os.clock() - lastAcceptedTime < 1.8 then
            setJobAction("Waiting for next task...")
            return
        end
        local now = os.clock()
        if now - lastJobSubmitTime < 1.6 then
            setJobAction("Waiting for cooldown...")
            pcall(updateStatusGui)
            return
        end
        local okPos, targetPos = pcall(resolveJobTargetPosition)
        if not okPos or not targetPos then
            setJobAction("Locating target...")
            pcall(updateStatusGui)
            return
        end
        lastJobSubmitTime = os.clock()
        local result = shootJobTarget(targetPos)
        if result == "Accepted" then
            tooFarCount = 0
            currentJobStreak = currentJobStreak + 1
            lastAcceptedTime = os.clock()
            currentJobTask = nil
            setJobAction(string.format("Accepted! (+1 Streak)", currentJobStreak))
            notifyJob("School Newspaper", "Photo Accepted! Streak: " .. tostring(currentJobStreak))
        elseif result == "NotOnShift" then
            setJobAction("Not on shift, starting...")
            triggerJobShiftStart()
        elseif result == "Cooldown" then
            setJobAction("Photo cooldown, waiting...")
            task.wait(1.5)
        elseif result == "TooFar" or result == "NotInFrame" or result == "Blocked" then
            tooFarCount = tooFarCount + 1
            setJobAction(string.format("Adjusting (%s, #%d)...", tostring(result), tooFarCount))
            local char = LocalPlayer.Character
            local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
            if root then
                local step = (tooFarCount % 6)
                if step == 1 then
                    root.CFrame = CFrame.lookAt(targetPos + Vector3.new(0, 1.5, 5), targetPos)
                elseif step == 2 then
                    root.CFrame = CFrame.lookAt(targetPos + Vector3.new(5, 1.5, 0), targetPos)
                elseif step == 3 then
                    root.CFrame = CFrame.lookAt(targetPos + Vector3.new(-5, 1.5, 0), targetPos)
                elseif step == 4 then
                    root.CFrame = CFrame.lookAt(targetPos + Vector3.new(0, 1.5, -5), targetPos)
                elseif step == 5 then
                    root.CFrame = CFrame.lookAt(targetPos + Vector3.new(0, 1.5, 0), targetPos + Vector3.new(0, 1.5, 10))
                else
                    root.CFrame = CFrame.lookAt(targetPos + Vector3.new(0, 1.5, 10), targetPos)
                end
            end
            task.wait(0.2)
        elseif result == "Expired" or result == "TargetGone" or result == "NoTask" then
            tooFarCount = 0
            setJobAction("Task ended (" .. tostring(result) .. ")")
            currentJobTask = nil
        else
            setJobAction("Result: " .. tostring(result))
        end
        pcall(updateStatusGui)
    end
