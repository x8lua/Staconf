local function hookMainChatInput()
    local digitMap = {
        ["0"] = "a", ["1"] = "b", ["2"] = "c", ["3"] = "d", ["4"] = "e",
        ["5"] = "f", ["6"] = "g", ["7"] = "h", ["8"] = "i", ["9"] = "j"
    }
    local function encodeAnimText(msg)
        if type(msg) ~= "string" then return msg end
        local prefix, id, rest = msg:match("^(%s*[/!]anim%s+)(%d+)(.*)$")
        if not prefix then
            prefix, id, rest = msg:match("^(%s*[/!]anim%s+rbxassetid://)(%d+)(.*)$")
        end
        if prefix and id then
            return prefix .. id:gsub("%d", digitMap) .. rest
        end
        return msg
    end
    local function writeIpcCmd(cmd)
        if type(writefile) == "function" then
            pcall(function()
                local hs = game:GetService("HttpService")
                writefile(("larpkuran_stand_cmd_" .. LocalPlayer.Name:lower() .. ".json"), hs:JSONEncode({
                    id = hs:GenerateGUID(false),
                    cmd = cmd,
                    time = tick()
                }))
            end)
        end
    end
    if not larpStartup.nexomia and type(hookmetamethod) == "function" then
        local oldNamecall = nil
        local chatFilter
        if AnyFilter and NamecallFilter then
            local ok, value = pcall(function()
                return AnyFilter.new({NamecallFilter.new("SendAsync"), NamecallFilter.new("sendAsync")})
            end)
            if ok then chatFilter = value end
        end
        pcall(function()
            oldNamecall = installCompatibleMetamethodHook(game, "__namecall", function(self, ...)
                local method = getnamecallmethod()
                if (method == "SendAsync" or method == "sendAsync") and typeof(self) == "Instance" and self:IsA("TextChannel") then
                    local args = {...}
                    if type(args[1]) == "string" then
                        local raw = args[1]
                        local trimmed = tostring(raw or ""):match("^%s*(.-)%s*$") or ""
                        if trimmed:sub(1, 1) == "/" or trimmed:sub(1, 1) == "!" then
                            if handleMainChatCommand then
                                pcall(handleMainChatCommand, trimmed)
                            elseif controller and controller.HandleMainChatCommand then
                                pcall(controller.HandleMainChatCommand, trimmed)
                            end
                            writeIpcCmd(trimmed)
                        end
                        local encoded = encodeAnimText(raw)
                        if encoded ~= raw then
                            writeIpcCmd(raw)
                            args[1] = encoded
                        end
                    end
                    return oldNamecall(self, table.unpack(args))
                end
                return oldNamecall(self, ...)
            end, chatFilter)
        end)
    end
    task.spawn(function()
        local chatParent = game:GetService("CoreGui"):FindFirstChild("ExperienceChat") or (LocalPlayer:FindFirstChild("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("ExperienceChat"))
        if not chatParent then
            chatParent = LocalPlayer:WaitForChild("PlayerGui", 10):FindFirstChild("ExperienceChat")
        end
        if not chatParent then return end
        local function watchTextBox(targetBox)
            if not targetBox or targetBox:GetAttribute("LarpkuranHooked") then return end
            targetBox:SetAttribute("LarpkuranHooked", true)
            targetBox.FocusLost:Connect(function(enterPressed)
                if enterPressed then
                    local raw = targetBox.Text
                    local trimmed = tostring(raw or ""):match("^%s*(.-)%s*$") or ""
                    if trimmed:sub(1, 1) == "/" or trimmed:sub(1, 1) == "!" then
                        if handleMainChatCommand then
                            pcall(handleMainChatCommand, trimmed)
                        elseif controller and controller.HandleMainChatCommand then
                            pcall(controller.HandleMainChatCommand, trimmed)
                        end
                        writeIpcCmd(trimmed)
                    end
                    local encoded = encodeAnimText(raw)
                    if encoded ~= raw then
                        writeIpcCmd(raw)
                        targetBox.Text = encoded
                    end
                end
            end)
        end
        local tb = chatParent:FindFirstChildWhichIsA("TextBox", true)
        if tb then watchTextBox(tb) end
        chatParent.DescendantAdded:Connect(function(desc)
            if desc:IsA("TextBox") then
                watchTextBox(desc)
            end
        end)
    end)
end
