	local row = titledRow(sec, title, sub, info)
	local cur = min
	if stateObj and stateObj.get then
		cur = tonumber(stateObj:get()) or def or min
	elseif def then
		cur = tonumber(def) or min
	end
	local lbl = row:Right():Label({
		Text = string.format(fmt or "%.2f", cur),
	})
	local s = row:Right():Slider({
		Minimum = min,
		Maximum = max,
		Value = cur,
		ValueChanged = function(self, val)
			lbl.Text = string.format(fmt or "%.2f", val)
			if stateObj and stateObj.set then stateObj:set(val) end
			if onChange then pcall(onChange, val) end
		end,
	})
	if stateObj and stateObj.onChange then
		stateObj:onChange(function(val)
			local num = tonumber(val) or min
			pcall(function()
				lbl.Text = string.format(fmt or "%.2f", num)
				s.Value = num
			end)
		end)
	end
	return s
end
local function addDropdown(sec, title, sub, options, stateObj, onChange, info)
	local row = titledRow(sec, title, sub, info)
	local curVal = options[1]
	if stateObj and stateObj.get then
		curVal = stateObj:get()
	end
	local idx = table.find(options, curVal) or 1
	local drop = crispPopUpButton(row:Right(), {
		Options = options,
		Value = idx,
		ValueChanged = function(self, val)
			local opt = options[val]
			if stateObj and stateObj.set then stateObj:set(opt or val) end
			if onChange then pcall(onChange, opt, val) end
		end,
	})
	if stateObj and stateObj.onChange then
		stateObj:onChange(function(val)
			local newIdx = table.find(options, val)
			if newIdx then pcall(function() drop.Value = newIdx end) end
		end)
	end
	return drop
end
local function addTextField(sec, title, sub, ph, stateObj, onChange, info)
	local row = titledRow(sec, title, sub, info)
	local cur = ""
	if stateObj and stateObj.get then
		cur = tostring(stateObj:get() or "")
	end
	local field = row:Right():TextField({
		Value = cur,
		Placeholder = ph or "",
		ValueChanged = function(self, val)
			if stateObj and stateObj.set then stateObj:set(val) end
			if onChange then pcall(onChange, val) end
		end,
	})
	if stateObj and stateObj.onChange then
		stateObj:onChange(function(val)
			pcall(function() field.Value = tostring(val or "") end)
		end)
	end
	return field
end
local function addKeybind(sec, title, sub, keyName, defKey, onChange, info)
	local row = titledRow(sec, title, sub, info)
	local currentStr = (controller.Keybinds and controller.Keybinds[keyName]) or defKey or "None"
	local keyEnum = Enum.KeyCode.Unknown
	local okKey, resolvedKey = pcall(function() return Enum.KeyCode[currentStr] end)
	if okKey and resolvedKey then
		keyEnum = resolvedKey
	else
		local lowerStr = tostring(currentStr or ""):lower()
		for _, item in ipairs(Enum.KeyCode:GetEnumItems()) do
			if item.Name:lower() == lowerStr then
				keyEnum = item
				break
			end
		end
	end
	local kField = row:Right():KeybindField({
		Value = keyEnum,
		ValueChanged = function(self, val)
			local name = val and val.Name or "None"
			if controller.Keybinds then controller.Keybinds[keyName] = name end
			if onChange then pcall(onChange, name, val) end
		end,
	})
	return kField
end
local function addButton(sec, label, onClick, state, info)
	local row = titledRow(sec, label, nil, info)
	return row:Right():Button({
		Label = label,
		State = state or "Default",
		Pushed = function()
			if onClick then pcall(onClick) end
		end,
	})
end
local function addStatusCard(sec, title, sub, updateFn)
	local row = titledRow(sec, title, sub)
	local lbl = row:Right():Label({
		Text = "...",
	})
	if updateFn then
		table.insert(statusUpdaters, function()
			local ok, text = pcall(updateFn)
			if ok and text then
				lbl.Text = tostring(text)
			end
		end)
	end
	return lbl
end
