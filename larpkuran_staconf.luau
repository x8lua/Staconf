        local prevTrack = controller.FakeStyleCurrentAttackTrack
        pcall(function() prevTrack:Stop(0) end)
        pcall(function() prevTrack:Destroy() end)
        controller.FakeStyleActiveTracks[prevTrack] = nil
        controller.FakeStyleCurrentAttackTrack = nil
    end
    for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
        if t ~= track and t.IsPlaying then
            if controller.FakeStyleActiveTracks[t] and controller.FakeStyleReplacementRoles[t] == nil then
                pcall(function() t:Stop(0) end)
                pcall(function() t:Destroy() end)
