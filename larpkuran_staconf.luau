local function isCharacterInSafeZone(char)
    if not char or not char.Parent then return false end
    local inCombat = char:GetAttribute("InCombat")
    if inCombat == true or (typeof(inCombat) == "number" and inCombat > 0) then
        return false
    end
    if char:GetAttribute("Greenzone") == true then
        return true
    end
    local AreaGreenzoneUtils = nil
    for _, obj in pairs(getloadedmodules and getloadedmodules() or {}) do
        if obj.Name == "AreaGreenzoneUtils" then
            local s, res = pcall(function() return require(obj) end)
            if s and res and type(res.IsCharacterInGreenzone) == "function" then
                AreaGreenzoneUtils = res
                break
            end
        end
    end
    if AreaGreenzoneUtils then
        local ok, inZone = pcall(function() return AreaGreenzoneUtils.IsCharacterInGreenzone(char) end)
        if ok and inZone == true then
            return true
        end
    end
    return false
end
local function isCharacterSitting(char)
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    if hum.Sit == true then return true end
    if hum.SeatPart ~= nil then return true end
    local state = hum:GetState()
    if state == Enum.HumanoidStateType.Seated then return true end
    return false
end
