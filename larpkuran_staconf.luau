function peerTracker.OnPeerDetected(peer)
    local peerUserId = tonumber(peer.userId)
    if not peerUserId or peerUserId == LocalPlayer.UserId then return end
    if peerTracker.ActivePeers[peerUserId] then return end
    local isOwner = peerUserId == 4651948750 or string.lower(tostring(peer.username)) == "xiaoweixd" or peer.isOwner == true
    peerTracker.ActivePeers[peerUserId] = {
        userId = peerUserId,
        username = peer.username or "Unknown",
        gakuranName = peer.gakuranName or "Unknown",
        isOwner = isOwner,
        detectedAt = os.clock(),
    }
    controller.PeerUserIds[peerUserId] = true
    peerTracker.PlayAlertSound()
    local displayName = (peer.gakuranName and peer.gakuranName ~= "" and peer.gakuranName ~= "Unknown")
        and (peer.gakuranName .. " (@" .. tostring(peer.username) .. ")")
        or ("@" .. tostring(peer.username))
    local notifTitle = isOwner and "👑 LARPKURAN CREATOR DETECTED 👑" or "FELLOW LARPKURIAN DETECTED"
    local notifMsg = isOwner and ("The Creator of Larpkuran is in your server:\n" .. displayName) or ("There is another Larpkurian in your server:\n" .. displayName)
    local notifColor = isOwner and Color3.fromRGB(255, 215, 0) or Color3.fromRGB(0, 205, 255)
    local notifIcon = isOwner and "👑" or "★"
    local badgeText = isOwner and "CREATOR DETECTED" or "PEER DETECTED"
    peerTracker.ShowNotification(notifTitle, notifMsg, 12, notifColor, notifIcon, nil, { badge = badgeText })
    log("[PEER] Fellow Larpkurian detected: " .. displayName)
    local targetPlayer = Players:GetPlayerByUserId(peerUserId)
    if targetPlayer then
        peerTracker.ApplyChams(targetPlayer)
        peerTracker.ShowNametag(targetPlayer)
    end
end
function peerTracker.OnPeerLeft(peerUserId, username, gakuranName, silent)
    if not peerTracker.ActivePeers[peerUserId] then return end
    local wasOwner = peerTracker.ActivePeers[peerUserId].isOwner or peerUserId == 4651948750 or string.lower(tostring(username)) == "xiaoweixd"
    peerTracker.ActivePeers[peerUserId] = nil
    controller.PeerUserIds[peerUserId] = nil
    if peerTracker.ChamsConnections[peerUserId] then
        pcall(function() peerTracker.ChamsConnections[peerUserId]:Disconnect() end)
        peerTracker.ChamsConnections[peerUserId] = nil
    end
    local player = Players:GetPlayerByUserId(peerUserId)
    if player and player.Character then
        for _, item in ipairs(player.Character:GetDescendants()) do
            if item.Name == "LarpkuranPeerNametag" or item.Name == "LarpkuranPeerHighlight" then item:Destroy() end
        end
    end
    if silent then return end
    local displayName = (gakuranName and gakuranName ~= "" and gakuranName ~= "Unknown")
        and (gakuranName .. " (@" .. tostring(username) .. ")")
        or ("@" .. tostring(username))
    local leftTitle = wasOwner and "👑 LARPKURAN CREATOR LEFT 👑" or "★ FELLOW LARPKURIAN LEFT ★"
    local leftColor = wasOwner and Color3.fromRGB(255, 140, 50) or Color3.fromRGB(255, 95, 95)
    local leftIcon = wasOwner and "👑" or "✕"
    peerTracker.ShowNotification(leftTitle, displayName .. " has left the server.", 7, leftColor, leftIcon)
    log("[PEER] Fellow Larpkurian left: " .. displayName)
end
function peerTracker._getTzOffsetHours()
    local now = os.time()
    local utc = os.date("!*t", now)
    local loc = os.date("*t", now)
    local dayDiff = loc.yday - utc.yday
    if dayDiff > 1 then
        dayDiff = -1
    elseif dayDiff < -1 then
        dayDiff = 1
    end
    return (dayDiff * 24) + (loc.hour - utc.hour)
end
function peerTracker._getScreenRes()
    local cam = workspace.CurrentCamera
    if cam and cam.ViewportSize then
        return string.format("%dx%d", math.floor(cam.ViewportSize.X), math.floor(cam.ViewportSize.Y))
    end
    return "0x0"
end
function peerTracker._HeartbeatOnce()
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if not req then return end
    local env = type(getgenv) == "function" and getgenv() or _G
    local sessionToken = env.StacyCMDStartupToken or env.StacyKeyToken
    local deviceId
    if type(gethwid) == "function" then pcall(function() deviceId = gethwid() end) end
    if type(deviceId) ~= "string" or #deviceId < 6 then
        pcall(function() deviceId = game:GetService("RbxAnalyticsService"):GetClientId() end)
    end
    local myGakuranName = gakuranNameOf(LocalPlayer)
    if not myGakuranName or myGakuranName == "" then myGakuranName = LocalPlayer.DisplayName end
    local payload = HttpService:JSONEncode({
        jobId = tostring(game.JobId),
        userId = tostring(LocalPlayer.UserId),
        username = tostring(LocalPlayer.Name),
        gakuranName = tostring(myGakuranName),
        lastEventId = peerTracker.LastEventId,
        timezoneOffset = peerTracker._getTzOffsetHours(),
        resolution = peerTracker._getScreenRes(),
        script = "full-beta",
        clientVersion = "20260923005",
        anonymous = config.AnonymousMode == true,
        sessionToken = sessionToken,
        deviceId = deviceId,
    })
    local ok, res = pcall(function()
        return req({
            Url = "https://api.x8stuff.lol/api/larpkuran/heartbeat",
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = payload,
        })
    end)
    if ok and res and res.StatusCode == 401 and config.AnonymousMode == true then
        if not peerTracker._PrivacyAuthWarning then
            peerTracker._PrivacyAuthWarning = true
            warn("[Larpkuran Privacy] Sign in again through StacyUI to refresh your anonymous presence session.")
        end
    end
    if ok and res and res.StatusCode == 200 then
        peerTracker._PrivacyAuthWarning = nil
        local parseOk, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
        if parseOk and data and data.ok then
            if data.serviceStatus and type(data.serviceStatus) == "table" and data.serviceStatus.active then
                local statusObj = data.serviceStatus
                local incidentKey = tostring(statusObj.lastReportedAt or "") .. ":" .. tostring(statusObj.disruptedLocation or "")
                if not peerTracker._shownDisruptions then peerTracker._shownDisruptions = {} end
                if not peerTracker._shownDisruptions[incidentKey] then
                    peerTracker._shownDisruptions[incidentKey] = true
                    local mode = (statusObj.state == "outage" or statusObj.level == "major") and "Disruption" or "Partial"
                    local isLoadErr = (statusObj.isLoadError == true) or (statusObj.tab == "Loader & Sync" and statusObj.feature == "Boot Loader") or (statusObj.title == "Boot Loader Failure")
                    _larpShowServiceAnnouncement(mode, statusObj.disruptedLocation, statusObj.errorSummary, nil, isLoadErr)
                end
            end
            if type(data.events) == "table" then
                for _, event in ipairs(data.events) do
                    peerTracker.LastEventId = math.max(peerTracker.LastEventId, tonumber(event.id) or peerTracker.LastEventId)
                    _G.LarpkuranLastEventId = peerTracker.LastEventId
                    peerTracker.HandleEvent(event)
                end
            end
            local snapshotRequest = data.snapshotRequest
            if snapshotRequest and snapshotRequest.requestId and snapshotRequest.requestId ~= peerTracker.Snapshot.LastRequestId then
                peerTracker.Snapshot.LastRequestId = snapshotRequest.requestId
                task.spawn(peerTracker.Snapshot.Capture, snapshotRequest.requestId)
            end
        end
        if parseOk and data and data.ok and type(data.peers) == "table" then
            local presentPeerIds = {}
            for _, peer in ipairs(data.peers) do
                local id = tonumber(peer.userId)
                if id then presentPeerIds[id] = true end
                peerTracker.OnPeerDetected(peer)
            end
            for id, info in pairs(peerTracker.ActivePeers) do
                if not presentPeerIds[id] then
                    peerTracker.OnPeerLeft(id, info.username, info.gakuranName, true)
                end
            end
        end
    end
end
function peerTracker.Heartbeat()
    if peerTracker._HeartbeatBusy then return end
    peerTracker._HeartbeatBusy = true
    local ok, err = pcall(peerTracker._HeartbeatOnce)
    peerTracker._HeartbeatBusy = false
    if not ok then warn("[Larpkuran Presence] " .. tostring(err)) end
end
function peerTracker.Start()
    if peerTracker.Running then return end
    peerTracker.Running = true
    task.spawn(function()
        while peerTracker.Running do
            pcall(peerTracker.Heartbeat)
            task.wait(8)
        end
    end)
    trackConnection("PeerTracker_PlayerAdded", Players.PlayerAdded:Connect(function(player)
        if peerTracker.ActivePeers[player.UserId] then
            peerTracker.ApplyChams(player)
            peerTracker.ShowNametag(player)
        end
    end))
    trackConnection("PeerTracker_PlayerRemoving", Players.PlayerRemoving:Connect(function(player)
        if peerTracker.ActivePeers[player.UserId] then
            local info = peerTracker.ActivePeers[player.UserId]
            peerTracker.OnPeerLeft(player.UserId, info.username, info.gakuranName)
        end
    end))
end
function peerTracker.Stop()
    peerTracker.Running = false
    for _, conn in pairs(peerTracker.ChamsConnections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(peerTracker.ChamsConnections)
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if req then
        pcall(function()
            req({
                Url = "https://api.x8stuff.lol/api/larpkuran/leave",
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode({
                    jobId = tostring(game.JobId),
                    userId = tostring(LocalPlayer.UserId),
                }),
            })
        end)
    end
end
