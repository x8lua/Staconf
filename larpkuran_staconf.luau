    local AH = controller.GetAnimationHandler()
    controller.FeatureDebugPush("Baby AnimationHandler=" .. tostring(AH ~= nil))
    if not AH then return end
    controller.BabyCurrentPhysicalY = controller.BabyCurrentPhysicalY or 0
    if controller.BabyCurrentPhysicalY ~= 0 and hrp then
        hrp.CFrame = hrp.CFrame * CFrame.new(0, -controller.BabyCurrentPhysicalY, 0)
        controller.BabyCurrentPhysicalY = 0
    end
    if getgenv().GakuranShortConn then
        pcall(function() getgenv().GakuranShortConn:Disconnect() end)
