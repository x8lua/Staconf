        controller.AttackDesyncStates.Delay:set(math.clamp(tonumber(config.AttackDesyncDelay) or 140, 0, 1000))
        controller.AttackDesyncStates.ApplyM1:set(config.AttackDesyncApplyM1 ~= false)
        controller.AttackDesyncStates.ApplyM2:set(config.AttackDesyncApplyM2 ~= false)
    end
    controller.SetStandAlts(config.StandUnpaired and {} or config.AltUsernames or config.AltUsername or "")
    if visualState.Hud then visualState.Hud.Layout() end
end
controller.ResetHudPositions = function()
    config.StatusBarsPos = false
    config.HudPos = false
    config.HealthBarPos = false
    config.StaminaBarPos = false
    config.HeavyBarPos = false
    setupPassiveHud()
    if controller.SaveConfig then controller.SaveConfig() end
end
controller.ApplyConfig = function()
    larpStartup.ResetAutomaticOffense(config)
    controller.ApplyCombatConfig()
    controller.ApplyMovementConfig()
    controller.ApplyFeatureConfig()
end
controller.LoadConfig = function()
    if type(readfile) == "function" and type(isfile) == "function" and isfile(CONFIG_FILE) then
        local ok, saved = pcall(function() return HttpService:JSONDecode(readfile(CONFIG_FILE)) end)
        if ok and type(saved) == "table" then
            for key, value in pairs(DEFAULT_CONFIG) do
                if saved[key] ~= nil then
                    config[key] = saved[key]
                else
                    config[key] = value
                end
            end
            if saved.TimingScaleVersion ~= 3 then
                config.TimingScale = DEFAULT_CONFIG.TimingScale
                config.TimingScaleVersion = 3
            end
            if saved.ComboSystemDefaultVersion ~= 1 then
                config.ComboSystemEnabled = true
                config.ComboSystemDefaultVersion = 1
            end
        else
            log("CONFIG file load failed")
        end
    end
    config.FlingEnabled = false
    config.TargetFling = false
    controller.ApplyConfig()
    log("CONFIG loaded")
end
controller.ResetConfig = function()
    for key, value in pairs(DEFAULT_CONFIG) do config[key] = value end
    config.TimingScaleVersion = 3
    config.ComboSystemDefaultVersion = 1
    controller.ApplyConfig()
    log("CONFIG reset to defaults")
end
