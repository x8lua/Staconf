        local isInteracting = c.isDraggingOnBoard or c.isResizingBR or c.isResizingR or c.isResizingB
        if not isInteracting then return end
        local board = c.cachedBoard or c.getTargetBoard()
        if board and board.part and c.boardSg.Adornee ~= board.part then
            c.boardSg.Adornee = board.part
